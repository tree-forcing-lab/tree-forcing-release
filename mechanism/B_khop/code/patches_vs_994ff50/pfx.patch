+def plan_line(step: dict) -> str:
+    """The PLAN rendering of a worked step (PFX, chain "plan"): the operation with its result hidden ("?") and every
+    operand that comes from an earlier step written as "[Step i]" (a_from / b_from, 0-based step indices), so the line
+    says which computation to do and where its inputs come from, never a value the student could copy. Steps without
+    the a / op / b fields (numgen chains) keep their text with the result masked."""
+    if not all(k in step for k in ("a", "op", "b", "value")):
+        lhs, sep, _ = str(step.get("text", "")).rpartition("=")
+        return f"{lhs}= ?" if sep else f"{step.get('text', '')} = ?"
+    a = f"[Step {int(step['a_from']) + 1}]" if step.get("a_from") is not None else str(step["a"])
+    b = f"[Step {int(step['b_from']) + 1}]" if step.get("b_from") is not None else str(step["b"])
+    return f"{a}% of {b} = ?" if step["op"] == "% of" else f"{a} {step['op']} {b} = ?"
+
