+class TestPFX(unittest.TestCase):
+    """PFX (--si-mix): the plan rendering, the per-item mixture draw and si_group's mix branch (the module imports torch)."""
+
+    def test_plan_line(self):
+        from cotdistill.student import plan_line
+        steps = [{"a": "3", "op": "×", "b": "60", "value": "180", "a_from": None, "b_from": None},
+                 {"a": "180", "op": "+", "b": "60", "value": "240", "a_from": 0, "b_from": None},
+                 {"a": "30", "op": "% of", "b": "180", "value": "54", "a_from": None, "b_from": 0},
+                 {"a": "180", "op": "−", "b": "54", "value": "126", "a_from": 0, "b_from": 2}]
+        self.assertEqual([plan_line(s) for s in steps],
+                         ["3 × 60 = ?", "[Step 1] + 60 = ?", "30% of [Step 1] = ?", "[Step 1] − [Step 3] = ?"])
+        for it in FX["gsm8k"]:                      # every fixture step: no result and no linked value survives
+            for w in (it.get("worked_steps") or []):
+                ln = plan_line(w)
+                self.assertTrue(ln.endswith(" = ?"), ln)
+                self.assertNotIn(str(w["value"]), ln.rpartition("=")[2])
+                if w.get("a_from") is not None:
+                    self.assertIn(f"[Step {int(w['a_from']) + 1}]", ln)
+        self.assertEqual(plan_line({"text": "5 + 2 = 7"}), "5 + 2 = ?")      # chains without a/op/b: result masked
+
+    def test_mix_draw(self):
+        from cotdistill.student import si_mix_draw, si_rng
+        # deterministic per (seed, pass, item); independent of everything else
+        self.assertEqual(si_mix_draw(si_rng(3, -1, 1, "x"), 5), si_mix_draw(si_rng(3, -1, 1, "x"), 5))
+        self.assertNotEqual([si_mix_draw(si_rng(3, -1, 1, f"i{j}"), 5) for j in range(20)],
+                            [si_mix_draw(si_rng(3, -1, 2, f"i{j}"), 5) for j in range(20)])
+        draws = [si_mix_draw(si_rng(3, -1, 0, f"i{j}"), 5) for j in range(2000)]
+        plain = sum(k == 0 for k, _ in draws) / 2000
+        self.assertAlmostEqual(plain, 0.50, delta=0.03)
+        v = sum(c == "true" for _, c in draws) / 2000; o = sum(c == "plan" for _, c in draws) / 2000
+        self.assertAlmostEqual(v, o, delta=0.03)
+        ks = collections.Counter(k for k, _ in draws if k)
+        self.assertEqual(set(ks), {1, 2, 3, 4})                          # k uniform in 1..n-1
+        self.assertLess(max(ks.values()) - min(ks.values()), 0.25 * sum(ks.values()) / 4 * 2)
+        self.assertEqual(si_mix_draw(si_rng(3, -1, 0, "one"), 1), (0, "plain"))   # one-step items stay plain
+
