+def si_mix_draw(rng: random.Random, n: int) -> tuple[int, str]:
+    """The PFX prefix draw for a chain of n steps: (k, chain). Plain (k 0) with probability 1/2 (always when n < 2),
+    else k uniform in 1..n-1 and chain "true" (the values) or "plan" (the operations, results hidden), 1/2 each.
+    Three coins in a fixed order, so a draw depends only on the generator's key."""
+    c_plain, c_k, c_kind = rng.random(), rng.random(), rng.random()
+    if n < 2 or c_plain < 0.5:
+        return 0, "plain"
+    return 1 + int(c_k * (n - 1)), ("true" if c_kind < 0.5 else "plan")
