+            cg = [p.grad for p in copies.parameters()]
+            self.assertEqual(any(g is not None and g.abs().sum() > 0 for g in cg), expect, T)
+            self.assertTrue(any(p.grad is not None and p.grad.abs().sum() > 0 for p in orig[0].parameters()), T)
+        # one optimizer step on the extra pass's parameters alone moves the copies and not the originals
+        before = {n: p.detach().clone() for n, p in body.named_parameters()}
+        opt = torch.optim.SGD(copies.parameters(), lr=0.1)
+        opt.step()
+        after = dict(body.named_parameters())
+        for n in before:
+            moved = not torch.equal(before[n], after[n])
+            self.assertEqual(moved, n.startswith("loop_untied.") and after[n].grad is not None and
+                             bool(after[n].grad.abs().sum() > 0), n)
+        # a second LayerLoop on the same body reuses the copies (no second deep copy)
+        loop2 = LayerLoop(body, 2, 5, T=2, untied=True)
+        self.assertIs(loop2.block[0], copies[0])
+        with self.assertRaises(ValueError):
+            LayerLoop(body, 1, 5, T=2, untied=True)                      # another window: wrong copy count
+        model.eval()
+
+    def test_untied_save_and_reload_as_eval_student(self):
+        """save_pretrained writes loop_untied.*; from_pretrained drops them; LayerLoop(untied) + load_loop_untied
+        restores them: the reloaded looped logits equal the saved model's."""
+        model = tiny_qwen35().eval()
+        body, _ = text_parts(model)
+        ids, am = batch()
+        loop = LayerLoop(body, 2, 5, T=2, untied=True)
+        with torch.no_grad():
+            for p in body.loop_untied.parameters():                      # make the copies differ from the originals
+                p.add_(0.01 * torch.randn_like(p))
+            with loop:
+                want = model(input_ids=ids, attention_mask=am, use_cache=False).logits
+        with tempfile.TemporaryDirectory() as d:
+            model.save_pretrained(d, safe_serialization=True)
+            from safetensors import safe_open
+            with safe_open(d + "/model.safetensors", framework="pt") as fh:
+                keys = [k for k in fh.keys() if "loop_untied." in k]
+            self.assertEqual(len(keys), sum(1 for _ in body.loop_untied.state_dict()))
+            m2 = load_model(d, torch.float32)
+            b2, _ = text_parts(m2)
+            self.assertFalse(hasattr(b2, "loop_untied"))
+            with self.assertRaises(ValueError):                          # copies must exist before the load
+                load_loop_untied(b2, d)
+            loop2 = LayerLoop(b2, 2, 5, T=2, untied=True)
+            n = load_loop_untied(b2, d)
+            self.assertEqual(n, len(keys))
+            for pc, po in zip(b2.loop_untied.parameters(), body.loop_untied.parameters()):
+                self.assertTrue(torch.equal(pc, po))
+            with loop2, torch.no_grad():
+                got = m2(input_ids=ids, attention_mask=am, use_cache=False).logits
+            self.assertTrue(torch.allclose(got, want, atol=1e-6))
+            # a plain checkpoint (no copies) refuses: not a LOOP-UNTIED model
+            m3 = tiny_qwen35()
+            m3.save_pretrained(d + "/plain", safe_serialization=True)
+            b3, _ = text_parts(m3)
+            LayerLoop(b3, 2, 5, T=2, untied=True)
+            with self.assertRaises(ValueError):
+                load_loop_untied(b3, d + "/plain")
+
