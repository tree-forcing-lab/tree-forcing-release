+                             {"lo": 0, "hi": 0, "T": 2, "alpha": 1.0, "untied": False, "mix": [1, 2]})
+            self.assertEqual(sum(ll["train_T_counts"].values()), 4)          # 2 epochs x 2 micro-batches of 2 items
+            self.assertEqual(set(ll["train_T_counts"]) <= {"1", "2"}, True)
+            self.assertEqual(sum(ll["forward_counts"].values()), 7)          # + the mid eval, the final eval at T=2, T=1
+            self.assertGreaterEqual(ll["forward_counts"]["1"], 1)
