+        for lo, hi, T, a in ((0, 7, 2, 1.0), (3, 2, 2, 1.0), (-1, 2, 2, 1.0), (2, 5, 0, 1.0), (2, 5, 2, 0.0),
+                             (2, 5, 2, 1.5)):
+            with self.assertRaises(ValueError, msg=(lo, hi, T, a)):
+                LayerLoop(self.body, lo, hi, T=T, alpha=a)
+
+    def test_reentrancy(self):
