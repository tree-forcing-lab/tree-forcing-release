+                self.assertTrue(torch.equal(pc, po))
+        self.assertIn("loop_untied.0.mlp.down_proj.weight", dict(body.named_parameters()))
+        with loop, torch.no_grad():
+            out = model(input_ids=ids, attention_mask=am, use_cache=False).logits
+        self.assertLess((out - tied).abs().max().item(), 1e-5)         # copies start equal: the tied output
+        # the copies get gradients only through the extra pass: T = 1 none, T = 2 yes; the originals in both cases
+        model.train()
