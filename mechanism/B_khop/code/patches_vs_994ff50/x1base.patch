+"""LayerLoop (src/cotdistill/student.py; train_student.py / eval_student.py --loop-layers; arms LOOP, LOOP-MIX,
+LOOP-UNTIED): a contiguous block of decoder layers re-applied T - 1 extra times inside one forward. CPU, float32, a
+tiny random Qwen3.5 text model (8 layers, full attention at 3 and 7, the rest Gated DeltaNet) so the linear and the
+full-attention layers get different masks, as on Qwen3.5-4B. Checks: T = 1 is bit-identical to no hook; T = 2, the
+damped update and T = 3 equal a manual re-application with the recorded per-layer kwargs; the untied copies are new
+parameters that start equal to the originals and receive gradients only through the extra pass; gradients reach the
+window with and without the model's gradient checkpointing; the LOOP-MIX draw is deterministic and uniform; the
+recorded masks differ by layer type; sidecar round trip; re-entrancy; the saved copies load back the way
+eval_student.py does it; the FSDP helper sees the copies; and a trainer-level smoke of train_student.py +
+eval_student.py on the repo's tiny Qwen2 fixture (subprocess, as tests/test_eval_mid_preds.py)."""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+sys.path.insert(0, str(ROOT / "tests"))
+
+try:
+    import torch
+    import transformers
+    from cotdistill.fsdp import decoder_layers
+    from cotdistill.student import (LOOP_SIDECAR, Example, LayerLoop, body_layers, draw_loop_T, load_loop_untied,
+                                    load_model, loop_rms_summary, loop_spec_from_dict, loop_spec_to_dict,
+                                    parse_loop_Ts, parse_loop_layers, text_parts)
+    HAVE = True
+except ImportError:
+    HAVE = False
+
+ENV = {**os.environ, "CUDA_VISIBLE_DEVICES": "", "OMP_NUM_THREADS": "2"}
+TRAIN = str(ROOT / "scripts/train_student.py")
+EVAL = str(ROOT / "scripts/eval_student.py")
+LAYER_TYPES = ["linear_attention"] * 3 + ["full_attention"] + ["linear_attention"] * 3 + ["full_attention"]
+
+
+def tiny_qwen35(seed: int = 0):
+    """A random Qwen3.5 text model: hidden 64, 8 layers, full attention at 3 and 7 (as Qwen3.5-4B's 3, 7, ...)."""
+    cfg = transformers.Qwen3_5TextConfig(vocab_size=300, hidden_size=64, intermediate_size=128, num_hidden_layers=8,
+                                         num_attention_heads=4, num_key_value_heads=2, head_dim=16,
+                                         layer_types=list(LAYER_TYPES), linear_num_value_heads=4, linear_num_key_heads=2,
+                                         linear_key_head_dim=16, linear_value_head_dim=16, linear_conv_kernel_dim=4,
+                                         max_position_embeddings=512, tie_word_embeddings=True)
+    torch.manual_seed(seed)
+    return transformers.Qwen3_5ForCausalLM(cfg)
+
+
+def batch(seed: int = 1, n: int = 2, L: int = 12, pad: int = 3):
+    """input ids and an attention mask with `pad` left pads on the second row (so the masks are real tensors)."""
+    g = torch.Generator().manual_seed(seed)
+    ids = torch.randint(3, 300, (n, L), generator=g)
+    am = torch.ones(n, L, dtype=torch.long)
+    if pad:
+        am[1, :pad] = 0
+    return ids, am
+
+
+def record_pass(model, ids, am):
+    """One plain forward with recording hooks on every layer: (logits, {layer: kwargs}, {layer: input})."""
+    body, _ = text_parts(model)
+    rec, h0, hs = {}, {}, []
+    for li, lay in enumerate(body_layers(body)):
+        def pre(mod, args, kwargs, li=li):
+            rec[li] = {k: v for k, v in kwargs.items() if k != "hidden_states"}
+            h0[li] = args[0] if args else kwargs["hidden_states"]
+        hs.append(lay.register_forward_pre_hook(pre, with_kwargs=True))
+    try:
+        out = model(input_ids=ids, attention_mask=am, use_cache=False).logits
+    finally:
+        for hd in hs:
+            hd.remove()
+    return out, rec, h0
+
+
+def manual(model, rec, h0, lo, hi, T, alpha, block=None):
+    """The looped network computed by hand from the recorded pass-1 kwargs: layers 0..n-1 in order, and before layer
+    hi + 1 the T - 1 extra passes of the block (block: the modules to use; default the layers themselves)."""
+    body, head = text_parts(model)
+    dl = body_layers(body)
+    block = block or dl[lo:hi + 1]
+    h = h0[0]
+    for li in range(len(dl)):
+        if li == hi + 1:
+            for _ in range(T - 1):
+                y = h
+                for j, lj in enumerate(range(lo, hi + 1)):
+                    y = block[j](y, **rec[lj])
+                h = y if alpha == 1.0 else h + alpha * (y - h)
+        h = dl[li](h, **rec[li])
+    return head(body.norm(h))
+
+
+def toy_examples(n: int):
+    return [Example(f"Case {i}.", ["A", "B"], [1.0, 0.0], 1.0, "final", f"t{i}") for i in range(n)]
+
+
+@unittest.skipUnless(HAVE, "needs torch + transformers")
+class TestLoopForward(unittest.TestCase):
+    def setUp(self):
+        self.model = tiny_qwen35().eval()
+        self.body, _ = text_parts(self.model)
+        self.ids, self.am = batch()
+        with torch.no_grad():
+            self.ref, self.rec, self.h0 = record_pass(self.model, self.ids, self.am)
+            self.man = {(T, a): manual(self.model, self.rec, self.h0, 2, 5, T, a)
+                        for T, a in ((1, 1.0), (2, 1.0), (2, 0.5), (3, 1.0))}
+
+    def test_manual_T1_is_the_model(self):
+        self.assertTrue(torch.equal(self.man[(1, 1.0)], self.ref))
+
+    def test_T1_bit_identical(self):
+        for train in (False, True):
+            self.model.train(train)
+            with LayerLoop(self.body, 2, 5, T=1) as loop:
+                with torch.no_grad():
+                    out = self.model(input_ids=self.ids, attention_mask=self.am, use_cache=False).logits
+                self.assertEqual(loop.counts, {1: 1})
+            self.assertTrue(torch.equal(out, self.ref), f"train={train}")
+        self.model.eval()
+
+    def test_T2_equals_manual(self):
+        with LayerLoop(self.body, 2, 5, T=2, log=[]) as loop, torch.no_grad():
+            out = self.model(input_ids=self.ids, attention_mask=self.am, use_cache=False).logits
+        self.assertLess((out - self.man[(2, 1.0)]).abs().max().item(), 1e-5)
+        self.assertGreater((out - self.ref).abs().max().item(), 1e-3)     # the loop changes the output
+        self.assertEqual(loop.counts, {2: 1})
+        self.assertEqual(len(loop.log), 1)
+        self.assertEqual(len(loop.log[0]), 2)                             # RMS of pass 1 and of the extra pass
+        self.assertTrue(all(r > 0 for r in loop.log[0]))
+        s = loop_rms_summary(loop.log)
+        self.assertEqual((s["n"], len(s["mean_pass"])), (1, 2))
+        self.assertAlmostEqual(s["max_ratio_2_1"], loop.log[0][1] / loop.log[0][0], places=4)
+
+    def test_alpha_damped(self):
+        with LayerLoop(self.body, 2, 5, T=2, alpha=0.5) as loop, torch.no_grad():
+            out = self.model(input_ids=self.ids, attention_mask=self.am, use_cache=False).logits
+        self.assertLess((out - self.man[(2, 0.5)]).abs().max().item(), 1e-5)
+        self.assertGreater((out - self.man[(2, 1.0)]).abs().max().item(), 1e-4)
+        self.assertEqual(loop.counts, {2: 1})
+
+    def test_T3_two_extra_passes(self):
+        with LayerLoop(self.body, 2, 5, T=3, log=[]) as loop, torch.no_grad():
+            out = self.model(input_ids=self.ids, attention_mask=self.am, use_cache=False).logits
+        self.assertLess((out - self.man[(3, 1.0)]).abs().max().item(), 1e-5)
+        self.assertEqual(loop.counts, {3: 1})
+        self.assertEqual(len(loop.log[0]), 3)
+
+    def test_T_mutable_and_new_forward_rerecords(self):
+        """T changes between forwards; a second forward of another length re-records the kwargs (new shapes)."""
+        with LayerLoop(self.body, 2, 5, T=2) as loop, torch.no_grad():
+            self.model(input_ids=self.ids, attention_mask=self.am, use_cache=False)
+            loop.T = 1
+            out1 = self.model(input_ids=self.ids, attention_mask=self.am, use_cache=False).logits
+            loop.T = 2
+            ids2, am2 = batch(seed=5, n=3, L=7, pad=2)
+            ref2, rec2, h02 = record_pass(self.model, ids2, am2)      # the loop is installed: rec2 is its pass 1
+            self.assertEqual(loop.counts, {2: 2, 1: 1})         # T=2, T=1, T=2 (record_pass)
+            self.assertEqual(loop.kw[3]["attention_mask"].shape[-1], 7)
+        self.assertTrue(torch.equal(out1, self.ref))
+        with torch.no_grad():
+            man2 = manual(self.model, rec2, h02, 2, 5, 2, 1.0)
+        self.assertLess((ref2 - man2).abs().max().item(), 1e-5)
+
+    def test_recorded_masks_by_layer_type(self):
+        """The linear layers (2, 4, 5) get the recurrent mask, the full-attention layer 3 the causal mask: different
+        objects, as the model built them (padding makes both real tensors)."""
+        with LayerLoop(self.body, 2, 5, T=2) as loop, torch.no_grad():
+            self.model(input_ids=self.ids, attention_mask=self.am, use_cache=False)
+            kw = {li: dict(loop.kw[li]) for li in range(2, 6)}
+        self.assertEqual(sorted(kw), [2, 3, 4, 5])
+        full, lin = kw[3]["attention_mask"], kw[2]["attention_mask"]
+        self.assertIsNotNone(full)
+        self.assertIsNotNone(lin)
+        self.assertIsNot(full, lin)
+        self.assertEqual(full.dim(), 4)                 # [batch, 1, q, k] causal mask
+        self.assertEqual(lin.dim(), 2)                  # [batch, k] recurrent (padding) mask
+        for li in (4, 5):
+            self.assertIs(kw[li]["attention_mask"], lin)
+        for li in range(2, 6):                          # the same kwarg names as an outside hook records
+            self.assertEqual(sorted(kw[li]), sorted(self.rec[li]))
+            self.assertIsNone(kw[li]["past_key_values"])
+            self.assertFalse(kw[li]["use_cache"])
+
+    def test_cache_refused(self):
+        with LayerLoop(self.body, 2, 5, T=2), torch.no_grad():
+            with self.assertRaises(RuntimeError):
+                self.model(input_ids=self.ids, attention_mask=self.am, use_cache=True)
+
+    def test_validation(self):
