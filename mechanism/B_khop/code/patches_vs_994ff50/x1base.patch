+@unittest.skipUnless(HAVE, "needs torch + transformers")
+class TestLoopTraining(unittest.TestCase):
+    def loss_and_grads(self, model, loop_kw, ckpt: bool):
+        """One training forward/backward at the loop's T: (loss, {name: grad} of the window + neighbours)."""
+        body, _ = text_parts(model)
+        model.train()
+        model.zero_grad(set_to_none=True)
+        if ckpt:
+            model.gradient_checkpointing_enable()
+        try:
+            ids, am = batch()
+            with LayerLoop(body, 2, 5, **loop_kw) as loop:
+                dl = body_layers(body)
+                if ckpt:                                # the window and hi + 1 run unchecked, the others checked
+                    self.assertTrue(all(not dl[li].gradient_checkpointing for li in range(2, 7)))
+                    self.assertTrue(all(dl[li].gradient_checkpointing for li in (0, 1, 7)))
+                    if loop.untied:
+                        self.assertTrue(all(not m.gradient_checkpointing for m in body.loop_untied))
+                z = model(input_ids=ids, attention_mask=am, use_cache=False).logits
+                loss = z[:, -1].logsumexp(-1).mean() - z[:, -1, 7].mean()
+                loss.backward()
+            if ckpt:                                    # restored on remove
+                self.assertTrue(all(dl[li].gradient_checkpointing for li in range(8)))
+            grads = {n: p.grad.detach().clone() for n, p in body.named_parameters() if p.grad is not None}
+        finally:
+            if ckpt:
+                model.gradient_checkpointing_disable()
+            model.eval()
+        return loss.detach(), grads
+
+    def test_gradients_reach_the_window_with_and_without_checkpointing(self):
+        model = tiny_qwen35()
+        res = {c: self.loss_and_grads(model, dict(T=2), c) for c in (False, True)}
+        for c, (loss, grads) in res.items():
+            for li in range(2, 6):
+                names = [n for n in grads if n.startswith(f"layers.{li}.")]
+                self.assertTrue(names, (c, li))
+                self.assertTrue(any(grads[n].abs().sum() > 0 for n in names), (c, li))
+        self.assertTrue(torch.allclose(res[False][0], res[True][0], atol=1e-6))
+        self.assertEqual(sorted(res[False][1]), sorted(res[True][1]))
+        for n in res[False][1]:
+            self.assertTrue(torch.allclose(res[False][1][n], res[True][1][n], atol=1e-5, rtol=1e-4), n)
+
+    def test_T2_gradient_differs_from_T1(self):
+        model = tiny_qwen35()
+        g1 = self.loss_and_grads(model, dict(T=1), False)[1]
