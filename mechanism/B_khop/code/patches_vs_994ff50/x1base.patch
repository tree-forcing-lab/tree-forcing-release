+    hi - lo + 1 layers of new parameters that save_pretrained writes (load_loop_untied reads them back).
+
+    T is a plain attribute: the trainer sets it per micro-batch (LOOP-MIX) and per evaluation. T = 1 returns layer
+    hi + 1's inputs untouched (bit-identical to no hook). The recording hooks ignore the calls made by the loop
+    itself (_in_loop) and start a new record when layer lo fires outside the loop (a new forward). While installed,
+    layers lo..hi + 1 (and the copies) run WITHOUT gradient checkpointing (the hooks run inside HF's checkpointed
+    __call__, so a checkpointed layer hi + 1 would re-run the loop in its backward recompute, and the loop's own
+    calls would nest checkpoints); the flag is restored by remove(). Memory: those hi - lo + 2 layers keep their
+    activations, plus (T - 1) x (hi - lo + 1) layers of extra activations per forward. The loop needs
+    use_cache=False (every pass of a layer would write the same cache slot); the repo's forwards pass it.
+
+    counts[T] is the number of forwards run at each T. log (a list) receives per forward the block-input residual
+    RMS of pass 1 and of each extra pass (the norm guard: logged, never acting), capped at LOOP_LOG_MAX entries.
+    A context manager (__enter__ installs, __exit__ removes) or install() / remove()."""
+
+    def __init__(self, body, lo: int, hi: int, T: int = 2, alpha: float = 1.0, untied: bool = False, log=None):
+        self.body = body
+        self.dl = body_layers(body)
+        n = len(self.dl)
+        if not 0 <= lo <= hi <= n - 2:
+            raise ValueError(f"LayerLoop: 0 <= lo <= hi <= {n - 2} (layer hi + 1 must exist), got {lo}-{hi}")
+        if T < 1:
+            raise ValueError(f"LayerLoop: T >= 1, got {T}")
+        if not 0.0 < alpha <= 1.0:
+            raise ValueError(f"LayerLoop: 0 < alpha <= 1, got {alpha}")
+        self.lo, self.hi, self.T, self.alpha, self.untied = lo, hi, int(T), float(alpha), bool(untied)
+        self.log = log
+        self.counts: dict = {}
+        self.kw: dict = {}
+        self._in_loop = False
+        self.handles: list = []
+        self._ckpt: list = []
+        if untied:
+            copies = getattr(body, "loop_untied", None)
+            if copies is None:
+                body.loop_untied = torch.nn.ModuleList(copy.deepcopy(self.dl[li]) for li in range(lo, hi + 1))
+            elif len(copies) != hi - lo + 1:
+                raise ValueError(f"LayerLoop: body.loop_untied has {len(copies)} layers, the window {lo}-{hi} needs "
+                                 f"{hi - lo + 1}")
+            self.block = list(body.loop_untied)
+        else:
+            self.block = self.dl[lo:hi + 1]
+
+    # ---- spec
+    def spec(self, mix=()) -> dict:
+        return loop_spec_to_dict(self.lo, self.hi, self.T, self.alpha, self.untied, mix)
+
+    @property
+    def installed(self) -> bool:
+        return bool(self.handles)
+
+    # ---- hooks
+    def install(self):
+        if self.handles:
+            raise RuntimeError("LayerLoop: already installed")
+        for li in range(self.lo, self.hi + 1):
+            self.handles.append(self.dl[li].register_forward_pre_hook(self._recorder(li), with_kwargs=True))
+        self.handles.append(self.dl[self.hi + 1].register_forward_pre_hook(self._apply, with_kwargs=True))
+        for lay in self.dl[self.lo:self.hi + 2] + (self.block if self.untied else []):
+            if getattr(lay, "gradient_checkpointing", False):
+                self._ckpt.append(lay)
+                lay.gradient_checkpointing = False
+        return self
+
+    def remove(self) -> None:
+        for hd in self.handles:
+            hd.remove()
+        self.handles = []
+        for lay in self._ckpt:
+            lay.gradient_checkpointing = True
+        self._ckpt = []
+        self.kw.clear()
+        self._in_loop = False
+
+    def __enter__(self):
+        return self.install()
+
+    def __exit__(self, *exc):
+        self.remove()
+        return False
+
+    def _recorder(self, li: int):
+        def pre(mod, args, kwargs):
+            if self._in_loop:
+                return None
+            if li == self.lo:            # a new forward: forget the previous one's kwargs
+                self.kw.clear()
+            self.kw[li] = {k: v for k, v in kwargs.items() if k != "hidden_states"}
+            return None
+        return pre
+
+    @staticmethod
+    def _rms(h: torch.Tensor) -> float:
+        with torch.no_grad():
+            return float(h.detach().float().pow(2).mean(dim=tuple(range(1, h.dim()))).sqrt().mean())
+
+    def _apply(self, mod, args, kwargs):
+        if self._in_loop:
+            return None
+        h = args[0] if args else kwargs["hidden_states"]
+        T = self.T
+        self.counts[T] = self.counts.get(T, 0) + 1
+        rms = [self._rms(h)] if self.log is not None else None
+        if T == 1:
+            if rms is not None and len(self.log) < LOOP_LOG_MAX:
+                self.log.append(rms)
+            return None
+        missing = [li for li in range(self.lo, self.hi + 1) if li not in self.kw]
+        if missing:
+            raise RuntimeError(f"LayerLoop: no pass-1 kwargs recorded for layers {missing} (layer hi + 1 ran before "
+                               "the block; is the loop installed on the right decoder?)")
+        for li in range(self.lo, self.hi + 1):
+            kw = self.kw[li]
+            if kw.get("past_key_values") is not None or kw.get("use_cache"):
+                raise RuntimeError("LayerLoop: use_cache=False is required (every pass would write the same cache slot)")
+        self._in_loop = True
+        try:
+            for _ in range(T - 1):
+                y = h
+                for j, li in enumerate(range(self.lo, self.hi + 1)):
+                    out = self.block[j](y, **self.kw[li])
+                    y = out[0] if isinstance(out, tuple) else out
+                h = y if self.alpha == 1.0 else h + self.alpha * (y - h)
+                if rms is not None:
+                    rms.append(self._rms(h))
+        finally:
+            self._in_loop = False
+        if rms is not None and len(self.log) < LOOP_LOG_MAX:
+            self.log.append(rms)
+        if args:
+            return (h,) + tuple(args[1:]), kwargs
+        kwargs = dict(kwargs)
+        kwargs["hidden_states"] = h
+        return args, kwargs
+
+
 def _align_rows(s: torch.Tensor, t: torch.Tensor) -> torch.Tensor:
     """[N] alignment losses of student / teacher states [N, ..., d]: smooth L1 (beta 1) of s / sigma vs t / sigma with
     sigma the RMS of each teacher vector (detached), mean over the hidden dims, then over every other axis."""
