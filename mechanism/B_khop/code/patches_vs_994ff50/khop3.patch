+    def test_sham_label_coin(self):
+        """Item 2: over 2,000 SHAM draws the label is cf(S) half the time (chi-square, 1 dof, p > 0.01 <=> stat <
+        6.635); the write is F-SIIT's; with S fixed per (R, k) both labels occur."""
+        spec = B3Spec("sham", layer=1, dim=8, seed=4)
+        fs = B3Spec("fsiit", layer=1, dim=8, seed=4)
+        n = hits = ep = 0
+        per_rk: dict = {}
+        while n < 2000:
+            for it in self.items:
+                pl = self.table[it["item_id"]]
+                r = make_example(it, pl, self.table, spec, self.by, epoch=ep)
+                if r is None:
+                    continue
+                ex = r[0]
+                self.assertIn(ex.cf_gold, (ex.cf_s, ex.decoy))
+                f = make_example(it, pl, self.table, fs, self.by, epoch=ep)[0]
+                self.assertEqual((ex.text, ex.nodes, ex.source_text, ex.cf_s, ex.decoy),
+                                 (f.text, f.nodes, f.source_text, f.cf_gold, f.decoy))
+                n += 1
+                hits += ex.cf_gold == ex.cf_s
+                per_rk.setdefault((ex.item_id, ex.k, ex.source_id), set()).add(ex.cf_gold == ex.cf_s)
+            ep += 1
+        chi = (hits - n / 2) ** 2 / (n / 2) + ((n - hits) - n / 2) ** 2 / (n / 2)
+        self.assertLess(chi, 6.635, (hits, n))
+        both = [k for k, v in per_rk.items() if v == {True, False}]
+        self.assertGreaterEqual(len(both), len(per_rk) * 0.9, per_rk)
