+"""Frontier interchange with a learned subspace (card B3 v2 option (b), --b3-rotate): frontier.rotation (Q, 2d x H,
+orthonormal rows, init = the coordinate axes), the rotated write in _SliceWrite, Q's optimizer group (rotation_groups,
+fsdp.ShardCPUAdamW on_device) and the trainer seams. CPU, the tiny random Qwen3.5 text model (8 layers, hidden 64) with
+the GPT-2 tokenizer, as tests/test_frontier_train.py. Checks: Q is the coordinate slice at init and stays orthonormal
+under AdamW; at init the rotated write equals the v1 slice write bit for bit (aligned, strict 'pos' and 'sub') and so do
+the logits; a perturbed Q writes h - Qs^T Qs h + Qs^T Q0 h_s at the node tokens and nothing else; Q gets a nonzero
+gradient with the source detached; the readout runs the rotated write; FSDP2 at world 1: Q outside the model, its own
+group in ShardCPUAdamW, scheduled, stepped, zeroed; the trainer end to end, single process and under torchrun --fsdp
+cpu-adamw (history columns, b3_rotation.pth, an lr of 1e-30 reproduces the rotate-off losses, two ranks refused);
+rotate off = the frozen v1 trainer (COTD_B3V1_REPO); flag validation."""
+import json
+import math
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+sys.path.insert(0, str(ROOT / "tests"))
+
+try:
+    import torch
+    import transformers  # noqa: F401
+    from cotdistill.frontier import (ROT_FILE, B3Example, B3Spec, Frontier, SLOT_SPARE, _SliceWrite, build_table,
+                                     make_example, rotation, rotation_groups, strict_example)
+    from cotdistill.depth_forcing import _Capture, token_at
+    from cotdistill.student import Example, collate, kl_loss, text_parts
+    from test_depth_forcing import gpt2_tok, tiny_qwen35
+    from test_frontier_train import ENV, TRAIN, diamond, finals, items8
+    HAVE = True
+except ImportError:
+    HAVE = False
+
+
+def perturb(fr, scale: float = 0.3, seed: int = 5) -> None:
+    """Q away from its init: random reflector entries off the diagonal (the diagonal keeps its signs)."""
+    p = fr.rot_params()[0]
+    noise = torch.randn(p.shape, generator=torch.Generator().manual_seed(seed))
+    noise.diagonal().zero_()
+    with torch.no_grad():
+        p.add_(scale * noise)
+
+
+def capture_written(fr, model, tok, batch, L):
+    """(letter logits, layer L's output as layer L + 1 reads it in the receiver pass: the second fire)."""
+    fires = []
+    hd = fr.dl[L + 1].register_forward_pre_hook(
+        lambda m, a, k: fires.append((a[0] if a else k["hidden_states"]).detach().clone()), with_kwargs=True)
+    try:
+        with torch.no_grad():
+            z, st = fr.forward(model, tok, batch, 512, {})
+    finally:
+        hd.remove()
+    return z, fires[-1], st
+
+
+@unittest.skipUnless(HAVE, "needs torch + transformers")
+class TestRotation(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        try:
+            cls.tok = gpt2_tok()
+        except Exception as e:
+            raise unittest.SkipTest(f"no local gpt2 tokenizer: {e}")
+        cls.items = items8()
+        cls.by = {it["item_id"]: it for it in cls.items}
+
+    def pair(self, seed=0, **kw):
+        """The same random model twice (rotate off, rotate on) with the same spec otherwise."""
+        out = []
+        for rot in (False, True):
+            model = tiny_qwen35(len(self.tok), seed)
+            model.config.use_cache = False
+            model.eval()
+            spec = B3Spec("fsiit", layer=2, dim=8, seed=1, rotate=rot, **kw)
+            out.append((model, Frontier(model, spec), spec))
+        return out
+
+    def batch(self, spec):
+        """2 plain finals, the full views and strict views of both variants ('pos' and 'sub', a few epochs' coins)."""
+        table = build_table(self.items, spec)
+        views = [make_example(it, table[it["item_id"]], table, spec, self.by)[0] for it in self.items]
+        strict = []
+        for ep in range(4):
+            for it in self.items:
+                r = strict_example(it, table[it["item_id"]], table, spec, self.by, epoch=ep)
+                if r is not None:
+                    strict.append(r[0])
+        self.assertEqual({e.variant for e in strict}, {"pos_num", "sub"})
+        return finals(self.items[:2]) + views[:4] + strict[:6]
+
+    def test_rotation_init_and_orthonormal(self):
+        m = rotation(16, 64)
+        self.assertTrue(torch.equal(m.weight, torch.eye(16, 64)))           # the coordinate axes, exactly
+        self.assertEqual([p.dtype for p in m.parameters()], [torch.float32])
+        self.assertEqual(sum(p.numel() for p in m.parameters()), 16 * 64)    # no H x H base, one reflector matrix
+        self.assertEqual([n for n, _ in m.named_buffers()], [])
+        st = torch.get_rng_state()
+        rotation(16, 64)
+        self.assertTrue(torch.equal(st, torch.get_rng_state()))              # the torch RNG is not touched
+        w = torch.nn.Parameter(torch.randn(4, 64))
+        groups = rotation_groups([w], list(m.parameters()), 1e-2)
+        self.assertEqual((groups[1]["lr"], groups[1]["weight_decay"], groups[1]["on_device"]), (1e-2, 0.0, True))
+        opt = torch.optim.AdamW(groups, lr=1e-3)                             # default weight decay 0.01 on the base
+        x = torch.randn(32, 64)
+        for _ in range(25):
+            loss = ((m.weight @ x.T) ** 3).sum() + (w ** 2).sum()
+            opt.zero_grad()
+            loss.backward()
+            opt.step()
+        Q = m.weight.detach()
+        self.assertLess(float((Q @ Q.T - torch.eye(16)).abs().max()), 1e-5)
+        self.assertGreater(float((Q - torch.eye(16, 64)).norm()), 0.05)     # it moved
+        # the pitfall rotation_groups guards against: weight decay on the reflectors zeroes rows (.int() of the diagonal)
+        m2 = rotation(16, 64)
+        bad = torch.optim.AdamW(m2.parameters(), lr=1e-2, weight_decay=0.1)
+        m2.weight.sum().backward()
+        bad.step()
+        Q2 = m2.weight.detach()
+        self.assertGreater(float((Q2 @ Q2.T - torch.eye(16)).abs().max()), 0.5)
+
+    def test_init_write_equals_v1(self):
+        (m0, f0, s0), (m1, f1, s1) = self.pair()
+        batch = self.batch(s0)
+        z0, w0, st0 = capture_written(f0, m0, self.tok, batch, s0.layer)
+        z1, w1, st1 = capture_written(f1, m1, self.tok, batch, s1.layer)
+        self.assertTrue(torch.equal(w0, w1))                                 # bit for bit, every token and dimension
+        for a, b in zip(z0, z1):
+            self.assertTrue(torch.equal(a, b))
+        self.assertEqual(st0["modes"], st1["modes"])
+        self.assertEqual(st0["cut"], 0)
+        self.assertGreater(st0["modes"]["strict"][0], 0)
+        self.assertTrue(any(isinstance(e, B3Example) and any(n[2] == SLOT_SPARE for n in e.nodes) for e in batch))
+        # with the gradient on (training mode, the hook's fp32 path in the graph) the loss is the same too
+        for m in (m0, m1):
+            m.train()
+        l0 = kl_loss(f0.forward(m0, self.tok, batch, 512, {})[0], batch)
+        l1 = kl_loss(f1.forward(m1, self.tok, batch, 512, {})[0], batch)
+        self.assertEqual(float(l0), float(l1))
+
+    def test_perturbed_write_formula(self):
+        """Q away from the axes: at each node token h <- h - Qs^T Qs h + Qs^T Q0 h_s (h_s the source's full state);
+        every other token unchanged; the write leaves Q's orthogonal complement of the block untouched."""
+        _, (model, fr, spec) = self.pair()
+        perturb(fr)
+        Q = fr.rot.weight.detach()
+        self.assertGreater(float((Q - torch.eye(16, 64)).norm()), 0.5)
+        L, d = spec.layer, spec.dim
+        batch = self.batch(spec)
+        _, written, st = capture_written(fr, model, self.tok, batch, L)
+        self.assertEqual(st["cut"], 0)
+        body = text_parts(model)[0]
+        b = collate(self.tok, batch, 512, "cpu")
+        with torch.no_grad(), _Capture(fr.dl, (L,)) as cap0:
+            body(input_ids=b["input_ids"], attention_mask=b["attention_mask"], use_cache=False)
+        plain = cap0.h[L]
+        srcs = []
+        for e in batch:
+            if isinstance(e, B3Example) and e.nodes and e.source_text not in srcs:
+                srcs.append(e.source_text)
+        sb = collate(self.tok, [Example(t, ["A"], [1.0], 1.0, "final", "s") for t in srcs], 512, "cpu")
+        with torch.no_grad(), _Capture(fr.dl, (L,)) as caps:
+            body(input_ids=sb["input_ids"], attention_mask=sb["attention_mask"], use_cache=False)
+        src = caps.h[L]
+        touched = torch.zeros(plain.shape[:2], dtype=torch.bool)
+        n = 0
+        for i, e in enumerate(batch):
+            if not isinstance(e, B3Example):
+                continue
+            for r_end, s_end, slot in e.nodes:
+                rp, sp = token_at(self.tok, e.text, r_end, 512), token_at(self.tok, e.source_text, s_end, 512)
+                qs, q0 = Q[slot * d:(slot + 1) * d], Q[:d]
+                hr, hs = plain[i, rp], src[srcs.index(e.source_text), sp]
+                want = hr - qs.T @ (qs @ hr) + qs.T @ (q0 @ hs)
+                self.assertTrue(torch.allclose(written[i, rp], want, atol=1e-5, rtol=1e-5), (i, rp, slot))
+                self.assertTrue(torch.allclose(qs @ written[i, rp], q0 @ hs, atol=1e-5))   # the block holds Q0 h_s
+                touched[i, rp] = True
+                n += 1
+        self.assertGreater(n, 0)
+        self.assertTrue(torch.equal(written[~touched], plain[~touched]))
+        self.assertFalse(torch.equal(written[touched][:, 2 * d:], plain[touched][:, 2 * d:]))   # no longer a slice
+
+    def test_q_gradient_with_source_detached(self):
+        for perturbed in (False, True):
+            _, (model, fr, spec) = self.pair()
+            model.train()
+            if perturbed:
+                perturb(fr)
+            table = build_table(self.items, spec)
+            views = [make_example(it, table[it["item_id"]], table, spec, self.by)[0] for it in self.items[:4]]
+            seen = []
+            orig = _SliceWrite.__enter__
+
+            def spy(self_):
+                seen.append((self_.rot is not None, [v.requires_grad for *_, v in self_.writes]))
+                return orig(self_)
+            _SliceWrite.__enter__ = spy
+            try:
+                z, _ = fr.forward(model, self.tok, views, 512, {})
+            finally:
+                _SliceWrite.__enter__ = orig
+            self.assertTrue(seen and seen[0][0])
+            self.assertTrue(seen[0][1] and not any(seen[0][1]))              # the source vectors are detached
+            model.zero_grad(set_to_none=True)
+            kl_loss(z, views).backward()
+            g = fr.rot_params()[0].grad
+            self.assertIsNotNone(g)
+            self.assertGreater(float(g.abs().sum()), 0.0, perturbed)
+            self.assertEqual(float(g.diagonal().abs().sum()), 0.0)          # the diagonal is read only by its sign
+            self.assertTrue(torch.isfinite(g).all())
+
+    def test_readout_uses_q(self):
+        (m0, f0, _), (m1, f1, _) = self.pair()
+        r0 = f0.readout(m0, self.tok, self.items, [], 512, 4, {})
+        rots = []
+        orig = _SliceWrite.__enter__
+
+        def spy(self_):
+            rots.append(self_.rot)
+            return orig(self_)
+        _SliceWrite.__enter__ = spy
+        try:
+            r1 = f1.readout(m1, self.tok, self.items, [], 512, 4, {})
+        finally:
+            _SliceWrite.__enter__ = orig
+        self.assertTrue(rots and all(r is not None for r in rots))
+        self.assertEqual(r0, r1)                                             # init: the v1 readout exactly
+        # the readout's written views see Q: a perturbed Q changes their letter logits
+        perturb(f1, scale=2.0)
+        table = build_table(self.items, f1.spec)
+        views = [make_example(it, table[it["item_id"]], table, f1.spec, self.by)[0] for it in self.items[:4]]
+        with torch.no_grad():
+            za = f0.call(m0, self.tok, views, 512, {})[0]
+            zb = f1.call(m1, self.tok, views, 512, {})[0]
+        self.assertFalse(all(torch.equal(a, b) for a, b in zip(za, zb)))
+
+    def test_spec(self):
+        self.assertEqual(B3Spec("fsiit").as_dict()["rotate"], False)
+        self.assertIsNone(B3Spec("fsiit").as_dict()["rotate_lr"])
+        self.assertEqual(B3Spec("fsiit", rotate=True, rotate_lr=1e-3).as_dict()["rotate_lr"], 1e-3)
+        model = tiny_qwen35(len(self.tok))
+        for kw in ({"rotate_lr": 1e-3}, {"rotate": True, "rotate_lr": 0.0}):
+            with self.assertRaises(ValueError):
+                Frontier(model, B3Spec("fsiit", layer=2, dim=8, **kw))
+        self.assertIsNone(Frontier(model, B3Spec("fsiit", layer=2, dim=8)).rot)
+        self.assertEqual(Frontier(model, B3Spec("fsiit", layer=2, dim=8)).rot_params(), [])
+        fr = Frontier(model, B3Spec("fsiit", layer=2, dim=8, rotate=True))
+        self.assertEqual(tuple(fr.rot.weight.shape), (16, 64))
+        self.assertEqual(fr.rot_stats()["b3_rot_dev"], 0.0)
+        with tempfile.TemporaryDirectory() as d:
+            perturb(fr)
+            fr.save_rotation(Path(d) / ROT_FILE)
+            blob = torch.load(Path(d) / ROT_FILE, weights_only=False)
+            self.assertTrue(torch.equal(blob["Q"], fr.rot.weight.detach()))
+            m = rotation(16, 64)
+            m.load_state_dict(blob["state_dict"])                            # rebuilds the same Q
+            self.assertTrue(torch.equal(m.weight.detach(), blob["Q"]))
+            self.assertEqual((blob["dim"], blob["hidden"], blob["layer"]), (8, 64, 2))
+
