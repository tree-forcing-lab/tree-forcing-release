+    def test_source_forwards_counted(self):
+        """Item 6: a counter on the body's actual forward: a plain micro-batch outside --fsdp runs one forward (the
+        receiver pass), CF-AUG views run one forward even with sync (the --fsdp path), a written arm under sync runs
+        the dummy source pass on a plain micro-batch, and a micro-batch with a write runs two."""
+        calls = []
+        def counted(spec):
+            model, fr, spec, table = self.fresh(spec)
+            body, _ = text_parts(model)
+            body.register_forward_pre_hook(lambda *a: calls.append(1))
+            return model, fr, table
+        model, fr, table = counted(B3Spec("fsiit", layer=2, dim=8, seed=1))
+        calls.clear()
