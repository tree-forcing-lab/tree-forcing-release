+    def overfit(self, spec, steps=30, lr=3e-3):
+        model, fr, spec, table = self.fresh(spec)
+        views = self.views(spec, table)
+        plain = finals(self.items)
+        opt = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad], lr=lr, weight_decay=0.0)
+        ces = []
+        for _ in range(steps):
+            z, st = fr.forward(model, self.tok, plain + views, 512, {})
+            loss = kl_loss(z, plain + views)
+            opt.zero_grad(set_to_none=True)
+            loss.backward()
+            opt.step()
+            with torch.no_grad():
+                ces.append(float(kl_loss([zz.detach() for zz in z[:len(plain)]], plain)))
+        with torch.no_grad():
+            z, st = fr.forward(model, self.tok, views, 512, {})
+            acc = sum(int(zz.argmax()) == v.cf_gold for zz, v in zip(z, views)) / len(views)
+        return acc, ces, model, fr, table, views
+
+    def test_overfit_to_counterfactual(self):
+        acc, ces, model, fr, table, views = self.overfit(B3Spec("fsiit", layer=2, dim=8, seed=1))
+        self.assertEqual(acc, 1.0, ces[::10])
+        self.assertLess(ces[-1], ces[0] * 0.5, (ces[0], ces[-1]))
+        # the readout on the same items (sources from the pool = the items themselves): cf1 / cf11 high, same keeps
+        ro = fr.readout(model, self.tok, self.items, [], 512, 4, {})
+        self.assertGreater(ro["cf11"]["n"] + ro["cf1"]["n"], 0)
+        self.assertGreaterEqual(ro["same"]["n"], 1)                          # d6 <-> d7 share every frontier value
+        for key in ("cf11", "cf1"):
+            if ro[key]["n"]:
+                self.assertIsNotNone(ro[key]["acc"])
+                self.assertIsNotNone(ro[key]["decoy"])
+        self.assertIsNotNone(ro["block_plain"]["gold"])
+        self.assertIsNotNone(ro["misaligned_keep"]["sub"]["keep"])
+        self.assertIn(ro["tier"], ("G-strong", "G-weak", "G-fail"))
+        self.assertIsNotNone(ro["same"]["keep"])
