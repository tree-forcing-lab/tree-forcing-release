+        try:
+            cls.tok = gpt2_tok()
+        except Exception as e:
+            raise unittest.SkipTest(f"no local gpt2 tokenizer: {e}")
+        from test_frontier_train import items8
+        cls.items = items8()
+        cls.by = {it["item_id"]: it for it in cls.items}
+
+    def emb_grad(self, source_grad: bool, ckpt: str):
+        spec = B3Spec("fsiit", layer=2, dim=8, seed=1, source_grad=source_grad)
+        model = tiny_qwen35(len(self.tok), 0)
+        model.config.use_cache = False
+        model.train()
+        if ckpt != "off":
+            model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": ckpt == "reentrant"})
+        fr = Frontier(model, spec)
+        table = build_table(self.items, spec)
+        v = source_only_view(self.tok, self.items, self.by, table, spec)
+        batch = [v] + [make_example(it, table[it["item_id"]], table, spec, self.by)[0] for it in self.items[1:4]]
+        recv = set()
+        for e in batch:
+            recv |= set(self.tok(e.text)["input_ids"])
+        src_ids = self.tok(v.source_text)["input_ids"]
+        from cotdistill.depth_forcing import token_at
+        last = max(token_at(self.tok, v.source_text, s, 512) for _, s, _ in v.nodes)
+        only = sorted(set(src_ids[:last + 1]) - recv)
+        self.assertTrue(only, "the source holds no token the receivers lack")
+        z, st = fr.forward(model, self.tok, batch, 512, {})
+        self.assertEqual(st["cut"], 0)
+        model.zero_grad(set_to_none=True)
+        kl_loss(z, batch).backward()
+        g = text_parts(model)[0].get_input_embeddings().weight.grad
+        return g[only].abs().sum().item(), g.abs().sum().item()
+
+    def test_source_only_row(self):
+        for ckpt in ("off", "reentrant", "nonreentrant"):
+            on, tot_on = self.emb_grad(True, ckpt)
+            off, tot_off = self.emb_grad(False, ckpt)
+            self.assertGreater(on, 0.0, ckpt)
+            self.assertEqual(off, 0.0, ckpt)
+            self.assertGreater(tot_off, 0.0, ckpt)                    # the receiver rows get gradient either way
+
+    def test_blockplain_column(self):
+        """A blockplain view runs unchanged (no source pass) and is logged in its own column with kl_loss's CE."""
+        spec = B3Spec("fsiit", layer=2, dim=8, seed=1, p=0.0, block_all=True)
+        model = tiny_qwen35(len(self.tok), 0)
+        model.config.use_cache = False
+        fr = Frontier(model, spec)
+        table = build_table(self.items, spec)
+        exs = []
+        for it in self.items:
+            f = Example(it["prompt"], list(it["labels"]), [it["teacher"][L] for L in it["labels"]], 1.0, "final",
+                        it["item_id"])
+            exs += substitute([f], it, table[it["item_id"]], table, spec, self.by, 0, {})
+        bp = [e for e in exs if isinstance(e, B3Example)]
+        self.assertTrue(bp and all(e.mode == "blockplain" for e in bp))
+        with torch.no_grad():
+            z, st = fr.forward(model, self.tok, bp, 512, {})
+        self.assertEqual((st["n_src"], st["cut"]), (0, 0))
+        self.assertEqual(st["modes"]["blockplain"][0], len(bp))
+        self.assertEqual(sum(v[0] for m, v in st["modes"].items() if m != "blockplain"), 0)
+        ce = sum(-(torch.tensor(e.target) * torch.log_softmax(zi.float(), -1)).sum().item() for zi, e in zip(z, bp))
+        self.assertAlmostEqual(st["modes"]["blockplain"][1], ce, places=4)
+        w = B3Window()
+        w.add(st)
+        r = w.row()
+        self.assertEqual(r["b3_blockplain_n"], len(bp))
+        self.assertNotIn("b3_blockplain_cut", r)
+
+
+@unittest.skipUnless(HAVE_TORCH, "needs torch + transformers")
+class TestTrainerV2(unittest.TestCase):
+    """train_student.py end to end on the tiny fixture: flag off, the metrics' b3 block (draws, history, readout,
+    training totals less the new zero blockplain column) equals the v1 snapshot's; flag on, every plain view of an item
+    with a view is a blockplain view, forwarded once per epoch."""
+
+    @classmethod
+    def setUpClass(cls):
+        try:
+            cls.tok = gpt2_tok()
+        except Exception as e:
+            raise unittest.SkipTest(f"no local gpt2 tokenizer: {e}")
+
+    def run_train(self, d, out, *extra, script=TRAIN):
+        r = subprocess.run([sys.executable, script, "--model", d + "/m", "--train", d + "/t.jsonl",
+                            "--eval", "val=" + d + "/t.jsonl", "--final", "teacher", "--subq", "none", "--epochs", "3",
+                            "--micro-bs", "3", "--grad-accum", "3", "--max-len", "512", "--eval-max-len", "512",
+                            "--precision", "fp32master", "--lr", "1e-3", "--log-every", "1", "--seed", "1", "--out", out,
+                            "--no-grad-ckpt", "--b3-arm", "fsiit", "--b3-layer", "2", "--b3-dim", "8", *extra],
+                           capture_output=True, text=True, timeout=1500, env=ENV)
+        self.assertEqual(r.returncode, 0, r.stderr[-4000:])
+        return r, json.loads(Path(out + "/metrics.json").read_text())
+
+    def test_flag_off_and_on(self):
+        from test_frontier_train import diamond, items8
+        ref = REF / "scripts/train_student.py"
+        with tempfile.TemporaryDirectory() as d:
+            tiny_qwen35(len(self.tok)).save_pretrained(d + "/m")
+            self.tok.save_pretrained(d + "/m")
+            items = items8() + [dict(diamond(8, 11, 5, 2, 3), item_id="n0", worked_steps=None)]
+            Path(d + "/t.jsonl").write_text("\n".join(json.dumps(x) for x in items) + "\n")
+            _, new = self.run_train(d, d + "/new")
+            if ref.exists():
+                _, old = self.run_train(d, d + "/old", script=str(ref))
+                self.assertEqual([r["loss"] for r in new["history"]], [r["loss"] for r in old["history"]])
+                self.assertEqual(new["eval"]["val"], old["eval"]["val"])
+                b_new, b_old = dict(new["b3"]), dict(old["b3"])
+                for b in (b_new, b_old):
+                    b.pop("timing")
+                self.assertEqual(b_new.pop("block_all"), False)
+                self.assertEqual((b_new.pop("rotate"), b_new.pop("rotate_lr")), (False, None))   # option (b)'s keys
+                self.assertEqual(b_new["train"].pop("blockplain"), {"n": 0, "ce": None, "acc": None, "cut": 0})
+                self.assertEqual(b_new["train_totals"]["modes"].pop("blockplain"), [0, 0.0, 0, 0])
+                self.assertEqual(json.dumps(b_new, sort_keys=True), json.dumps(b_old, sort_keys=True))
+                self.assertEqual(list(b_new["draws"]), list(b_old["draws"]))        # insertion order too
+            r, on = self.run_train(d, d + "/on", "--b3-block-all", "--b3-p", "0.5")
+            self.assertIn("block-all (plain examples in the views' blocks, label the gold)", r.stdout)
+            b3 = on["b3"]
+            self.assertTrue(b3["block_all"])
+            dr = b3["draws"]
+            self.assertEqual(dr["blockplain"], b3["train"]["blockplain"]["n"])
+            self.assertGreater(dr["blockplain"], 0)
+            self.assertEqual(dr["blockplain"] + dr["block_orig"], dr["plain"])
+            self.assertEqual(b3["train"]["plain"]["n"], dr["block_orig"])        # n0 (no steps) and items without a view
+            self.assertGreaterEqual(dr["block_orig"], 3)
+            self.assertIn("b3_blockplain_ce", on["history"][-1])
+            self.assertNotIn("b3_blockplain_cut", on["history"][-1])
+            bad = subprocess.run([sys.executable, TRAIN, "--model", d + "/m", "--train", d + "/t.jsonl", "--epochs", "1",
+                                  "--out", d + "/o", "--b3-block-all"], capture_output=True, text=True, timeout=900,
+                                 env=ENV)
+            self.assertNotEqual(bad.returncode, 0)
+            self.assertIn("--b3-block-all / --b3-rotate / --b3-rotate-lr need --b3-arm", bad.stderr)
+
+
+if __name__ == "__main__":
