+    # ---- --df-pos operand (DFO / DFOX)
+    HAND = {"item_id": "h0", "labels": list("ABCDE"), "gold_label": "A", "n_steps": 3,
+            "teacher": {"A": 1.0, "B": 0.0, "C": 0.0, "D": 0.0, "E": 0.0},
+            "prompt": "Tom had 5 apples. He ate 2 of them, then bought 1,000 grams of pears for 3 coins and 12.5 kg of "
+                      "plums. How many apples are left?\nOptions:\nA) 3\nB) 2\nC) 5\nD) 1000\nE) 7",
+            "options": ["3", "2", "5", "1000", "7"],
+            "worked_steps": [{"step": 1, "a": "5", "b": "2", "value": "3", "text": "5 - 2 = 3"},
+                             {"step": 2, "a": "3", "b": "1000", "value": "3000", "text": "3 x 1000 = 3000"},
+                             {"step": 3, "a": "99", "b": "77", "value": "7623", "text": "99 x 77 = 7623"}]}
+
+    def test_operand_position_found(self):                                 # (a)
+        from cotdistill.student import FINAL_TEMPLATE, collate
+        p = self.HAND["prompt"]
+        q = p.split("\nOptions:")[0]
+        e1, e2, e3 = (operand_end(p, s) for s in self.HAND["worked_steps"])
+        self.assertEqual(q[e1 - 1], "2")                                   # "ate 2": the latest of 5 and 2
+        self.assertEqual(q[:e1].endswith("He ate 2"), True)
+        self.assertEqual(q[:e2].endswith("for 3"), True)                   # "3 coins" after "1,000" (= 1000); not A) 3
+        self.assertIsNone(e3)                                              # 99 and 77 are not in the question
+        text = FINAL_TEMPLATE.format(problem=p)
+        for end, num in ((e1, "2"), (e2, "3")):
+            pos = token_at(self.tok, text, end, 512)
+            enc = self.tok(text, add_special_tokens=False, return_offsets_mapping=True)
+            self.assertEqual(enc["offset_mapping"][pos][1], end)           # the token ends where the number ends
+            self.assertEqual(self.tok.decode([enc["input_ids"][pos]]).strip(), num)
+            b = collate(self.tok, finals([self.HAND]), 512, "cpu")
+            self.assertEqual(int(b["input_ids"][0, pos]), enc["input_ids"][pos])   # the same index in collate's row
+            self.assertLess(pos, int(b["last"][0]))
+        # the slow path (prefix re-tokenised) agrees on this text
+        ids = self.tok.encode(text, add_special_tokens=False)
+        self.assertEqual(len(self.tok.encode(text[:e1], add_special_tokens=False)) - 1, token_at(self.tok, text, e1, 512))
+        # the tail cut: a max_len that drops the first tokens shifts the index; one that drops the number gives None
+        n = len(ids)
+        self.assertEqual(token_at(self.tok, text, e1, n - 3), token_at(self.tok, text, e1, 512) - 3)
+        pos1 = token_at(self.tok, text, e1, 512)
+        self.assertIsNone(token_at(self.tok, text, e1, n - pos1 - 1))
+        self.assertEqual(token_at(self.tok, text, e1, n - pos1), 0)
+        # canonical matching: "1,000" in the text is operand "1000"; a standalone "5" is not matched by "12.5"
+        self.assertEqual(q[:operand_end(p, {"a": "1000", "b": "0"})].endswith("1,000"), True)
+        self.assertEqual(q[:operand_end(p, {"a": "5", "b": "x"})].endswith("had 5"), True)
+        self.assertEqual(q[:operand_end(p, {"a": "12.5", "b": "x"})].endswith("12.5"), True)
+        self.assertIsNone(operand_end(p, {"a": None, "b": None}))
+        # the options block is not searched: "7" occurs only as option E) 7 -> no position; "3" (option A) is read at
+        # "for 3" in the question, not at the option line (checked above); without an Options block the whole prompt is
+        self.assertIsNone(operand_end(p, {"a": "7", "b": "7"}))
+        self.assertIn("E) 7", p)
+        self.assertEqual(operand_end("Tom had 7 apples.", {"a": "7", "b": "x"}), len("Tom had 7"))
+
+    def test_no_operand_step_skipped_and_counted(self):                    # (b)
+        spec = DFSpec((1, 3, 5), lam=0.5, dim=32, pos="operand")
+        items = self.items + [self.HAND]
+        table = build_table(items, spec)
+        self.assertEqual(table["h0"].ends[2], None)
+        self.assertEqual(no_operand_counts(table, 3), [0, 0, 1])
+        self.assertEqual(supervised_counts(table, 3, "operand"), [9, 7, 4])     # h0 supervises steps 1 and 2 only
+        self.assertEqual(supervised_counts(table, 3, "answer"), [9, 7, 5])
+        self.assertFalse(table["h0"].supervised(3, "operand"))
+        self.assertTrue(table["h0"].supervised(3, "answer"))
+        model = tiny_qwen35(len(self.tok))
+        model.train()
+        df = DepthForcing(model, spec)
+        z, aux, st = df.forward(model, self.tok, finals(items), 512, {}, table)
+        self.assertEqual(st["skipped"], {"no_operand": 1, "truncated": 0})
+        self.assertEqual({k: v[1] for k, v in st["per_k"].items()}, {1: 9, 2: 7, 3: 4})
+        self.assertTrue(torch.isfinite(aux))
+        probe = df.probe(model, self.tok, items, 512, 4, {})
+        self.assertEqual((probe["pos"], probe["pairs"], probe["no_operand_position"]), ("operand", [9, 7, 4], [0, 0, 1]))
+        # a position cut by max_len is counted as truncated
+        z, aux, st = df.forward(model, self.tok, finals([self.HAND]), 12, {}, table)
+        self.assertEqual(st["skipped"], {"no_operand": 1, "truncated": 2})
+        self.assertEqual(st["n"], 0)
+        w = DFWindow(3)
+        w.add(st)
+        self.assertEqual(w.skipped, {"no_operand": 1, "truncated": 2})
