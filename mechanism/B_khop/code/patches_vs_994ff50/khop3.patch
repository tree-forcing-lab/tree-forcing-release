+    def test_answer_position_is_last_token(self):                          # (d): pos answer = the previous build
+        """--df-pos answer reads b["last"] for every pair: the auxiliary loss equals an independent recomputation of
+        the InfoNCE from the captured states at the answer positions (same heads); a sidecar without "pos" (written by
+        the build before --df-pos) loads as answer; the default spec is answer."""
+        import torch.nn.functional as F
+        from cotdistill.student import collate
+        model, df, table = self.fresh()
+        self.assertEqual(DFSpec((1,)).pos, "answer")
+        self.assertEqual(DFSpec.from_dict({"layers": [1, 3, 5]}).pos, "answer")
+        self.assertEqual(table["d0"].ends, [])
+        model.eval()
+        with torch.no_grad():
+            z, aux, st = df.forward(model, self.tok, self.batch, 512, {}, table)
+            body, _ = text_parts(model)
+            b = collate(self.tok, self.batch, 512, "cpu")
+            with _Capture(df.dl, df.spec.layers) as cap:
+                body(input_ids=b["input_ids"], attention_mask=b["attention_mask"], use_cache=False)
+            pairs = [(i, k) for i, e in enumerate(self.batch) for k in range(1, len(table[e.item_id].targets) + 1)]
+            anchors = torch.stack([df.heads.head(k)(cap.h[df.layer_of(k)][i, b["last"][i]]) for i, k in pairs])
+            strings, allowed, pos = DepthForcing.candidates(self.batch, table, pairs)
+            E = F.normalize(df.encode_values(model, self.tok, strings), dim=-1)
+            sims = F.normalize(anchors, dim=-1) @ E.T / df.spec.temperature
+            losses = []
+            for r, (cset, p) in enumerate(zip(allowed, pos)):
+                idx = sorted(cset)
+                losses.append(F.cross_entropy(sims[r, idx][None], torch.tensor([idx.index(p)])))
+            self.assertLess(abs(torch.stack(losses).mean().item() - aux.item()), 1e-6)
+            self.assertEqual(st["n"], len(pairs))
+
+    # ---- --df-head-lr (the heads' own optimizer group)
+    def test_param_groups(self):                                           # head-lr (a), (b)
+        model, df, table = self.fresh()
+        params = [p for p in model.parameters() if p.requires_grad]
+        self.assertIs(param_groups(params, df.heads, None), params)       # (b): one group, the plain optimizer
+        opt0 = torch.optim.AdamW(param_groups(params, df.heads, None), lr=1e-6, weight_decay=0.0)
+        self.assertEqual(len(opt0.param_groups), 1)
+        self.assertEqual([id(p) for p in opt0.param_groups[0]["params"]], [id(p) for p in params])
+        g = param_groups(params, df.heads, 1e-2)                            # (a): two groups
+        self.assertEqual(len(g), 2)
+        head_ids = [id(p) for p in df.heads.parameters()]
+        self.assertEqual([id(p) for p in g[1]["params"]], [id(p) for p in params if id(p) in set(head_ids)])
+        self.assertEqual(sorted(id(p) for p in g[1]["params"]), sorted(head_ids))
+        self.assertEqual(len(g[1]["params"]), 4)
+        self.assertEqual((g[1]["lr"], g[1]["weight_decay"]), (1e-2, 0.0))
+        self.assertEqual([id(p) for p in g[0]["params"]], [id(p) for p in params if id(p) not in set(head_ids)])
+        self.assertEqual(len(g[0]["params"]) + len(g[1]["params"]), len(params))
+        opt = torch.optim.AdamW(g, lr=1e-6, weight_decay=0.0)
+        self.assertEqual([pg["lr"] for pg in opt.param_groups], [1e-6, 1e-2])
+        self.assertEqual([pg["weight_decay"] for pg in opt.param_groups], [0.0, 0.0])
+        # the scheduler scales both groups by the same factor: the ratio stays head / base along the schedule
+        import math
+        warm, total = 3, 10
+        sched = torch.optim.lr_scheduler.LambdaLR(opt, lambda s, w=warm, t=total: min(1.0, (s + 1) / w) * 0.5 * (
+            1 + math.cos(math.pi * min(1.0, s / t))))
+        for s in range(total):
+            base_lr, head_lr = (pg["lr"] for pg in opt.param_groups)
+            self.assertAlmostEqual(head_lr / base_lr, 1e4, places=6, msg=s)
+            self.assertAlmostEqual(base_lr, 1e-6 * min(1.0, (s + 1) / warm) * 0.5 * (1 + math.cos(math.pi * s / total)), places=12)
+            opt.step()
+            sched.step()
+        with self.assertRaises(ValueError):
+            param_groups(params, df.heads, 0.0)
+        with self.assertRaises(ValueError):
+            param_groups(params[:-4], df.heads, 1e-2)                     # a head parameter not trainable
+
+    def test_sharded_optim_groups(self):
+        """--fsdp cpu-adamw (world 1: plain tensors): ShardedOptim with the groups has two param groups with the right
+        lr, the clipping still covers every parameter, and a step moves the heads at their own rate."""
+        from cotdistill.fsdp import ShardedOptim
+        model, df, table = self.fresh()
+        params = [p for p in model.parameters() if p.requires_grad]
+        g = param_groups(params, df.heads, 1e-2)
+        tr = ShardedOptim(params, "cpu-adamw", 1e-6, torch.device("cpu"), groups=g)
+        self.assertEqual([pg["lr"] for pg in tr.opt.param_groups], [1e-6, 1e-2])
+        self.assertEqual(len(tr.opt.param_groups[1]["params"]), 4)
+        self.assertEqual(len(tr.params), len(params))
+        tr0 = ShardedOptim(params, "cpu-adamw", 1e-6, torch.device("cpu"))
+        self.assertEqual(len(tr0.opt.param_groups), 1)
+        before = {n: p.detach().clone() for n, p in model.named_parameters()}
+        z, aux, st = df.forward(model, self.tok, self.batch, 512, {}, table)
+        (kl_loss(z, self.batch) + 0.5 * aux).backward()
+        tr.clip_grad_norm_(1.0)
+        tr.step()
+        moved = {n: (p.detach() - before[n]).abs().max().item() for n, p in model.named_parameters()}
+        self.assertGreater(moved["model.df_heads.heads.0.weight"], 1e-3)   # Adam's first step is about lr per weight
+        self.assertLess(moved["model.layers.1.mlp.down_proj.weight"], 1e-5)
+        tr.release()
+
+    def test_head_lr_fixes_the_pilot_failure(self):                        # head-lr (c)
+        """Base lr 1e-6 (the cluster pilot's regime, j601: aux 3.70 -> 3.65, probe at chance): with --df-head-lr 1e-2
+        the probe reaches 1.0 at every layer in 30 steps at operand positions (the operand tokens differ across items,
+        so the random tiny model's states there are separable); the same run with the heads at the base lr stays at
+        chance. At the answer position the random tiny model's states differ across items by 0.5% of their norm
+        (see overfit), so the heads alone cannot separate them in 30 steps: there the check is that the auxiliary loss
+        falls from about 4.5 to below 2 with the head rate and stays above 4.3 without it."""
+        spec = DFSpec((1, 3, 5), lam=0.5, dim=32, pos="operand")
+        _, _, with_head, *_ = self.overfit(spec, lr_heads=1e-2, lr_base=1e-6)
+        self.assertEqual(with_head, {1: 1.0, 2: 1.0, 3: 1.0})
+        _, accs, without, *_ = self.overfit(spec, lr_heads=1e-6, lr_base=1e-6)
+        self.assertLess(max(without.values()), 0.5, without)
+        spec_a = DFSpec((1, 3, 5), lam=0.5, dim=32)
+        aux_with = self.overfit_aux(spec_a, lr_heads=1e-2, lr_base=1e-6)
+        aux_without = self.overfit_aux(spec_a, lr_heads=1e-6, lr_base=1e-6)
+        self.assertLess(aux_with[-1], 2.0, aux_with[::10])
+        self.assertGreater(aux_without[-1], 4.3, aux_without[::10])
+
+    def overfit_aux(self, spec, steps=30, lr_heads=1e-2, lr_base=1e-3) -> list:
+        """The auxiliary loss along the overfit protocol (its last value is a tracked run, not the final re-forward)."""
+        model, df, table = self.fresh(spec)
+        params = [p for p in model.parameters() if p.requires_grad]
+        opt = torch.optim.AdamW(param_groups(params, df.heads, None if lr_heads == lr_base else lr_heads), lr=lr_base,
+                                weight_decay=0.0)
+        auxs = []
+        for _ in range(steps):
+            z, aux, st = df.forward(model, self.tok, self.batch, 512, {}, table)
+            opt.zero_grad(set_to_none=True)
+            (kl_loss(z, self.batch) + spec.lam * aux).backward()
+            opt.step()
+            auxs.append(aux.detach().item())
+        return auxs
+
