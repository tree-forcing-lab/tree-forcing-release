+            return float(h.detach().float().pow(2).mean(dim=tuple(range(1, h.dim()))).sqrt().mean())
+
+    def _apply(self, mod, args, kwargs):
+        if self._in_loop:
+            return None
+        h = args[0] if args else kwargs["hidden_states"]
+        T = self.T
+        self.counts[T] = self.counts.get(T, 0) + 1
+        rms = [self._rms(h)] if self.log is not None else None
+        if T == 1:
+            if rms is not None and len(self.log) < LOOP_LOG_MAX:
+                self.log.append(rms)
+            return None
+        missing = [li for li in range(self.lo, self.hi + 1) if li not in self.kw]
+        if missing:
+            raise RuntimeError(f"LayerLoop: no pass-1 kwargs recorded for layers {missing} (layer hi + 1 ran before "
+                               "the block; is the loop installed on the right decoder?)")
+        for li in range(self.lo, self.hi + 1):
+            kw = self.kw[li]
+            if kw.get("past_key_values") is not None or kw.get("use_cache"):
+                raise RuntimeError("LayerLoop: use_cache=False is required (every pass would write the same cache slot)")
+        self._in_loop = True
+        try:
+            for _ in range(T - 1):
+                y = h
+                for j, li in enumerate(range(self.lo, self.hi + 1)):
+                    out = self.block[j](y, **self.kw[li])
+                    y = out[0] if isinstance(out, tuple) else out
+                h = y if self.alpha == 1.0 else h + self.alpha * (y - h)
+                if rms is not None:
+                    rms.append(self._rms(h))
+        finally:
+            self._in_loop = False
+        if rms is not None and len(self.log) < LOOP_LOG_MAX:
+            self.log.append(rms)
+        if args:
+            return (h,) + tuple(args[1:]), kwargs
+        kwargs = dict(kwargs)
+        kwargs["hidden_states"] = h
+        return args, kwargs
+
+
 def _align_rows(s: torch.Tensor, t: torch.Tensor) -> torch.Tensor:
     """[N] alignment losses of student / teacher states [N, ..., d]: smooth L1 (beta 1) of s / sigma vs t / sigma with
     sigma the RMS of each teacher vector (detached), mean over the hidden dims, then over every other axis."""
