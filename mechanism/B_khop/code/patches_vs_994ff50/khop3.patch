+        # ... but not through the target encodings: they read the embedding table detached
+        model, df, table = self.fresh()
+        emb = text_parts(model)[0].get_input_embeddings().weight
+        df.encode_values(model, self.tok, ["101", "12.5"]).sum().backward()
