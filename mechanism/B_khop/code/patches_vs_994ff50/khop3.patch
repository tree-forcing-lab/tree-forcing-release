+    def test_candidates_hold_the_positive_once_and_loss_is_finite(self):   # (4)
+        model, df, table = self.fresh()
+        items = [dict(it, options=it["options"] + [it["worked_steps"][0]["value"] + ".0"]) for it in self.items]
+        table = build_table(items, df.spec)                                # an option equal in value to step 1
+        pairs = [(i, k) for i, e in enumerate(self.batch) for k in range(1, len(table[e.item_id].targets) + 1)]
+        strings, allowed, pos = DepthForcing.candidates(self.batch, table, pairs)
+        self.assertEqual(len({canon_number(s) for s in strings}), len(strings))   # distinct numeric values
+        for (i, k), cset, p in zip(pairs, allowed, pos):
+            d = table[self.batch[i].item_id]
+            self.assertIn(p, cset)
+            self.assertEqual(canon_number(strings[p]), canon_number(d.targets[k - 1]))
+            same = [j for j in cset if canon_number(strings[j]) == canon_number(strings[p])]
+            self.assertEqual(same, [p], (i, k))                            # the positive once, no duplicate negative
+            for t in d.targets + d.options + d.nums:                       # (a) (b) (d) are candidates
+                self.assertIn(canon_number(t), {canon_number(strings[j]) for j in cset})
+            for e in self.batch:                                           # (c) the other items' targets
+                for t in table[e.item_id].targets:
+                    self.assertIn(canon_number(t), {canon_number(strings[j]) for j in cset})
+            self.assertGreaterEqual(len(cset), 20)
+        z, aux, st = df.forward(model, self.tok, self.batch, 512, {}, table)
+        self.assertTrue(torch.isfinite(aux))
+        self.assertGreater(aux.detach().item(), 0.0)
