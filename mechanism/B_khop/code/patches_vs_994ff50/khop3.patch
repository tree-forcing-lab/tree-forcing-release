+    def test_weight_zero_pairs_are_in_the_graph_but_not_counted(self):
+        """An --fsdp pad micro-batch (one sequence at weight 0): zero auxiliary loss, zero head gradients (not None),
+        no counted pair."""
+        import dataclasses
+        model, df, table = self.fresh()
+        pad = [dataclasses.replace(self.batch[3], weight=0.0)]
+        z, aux, st = df.forward(model, self.tok, pad, 512, {}, table)
+        self.assertEqual((st["n"], aux.detach().item()), (0, 0.0))
+        self.assertEqual({k: v[1] for k, v in st["per_k"].items()}, {1: 0, 2: 0, 3: 0})
+        g = self.grads(model, aux)
+        for n in ("model.df_heads.heads.0.weight", "model.df_heads.heads.1.weight", "model.df_heads.proj.weight"):
+            self.assertIn(n, g, n)
+            self.assertEqual(g[n].abs().sum().item(), 0.0, n)
+        # a micro-batch of items without steps: the heads still enter the graph (every rank reduces the same set)
+        no_steps = finals([df_item(9, 2, with_steps=False)])
+        z, aux, st = df.forward(model, self.tok, no_steps, 512, {}, table)
+        self.assertEqual(st["n"], 0)
+        g = self.grads(model, aux)
+        self.assertIn("model.df_heads.heads.2.weight", g)
