+    def test_reentrancy(self):
+        loop = LayerLoop(self.body, 2, 5, T=2).install()
+        with self.assertRaises(RuntimeError):
+            loop.install()
+        loop.remove()
+        loop.remove()                                   # a second remove is a no-op
