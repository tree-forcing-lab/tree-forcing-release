+        self.assertEqual(short["block_plain"]["cut"], 0)                     # no write, never cut
+        tot = lambda r: sum(r["misaligned_keep"][v]["n"] for v in ("sub", "pos_num", "pos_other"))
+        self.assertEqual(tot(short) + short["misaligned_keep"]["cut"], tot(full))
