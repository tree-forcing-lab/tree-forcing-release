+def wide(iid: str, a: int, b: int, c: int, d: int, who: str = "Kim") -> dict:
+    """A two-node frontier at k = 2 with the nodes on different tokens: s0 = a + b (literals a, b), s1 = c x d (literals
+    c, d, later in the text), s2 = s0 + s1, s3 = s2 x 2 (the literal 2 of 'twice')."""
+    s0, s1 = a + b, c * d
+    return item(iid, f"{who} has {a} red and {b} blue pens, then {c} boxes of {d} pens each, then twice the total.",
+                [step(0, "+", a, b, s0), step(1, "×", c, d, s1), step(2, "+", s0, s1, s0 + s1, a_from=0, b_from=1),
+                 step(3, "×", s0 + s1, 2, 2 * (s0 + s1), a_from=2)],
+                [str(2 * (s0 + s1))] + [str(2 * (s0 + s1) + o) for o in (3, 7, 11, 13)])
+
+
+def shared(iid: str, a: int, b: int) -> dict:
+    """Two frontier nodes on ONE token: s0 = a + b and s1 = a x b both become computable at b; s2 = s0 + s1."""
+    return item(iid, f"Lee has {a} cups and {b} plates.",
+                [step(0, "+", a, b, a + b), step(1, "×", a, b, a * b), step(2, "+", a + b, a * b, 2 * a * b // 2 + a + b,
+                                                                           a_from=0, b_from=1)],
+                [str(a + b + a * b), "1", "2", "3", "4"])
+
