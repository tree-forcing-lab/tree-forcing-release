+    def fresh(self, spec=None, seed=0):
+        model = tiny_qwen35(len(self.tok), seed)
+        model.config.use_cache = False
+        model.train()
+        spec = spec or B3Spec("fsiit", layer=2, dim=8, seed=1)       # 2 x 4 x 8 = 64 = hidden
+        fr = Frontier(model, spec)
+        table = build_table(self.items, spec)
+        return model, fr, spec, table
+
+    def views(self, spec, table, epoch=0):
+        out = []
+        for it in self.items:
+            r = make_example(it, table[it["item_id"]], table, spec, self.by, epoch=epoch)
+            if r is None:                                  # ssiit: an item whose single-node counterfactuals are not clean
+                self.assertEqual(spec.arm, "ssiit", it["item_id"])
+                continue
+            out.append(r[0])
+        self.assertGreaterEqual(len(out), 6)
+        return out
+
+    def test_spec_limits(self):
+        model = tiny_qwen35(len(self.tok))
+        with self.assertRaises(ValueError):
+            Frontier(model, B3Spec("fsiit", layer=7, dim=8))                  # layer L + 1 must exist
+        with self.assertRaises(ValueError):
+            Frontier(model, B3Spec("fsiit", layer=2, dim=40))                 # 2 x 40 > 64 (aligned + spare slice)
+        Frontier(model, B3Spec("fsiit", layer=2, dim=32))                     # 2 x 32 = 64: max_nodes no longer counts
+        Frontier(model, B3Spec("fsiit", layer=2, dim=8))
+
+    def test_slice_write_is_exact(self):                                    # the write and nothing else
+        model, fr, spec, table = self.fresh()
+        model.eval()
+        views = self.views(spec, table)
+        batch = finals(self.items[:2]) + views[:3]
+        body, _ = text_parts(model)
+        L, d = spec.layer, spec.dim
+        # the receiver's layer-L output with the write, captured at layer L + 1's input (the second fire: the source
+        # pass runs first inside forward)
+        fires = []
+        hd = fr.dl[L + 1].register_forward_pre_hook(lambda m, a, k: fires.append((a[0] if a else k["hidden_states"]).detach().clone()),
+                                                     with_kwargs=True)
+        try:
+            with torch.no_grad():
+                z, st = fr.forward(model, self.tok, batch, 512, {})
+        finally:
+            hd.remove()
+        self.assertEqual(len(fires), 2)
+        written = fires[1]
+        b = collate(self.tok, batch, 512, "cpu")
+        with torch.no_grad(), _Capture(fr.dl, (L,)) as cap0:
+            body(input_ids=b["input_ids"], attention_mask=b["attention_mask"], use_cache=False)
+        plain = cap0.h[L]
+        # the sources' layer-L outputs
+        srcs = sorted({v.source_text for v in views[:3]}, key=lambda t: [v.source_text for v in views[:3]].index(t))
+        sb = collate(self.tok, [Example(t, ["A"], [1.0], 1.0, "final", "s") for t in srcs], 512, "cpu")
+        with torch.no_grad(), _Capture(fr.dl, (L,)) as caps:
+            body(input_ids=sb["input_ids"], attention_mask=sb["attention_mask"], use_cache=False)
+        src = caps.h[L]
+        mask = torch.zeros_like(plain, dtype=torch.bool)
+        for i, v in enumerate(batch):
+            if not isinstance(v, B3Example):
+                continue
+            for r_end, s_end, slot in v.nodes:
+                rp, sp = token_at(self.tok, v.text, r_end, 512), token_at(self.tok, v.source_text, s_end, 512)
+                self.assertEqual(slot, 0)
+                self.assertTrue(torch.equal(written[i, rp, 0:d], src[srcs.index(v.source_text), sp, 0:d]))
+                mask[i, rp, 0:d] = True
+        self.assertTrue(torch.equal(written[~mask], plain[~mask]))           # nothing else changed
+        self.assertTrue(torch.equal(written[..., 2 * d:], plain[..., 2 * d:]))   # nothing outside [0, 2d) ever
+        self.assertGreater(int(mask.sum()), 0)
+        two = [v for v in batch if isinstance(v, B3Example) and len(v.nodes) == 2]
+        for v in two:                                                        # two nodes: two distinct tokens
+            self.assertEqual(len({token_at(self.tok, v.text, n[0], 512) for n in v.nodes}), 2)
+        self.assertEqual(st["modes"]["full"][0], 3)
+        self.assertEqual(st["n_src"], len(srcs))
+        self.assertEqual(st["cut"], 0)
+        # plain examples give label_logits' logits bit for bit (the write touches other rows only)
+        z_plain = label_logits(model, self.tok, batch[:2], 512, {})
+        for a_, b_ in zip(z_plain, z[:2]):
+            self.assertTrue(torch.equal(a_, b_))
+
+    def test_single_and_strict_writes(self):
+        spec = B3Spec("ssiit", layer=2, dim=8, seed=1)
+        model, fr, spec, table = self.fresh(spec)
+        views = self.views(spec, table)
+        self.assertTrue(all(len(v.nodes) == 1 for v in views))
+        z, st = fr.forward(model, self.tok, views, 512, {})
+        self.assertEqual(st["modes"]["single"][0], len(views))
+        sv = [strict_example(it, table[it["item_id"]], table, spec, self.by, epoch=0) for it in self.items]
+        sv = [x[0] for x in sv if x is not None]
+        self.assertGreaterEqual(len(sv), 6)                                   # every item with S and S'
+        z2, st2 = fr.forward(model, self.tok, sv, 512, {})
+        self.assertEqual(st2["modes"]["strict"][0], len(sv))
