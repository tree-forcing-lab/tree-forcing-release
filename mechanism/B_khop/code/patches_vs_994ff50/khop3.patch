+    def test_plain_column_equals_unhooked(self):
+        """Item 5: on a micro-batch without an intervened view the plain column's CE is the soft CE of an un-hooked
+        forward (label_logits) to 1e-5, its hits the argmax vs the gold."""
+        model, fr, spec, table = self.fresh()
+        model.eval()
+        batch = [dataclasses_replace(e, gold=it["labels"].index(it["gold_label"]))
+                 for e, it in zip(finals(self.items[:5]), self.items[:5])]
+        with torch.no_grad():
+            z, st = fr.forward(model, self.tok, batch, 512, {})
+            ref = label_logits(model, self.tok, batch, 512, {})
+        ce = sum(float(-(torch.tensor(e.target) * torch.log_softmax(r.float(), -1)).sum()) for r, e in zip(ref, batch))
+        hits = sum(int(r.argmax()) == e.gold for r, e in zip(ref, batch))
+        n, ce_sum, h, cut = st["modes"]["plain"]
+        self.assertEqual(cut, 0)
+        self.assertEqual(n, 5)
+        self.assertLess(abs(ce_sum / n - ce / 5), 1e-5)
+        self.assertEqual(h, hits)
+        w = B3Window()
+        w.add(st)
+        r = w.row()
+        self.assertLess(abs(r["b3_plain_ce"] - round(ce / 5, 4)), 1e-4)
+        self.assertEqual((r["b3_plain_n"], r["b3_plain_acc"]), (5, round(hits / 5, 4)))
+        self.assertEqual(B3Window.per_mode(st)["plain"]["n"], 5)
