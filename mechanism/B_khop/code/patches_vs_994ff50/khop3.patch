+    def test_source_grad_inside_root(self):
+        """--b3-source-grad on the cluster path (card v2 option (a)): inside Readout.run with non-reentrant
+        checkpointing, the source pass stays in the graph: the embedding rows only the source text holds get the same
+        gradient as on the plain model (nonzero), and every gradient equals the plain model's."""
+        from cotdistill import fsdp as fsdp_lib
+        from cotdistill.fsdp import _local
+        from test_frontier_v2 import source_only_view
+        spec = B3Spec("fsiit", layer=2, dim=8, seed=1, source_grad=True)
+        table = build_table(self.items, spec)
+        v = source_only_view(self.tok, self.items, self.by, table, spec)
+        batch = [v] + [make_example(it, table[it["item_id"]], table, spec, self.by)[0] for it in self.items[1:4]]
+        recv = set()
+        for e in batch:
+            recv |= set(self.tok(e.text)["input_ids"])
+        only = sorted(set(self.tok(v.source_text)["input_ids"]) - recv)
+        grads = []
+        for sharded in (False, True):
+            model = tiny_qwen35(len(self.tok))
+            model.config.use_cache = False
+            model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
+            fr = Frontier(model, spec)
+            root = fsdp_lib.shard_model(model, self.fs.mesh) if sharded else model
+            root.train()
+            z, st = fr.call(root, self.tok, batch, 512, {})
+            self.assertEqual((st["cut"], st["n_src"]), (0, len({e.source_text for e in batch})))
+            kl_loss(z, batch).backward()
+            grads.append({n: _local(p.grad).detach().clone() for n, p in model.named_parameters() if p.grad is not None})
+        plain, shard = grads
+        self.assertEqual(set(plain), set(shard))
+        emb = next(n for n in plain if n.endswith("embed_tokens.weight"))
