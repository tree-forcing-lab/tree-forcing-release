+    def test_checkpointing_same_loss(self):                                # (8)
+        def run(ckpt):
+            model, df, table = self.fresh()
+            if ckpt is not None:
+                model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": ckpt})
+                if ckpt:
+                    model.enable_input_require_grads()
+            z, aux, st = df.forward(model, self.tok, self.batch, 512, {}, table)
+            loss = (kl_loss(z, self.batch) * len(self.batch) + 0.5 * aux * len(self.batch)) / len(self.batch)
+            g = self.grads(model, loss)
+            return loss.detach(), aux.detach().item(), g
+        off, non_re, re = run(None), run(False), run(True)
+        for name, (loss, aux, g) in (("non-reentrant", non_re), ("reentrant", re)):
+            self.assertLess(abs(float(loss) - float(off[0])), 1e-5, name)
+            self.assertLess(abs(aux - off[1]), 1e-5, name)
+            self.assertEqual(set(g), set(off[2]), name)
+            for n in off[2]:
+                self.assertTrue(torch.allclose(off[2][n], g[n], atol=1e-5, rtol=1e-4), (name, n))
+        for n in ("model.layers.0.mlp.down_proj.weight", "model.layers.4.mlp.down_proj.weight",
+                  "model.df_heads.heads.0.weight", "model.df_heads.heads.2.weight", "model.df_heads.proj.weight"):
+            self.assertGreater(off[2][n].abs().sum().item(), 0.0, n)      # the auxiliary gradient reaches them
