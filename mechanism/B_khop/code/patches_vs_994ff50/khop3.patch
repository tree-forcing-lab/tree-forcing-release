+@unittest.skipUnless(HAVE, "needs torch + transformers")
+class TestLoopTraining(unittest.TestCase):
+    def loss_and_grads(self, model, loop_kw, ckpt: bool):
+        """One training forward/backward at the loop's T: (loss, {name: grad} of the window + neighbours)."""
+        body, _ = text_parts(model)
+        model.train()
+        model.zero_grad(set_to_none=True)
+        if ckpt:
+            model.gradient_checkpointing_enable()
+        try:
+            ids, am = batch()
+            with LayerLoop(body, 2, 5, **loop_kw) as loop:
+                dl = body_layers(body)
+                if ckpt:                                # the window and hi + 1 run unchecked, the others checked
+                    self.assertTrue(all(not dl[li].gradient_checkpointing for li in range(2, 7)))
+                    self.assertTrue(all(dl[li].gradient_checkpointing for li in (0, 1, 7)))
+                    if loop.untied:
+                        self.assertTrue(all(not m.gradient_checkpointing for m in body.loop_untied))
+                z = model(input_ids=ids, attention_mask=am, use_cache=False).logits
+                loss = z[:, -1].logsumexp(-1).mean() - z[:, -1, 7].mean()
+                loss.backward()
+            if ckpt:                                    # restored on remove
+                self.assertTrue(all(dl[li].gradient_checkpointing for li in range(8)))
+            grads = {n: p.grad.detach().clone() for n, p in body.named_parameters() if p.grad is not None}
+        finally:
+            if ckpt:
+                model.gradient_checkpointing_disable()
+            model.eval()
+        return loss.detach(), grads
+
+    def test_gradients_reach_the_window_with_and_without_checkpointing(self):
+        model = tiny_qwen35()
+        res = {c: self.loss_and_grads(model, dict(T=2), c) for c in (False, True)}
+        for c, (loss, grads) in res.items():
+            for li in range(2, 6):
+                names = [n for n in grads if n.startswith(f"layers.{li}.")]
+                self.assertTrue(names, (c, li))
+                self.assertTrue(any(grads[n].abs().sum() > 0 for n in names), (c, li))
+        self.assertTrue(torch.allclose(res[False][0], res[True][0], atol=1e-6))
+        self.assertEqual(sorted(res[False][1]), sorted(res[True][1]))
+        for n in res[False][1]:
+            self.assertTrue(torch.allclose(res[False][1][n], res[True][1][n], atol=1e-5, rtol=1e-4), n)
+
+    def test_T2_gradient_differs_from_T1(self):
+        model = tiny_qwen35()
+        g1 = self.loss_and_grads(model, dict(T=1), False)[1]
+        g2 = self.loss_and_grads(model, dict(T=2), False)[1]
+        self.assertFalse(torch.allclose(g1["layers.3.mlp.down_proj.weight"], g2["layers.3.mlp.down_proj.weight"]))
+
+    def test_untied(self):
+        model = tiny_qwen35().eval()
+        body, _ = text_parts(model)
+        ids, am = batch()
+        with torch.no_grad():
+            ref, rec, h0 = record_pass(model, ids, am)
+            tied = manual(model, rec, h0, 2, 5, 2, 1.0)
+        loop = LayerLoop(body, 2, 5, T=2, untied=True)
+        copies = body.loop_untied
+        self.assertIsInstance(copies, torch.nn.ModuleList)
+        self.assertEqual(len(copies), 4)
+        self.assertEqual(len(body_layers(body)), 8)                      # the copies are not decoder layers
+        self.assertEqual(len(decoder_layers(body)), 12)                  # but fsdp.shard_model sees them
+        orig = body_layers(body)[2:6]
+        for c, o in zip(copies, orig):
+            self.assertEqual(type(c), type(o))
+            self.assertEqual(c.block_type, o.block_type)
+            for (nc, pc), (no, po) in zip(c.named_parameters(), o.named_parameters()):
+                self.assertEqual(nc, no)
+                self.assertNotEqual(pc.data_ptr(), po.data_ptr())
+                self.assertTrue(torch.equal(pc, po))
+        self.assertIn("loop_untied.0.mlp.down_proj.weight", dict(body.named_parameters()))
+        with loop, torch.no_grad():
+            out = model(input_ids=ids, attention_mask=am, use_cache=False).logits
+        self.assertLess((out - tied).abs().max().item(), 1e-5)         # copies start equal: the tied output
+        # the copies get gradients only through the extra pass: T = 1 none, T = 2 yes; the originals in both cases
+        model.train()
+        for T, expect in ((1, False), (2, True)):
+            model.zero_grad(set_to_none=True)
+            loop.T = T
+            with loop:
+                z = model(input_ids=ids, attention_mask=am, use_cache=False).logits
+                (z[:, -1].logsumexp(-1).mean() - z[:, -1, 7].mean()).backward()
+            cg = [p.grad for p in copies.parameters()]
+            self.assertEqual(any(g is not None and g.abs().sum() > 0 for g in cg), expect, T)
+            self.assertTrue(any(p.grad is not None and p.grad.abs().sum() > 0 for p in orig[0].parameters()), T)
+        # one optimizer step on the extra pass's parameters alone moves the copies and not the originals
+        before = {n: p.detach().clone() for n, p in body.named_parameters()}
+        opt = torch.optim.SGD(copies.parameters(), lr=0.1)
+        opt.step()
+        after = dict(body.named_parameters())
+        for n in before:
+            moved = not torch.equal(before[n], after[n])
+            self.assertEqual(moved, n.startswith("loop_untied.") and after[n].grad is not None and
+                             bool(after[n].grad.abs().sum() > 0), n)
+        # a second LayerLoop on the same body reuses the copies (no second deep copy)
+        loop2 = LayerLoop(body, 2, 5, T=2, untied=True)
+        self.assertIs(loop2.block[0], copies[0])
+        with self.assertRaises(ValueError):
+            LayerLoop(body, 1, 5, T=2, untied=True)                      # another window: wrong copy count
+        model.eval()
+
+    def test_untied_save_and_reload_as_eval_student(self):
+        """save_pretrained writes loop_untied.*; from_pretrained drops them; LayerLoop(untied) + load_loop_untied
+        restores them: the reloaded looped logits equal the saved model's."""
+        model = tiny_qwen35().eval()
+        body, _ = text_parts(model)
+        ids, am = batch()
+        loop = LayerLoop(body, 2, 5, T=2, untied=True)
+        with torch.no_grad():
+            for p in body.loop_untied.parameters():                      # make the copies differ from the originals
+                p.add_(0.01 * torch.randn_like(p))
+            with loop:
+                want = model(input_ids=ids, attention_mask=am, use_cache=False).logits
+        with tempfile.TemporaryDirectory() as d:
+            model.save_pretrained(d, safe_serialization=True)
+            from safetensors import safe_open
+            with safe_open(d + "/model.safetensors", framework="pt") as fh:
+                keys = [k for k in fh.keys() if "loop_untied." in k]
+            self.assertEqual(len(keys), sum(1 for _ in body.loop_untied.state_dict()))
+            m2 = load_model(d, torch.float32)
+            b2, _ = text_parts(m2)
+            self.assertFalse(hasattr(b2, "loop_untied"))
+            with self.assertRaises(ValueError):                          # copies must exist before the load
+                load_loop_untied(b2, d)
+            loop2 = LayerLoop(b2, 2, 5, T=2, untied=True)
+            n = load_loop_untied(b2, d)
+            self.assertEqual(n, len(keys))
+            for pc, po in zip(b2.loop_untied.parameters(), body.loop_untied.parameters()):
+                self.assertTrue(torch.equal(pc, po))
+            with loop2, torch.no_grad():
+                got = m2(input_ids=ids, attention_mask=am, use_cache=False).logits
+            self.assertTrue(torch.allclose(got, want, atol=1e-6))
+            # a plain checkpoint (no copies) refuses: not a LOOP-UNTIED model
+            m3 = tiny_qwen35()
+            m3.save_pretrained(d + "/plain", safe_serialization=True)
+            b3, _ = text_parts(m3)
+            LayerLoop(b3, 2, 5, T=2, untied=True)
+            with self.assertRaises(ValueError):
+                load_loop_untied(b3, d + "/plain")
+
