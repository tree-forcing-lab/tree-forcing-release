+    def overfit(self, spec, steps=30, lr_heads=1e-2, lr_base=1e-3):
+        """steps of AdamW on the 8 items (heads and base weights in their own groups: the random tiny model's layer-1
+        states differ across items by about 0.5% of their norm, so the heads need the larger rate)."""
+        model, df, table = self.fresh(spec)
+        params = [p for p in model.parameters() if p.requires_grad]
+        if lr_base == 0.0:                                 # heads only (the base frozen)
+            groups = [{"params": [p for p in params if id(p) in {id(q) for q in df.heads.parameters()}], "lr": lr_heads}]
+        else:                                              # the trainer's grouping: param_groups (--df-head-lr)
+            groups = param_groups(params, df.heads, None if lr_heads == lr_base else lr_heads)
+        opt = torch.optim.AdamW(groups, lr=lr_base, weight_decay=0.0)
+        ces, accs = [], []
+        for _ in range(steps):
+            z, aux, st = df.forward(model, self.tok, self.batch, 512, {}, table)
+            ce = kl_loss(z, self.batch)
+            loss = ce + spec.lam * aux
+            opt.zero_grad(set_to_none=True)
+            loss.backward()
+            opt.step()
+            ces.append(ce.detach().item())
+            accs.append({k: c / n for k, (c, n) in st["per_k"].items() if n})
+        with torch.no_grad():
+            z, aux, st = df.forward(model, self.tok, self.batch, 512, {}, table)
+        return ces, accs, {k: c / n for k, (c, n) in st["per_k"].items() if n}, df, model, table
+
+    def test_overfit_probe_reaches_one(self):                              # (5)
+        ces, accs, final, df, model, table = self.overfit(DFSpec((1, 3, 5), lam=0.5, dim=32))
+        self.assertEqual(final, {1: 1.0, 2: 1.0, 3: 1.0}, accs[-3:])
+        self.assertLess(ces[-1], ces[0] * 0.5, (ces[0], ces[-1]))
+        self.assertLess(min(accs[0].values()), 1.0)                        # it started below 1
+        probe = df.probe(model, self.tok, self.items, 512, 4, {})
+        self.assertEqual((probe["layers"], probe["pairs"], probe["acc"]), ([1, 3, 5], [8, 6, 4], [1.0, 1.0, 1.0]))
+        self.assertGreater(probe["cands"], 10)
