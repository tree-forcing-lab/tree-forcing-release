+    def test_decoy_in_every_block(self):
+        """Item 1: every written block has 5 options holding gold, cf(S), cf(S') with distinct canonical values; cf(S')
+        is decoy_for's re-execution with S' = ex.decoy_id."""
+        n = 0
+        for arm, strict in (("fsiit", False), ("ssiit", False), ("sham", False), ("fsiit", True)):
+            for it, ex, info in self.blocks(arm, strict=strict):
+                n += 1
+                opts = parse_options(ex.text.replace("\n\nAnswer:", ""))
+                self.assertEqual(len(opts), N_OPTIONS)
+                self.assertEqual(len({canon_number(o) for o in opts}), N_OPTIONS)
+                self.assertEqual(len({ex.orig_gold, ex.cf_s, ex.decoy}), 3, (arm, ex.item_id))
+                pl = self.table[ex.item_id]
+                self.assertEqual(canon_number(opts[ex.orig_gold]), canon_number(fmt(pl.gold)))
+                b, sb = bound_of(self.table, ex.item_id, ex.k), bound_of(self.table, ex.source_id, ex.k_src)
+                if ex.mode == "single":
+                    j = list(resolve_ends(it, b.ends)[0]).index(ex.nodes[0][0])   # the written node (ends are distinct)
+                    vals = list(b.values)
+                    vals[j] = sb.values[j]
+                    cf = cf_answer(pl.steps, b.k, b.F, tuple(vals))
+
+                    def f(v, j=j):
+                        w = list(b.values)
+                        w[j] = v[j]
+                        return cf_answer(pl.steps, b.k, b.F, tuple(w))
+                else:
+                    cf = cf_answer(pl.steps, b.k, b.F, sb.values)
+
+                    def f(v):
+                        return cf_answer(pl.steps, b.k, b.F, v)
+                self.assertEqual(canon_number(opts[ex.cf_s]), canon_number(fmt(cf)))
+                did, _, dv = decoy_for(self.table, b, f, (pl.gold, cf))
+                self.assertEqual(did, ex.decoy_id)
+                self.assertEqual(canon_number(opts[ex.decoy]), canon_number(fmt(dv)))
+                self.assertTrue(0 <= info["own"] <= 2)
+                if ex.mode in ("full", "single"):
+                    self.assertEqual(ex.cf_gold, ex.cf_s)
+        self.assertGreater(n, 50)
