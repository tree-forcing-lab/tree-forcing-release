+        rate and counted in its dict's "cut"; n + cut is conserved against an uncut readout."""
+        model, fr, spec, table = self.fresh()
+        model.eval()
+        views = self.views(spec, table)
+        def cut_at(ml):                                                     # encode_tail keeps the tail: early
+            return [i for i, v in enumerate(views)                          # node tokens fall outside the sequence
+                    if any(token_at(self.tok, v.text, n[0], ml) is None or token_at(self.tok, v.source_text, n[1], ml) is None
+                           for n in v.nodes)]
+        ml = next(m for m in range(200, 10, -2) if cut_at(m))               # the longest max_len with a cut view
+        exp = cut_at(ml)
+        self.assertTrue(0 < len(exp) <= len(views), (ml, exp))
+        with torch.no_grad():
+            _, st = fr.forward(model, self.tok, views, ml, {})
+        self.assertEqual(st["cut_rows"], exp)
+        self.assertEqual(st["modes"]["full"][3], len(exp))
+        w = B3Window()
+        w.add(st)
+        self.assertEqual(w.row()["b3_full_cut"], len(exp))
+        self.assertEqual(B3Window.per_mode(w.totals)["full"]["cut"], len(exp))
+        self.assertEqual(stats_from_vector(stats_vector(st))["modes"], st["modes"])
+        full = fr.readout(model, self.tok, self.items, [], 512, 4, {})
