+    def test_strict_writes_land_off_node(self):
+        """Item 3 at token level: 'pos' writes land at a question token that is no node token of any boundary of R
+        (slot [0, d)); 'sub' writes touch only [d, 2d) at R's node tokens of the boundary; the partner's frontier
+        values differ from R's; label = the gold."""
+        model, fr, spec, table = self.fresh()
+        model.eval()
+        L, d = spec.layer, spec.dim
+        seen = set()
+        for ep in range(6):
+            for it in self.items:
+                pl = table[it["item_id"]]
+                out = strict_example(it, pl, table, spec, self.by, epoch=ep)
+                if out is None:
+                    continue
+                ex = out[0]
+                seen.add(ex.variant)
+                b, sb = bound_of(table, ex.item_id, ex.k), bound_of(table, ex.source_id, ex.k_src)
+                self.assertNotEqual(b.values, sb.values)
+                self.assertEqual(ex.cf_gold, ex.orig_gold)
+                node_tok = {token_at(self.tok, ex.text, e, 512) for e in node_ends_all(it, pl.steps)}
+                q_end = token_at(self.tok, ex.text, len(it["prompt"].split("\nOptions:")[0]), 512)
+                toks = [token_at(self.tok, ex.text, n[0], 512) for n in ex.nodes]
+                if ex.variant.startswith("pos"):
+                    self.assertTrue(all(n[2] == SLOT_ALIGNED for n in ex.nodes))
+                    self.assertTrue(all(t not in node_tok and 0 <= t <= q_end for t in toks), (toks, node_tok))
+                else:
+                    r_ends, _ = resolve_ends(it, b.ends)
+                    self.assertEqual(toks, [token_at(self.tok, ex.text, e, 512) for e in r_ends])
+                    self.assertTrue(all(n[2] == SLOT_SPARE for n in ex.nodes))
+                # the write: only [0, d) at the pos tokens or [d, 2d) at the node tokens, nothing else
+                fires = []
+                hd = fr.dl[L + 1].register_forward_pre_hook(
+                    lambda m, a, k: fires.append((a[0] if a else k["hidden_states"]).detach().clone()), with_kwargs=True)
+                try:
+                    with torch.no_grad():
+                        _, st = fr.forward(model, self.tok, [ex], 512, {})
+                finally:
+                    hd.remove()
+                self.assertEqual(st["cut"], 0)
+                bb = collate(self.tok, [ex], 512, "cpu")
+                with torch.no_grad(), _Capture(fr.dl, (L,)) as cap0:
+                    text_parts(model)[0](input_ids=bb["input_ids"], attention_mask=bb["attention_mask"], use_cache=False)
+                diff = (fires[-1] != cap0.h[L])[0]
+                lo = 0 if ex.variant.startswith("pos") else d
+                allowed = torch.zeros_like(diff)
+                for t in toks:
+                    allowed[t, lo:lo + d] = True
+                self.assertFalse(bool((diff & ~allowed).any()), ex.variant)
+                self.assertTrue(bool(diff.any()))
+        self.assertEqual(seen, {"pos_num", "sub"})                           # diamonds: a and d are free numbers
