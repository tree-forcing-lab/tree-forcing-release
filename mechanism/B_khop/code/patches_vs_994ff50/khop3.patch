+        self.assertEqual((len(calls), fr.src_forwards), (1, 0))
+        calls.clear()
+        fr.forward(model, self.tok, finals(self.items[:3]), 512, {}, sync=True)   # --fsdp: the dummy source pass
+        self.assertEqual((len(calls), fr.src_forwards, fr.src_dummy), (2, 0, 1))   # the dummy counts apart
+        self.assertEqual(fr.src_seconds, 0.0)
+        calls.clear()
+        fr.forward(model, self.tok, finals(self.items[:1]) + self.views(fr.spec, table)[:2], 512, {})
