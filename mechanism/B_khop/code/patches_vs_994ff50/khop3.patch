+def source_only_view(tok, items, by, table, spec):
+    """A full view of d0 whose source is d6 (written by 'Ann'; every receiver here is 'Tom''s), and the token ids that
+    occur in the source text up to its last written token but in no receiver text: their embedding rows are reached
+    only through the source pass."""
+    v = make_example(items[0], table["d0"], table, spec, by)[0]
+    src = by["d6"]
+    sb = bound_of(table, "d6", v.k)
+    s_ends, _ = resolve_ends(src, sb.ends)
+    v = replace(v, source_id="d6", source_text=FINAL_TEMPLATE.format(problem=src["prompt"]), k_src=v.k,
+                nodes=tuple((r, s_ends[j], SLOT_ALIGNED) for j, (r, _, _) in enumerate(v.nodes)))
+    return v
