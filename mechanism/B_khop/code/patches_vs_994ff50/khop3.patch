+    def test_no_decoy_dropped_and_counted(self):
+        """A boundary whose only same-size candidates give cf(S) again has no S': the view is dropped (plain example
+        stands), counted in no_decoy."""
+        a, b_ = wide("a", 3, 4, 5, 6), wide("b", 2, 9, 3, 7)          # size-2 pool of two items: S' would be S
+        its = [a, b_]
+        spec = B3Spec("fsiit", layer=1, dim=8, seed=4, p=1.0, strict=0.0)
+        t = build_table(its, spec)
+        by = {x["item_id"]: x for x in its}
+        from cotdistill.student import Example
+        b2 = bound_of(t, "a", 2)
+        self.assertEqual(b2.size, 2)
+        sid, sk = t["_partners"]["size"][("a", 2)]
+        self.assertEqual(sid, "b")
+        cf = cf_answer(t["a"].steps, 2, b2.F, bound_of(t, sid, sk).values)
+        self.assertIsNone(decoy_for(t, b2, lambda v: cf_answer(t["a"].steps, 2, b2.F, v), (t["a"].gold, cf)))
+        counts: dict = {}
+        epochs = 0
+        for ep in range(40):                           # until the k = 2 boundary has been drawn a few times
+            fin = [Example("x", list(LETTERS), [1.0] + [0.0] * 4, 1.0, "final", "a")]
+            out = substitute(fin, a, t["a"], t, spec, by, ep, counts)
+            epochs += 1
+            if isinstance(out[-1], B3Example):
+                self.assertNotEqual(out[-1].k, 2)              # never a view on the boundary without S'
+            if counts.get("no_decoy", 0) >= 3:
+                break
+        self.assertGreaterEqual(counts.get("no_decoy", 0), 3, counts)
+        self.assertEqual(counts["no_view"], counts["plain"])    # dropped -> the plain example stands
+        self.assertEqual(counts["no_view"] + counts.get("full", 0), epochs)
