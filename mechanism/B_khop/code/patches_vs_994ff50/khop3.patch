+
+def gpt2_tok():
+    tok = transformers.AutoTokenizer.from_pretrained("gpt2", local_files_only=True)
+    tok.pad_token = tok.eos_token
+    return tok
+
+
+def tiny_qwen35(vocab: int, seed: int = 0):
+    """A random Qwen3.5 text model: hidden 64, 8 layers, full attention at 3 and 7 (as Qwen3.5-4B's 3, 7, ...)."""
+    cfg = transformers.Qwen3_5TextConfig(vocab_size=vocab, hidden_size=64, intermediate_size=128, num_hidden_layers=8,
+                                         num_attention_heads=4, num_key_value_heads=2, head_dim=16,
+                                         layer_types=list(LAYER_TYPES), linear_num_value_heads=4, linear_num_key_heads=2,
+                                         linear_key_head_dim=16, linear_value_head_dim=16, linear_conv_kernel_dim=4,
+                                         max_position_embeddings=512, tie_word_embeddings=True)
+    torch.manual_seed(seed)
+    return transformers.Qwen3_5ForCausalLM(cfg)
+
+
+def df_item(j: int, n_steps: int, base: int = 0, with_steps: bool = True) -> dict:
+    """A GSM8K-like item: a chain of n_steps arithmetic steps whose values are base + 1, base + 2, ... (so the items'
+    value sets are disjoint when base differs by >= 100), option A gold = the last value, other options other numbers."""
+    vals = [base + k for k in range(1, n_steps + 1)]
+    ops = [10 * k + j + 1 for k in range(1, n_steps + 1)]           # step k's operand a, listed in the question
+    steps = [{"step": k, "a": str(o), "b": "1", "value": str(v), "text": f"{o} + 1 = {v}"}
+             for k, (o, v) in enumerate(zip(ops, vals), 1)]
+    a, b = 7 + j, 3 + j
+    gold = vals[-1]
+    opts = [str(gold), str(gold + 11), str(gold + 23), f"{gold + 5}.0", str(gold - 2)]
+    prompt = (f"Ann has {a} apples and buys {b} more, pays 1,000 coins and 12.5 kg of pears. Her notes list "
+              + ", ".join(str(o) for o in ops) + f" units. After {n_steps} steps, "
+              f"how many does she have?\nOptions:\n" + "\n".join(f"{L}) {o}" for L, o in zip("ABCDE", opts)))
+    it = {"item_id": f"d{j}", "prompt": prompt, "labels": list("ABCDE"), "gold_label": "A", "options": opts,
+          "teacher": {"A": 1.0, "B": 0.0, "C": 0.0, "D": 0.0, "E": 0.0}, "n_steps": n_steps}
+    if with_steps:
+        it["worked_steps"] = steps
+    return it
+
+
+def items8() -> list[dict]:
+    """8 items with 1..4 steps (two of each) and disjoint value sets, plus none without steps."""
+    return [df_item(j, 1 + j % 4, base=100 * (j + 1)) for j in range(8)]
+
+
+def finals(items: list[dict]) -> list[Example]:
+    from cotdistill.student import FINAL_TEMPLATE
+    return [Example(FINAL_TEMPLATE.format(problem=it["prompt"]), it["labels"],
+                    [it["teacher"][L] for L in it["labels"]], 1.0, "final", it["item_id"]) for it in items]
+
