+            out = self.model(input_ids=self.ids, attention_mask=self.am, use_cache=False).logits
+        self.assertTrue(torch.equal(out, self.ref))      # nothing left behind
+        loop.install()                                  # re-installable after remove
+        self.assertTrue(loop.installed)
