+"""Frontier interchange (src/cotdistill/frontier.py; card B3): the data layer. CPU, no model: the program reader and
+executor, boundaries and frontiers, counterfactual answers, node positions, partner tables, option blocks, the per-epoch
+draws of every arm, CF-AUG substitution; and, with data/ present, the first 300 real items (program re-execution
+reproduces the gold, the excluded items are the 7 mismatches)."""
+import json
+import random
+import sys
+import unittest
+from fractions import Fraction
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+
+from cotdistill.frontier import (B3Example, B3Spec, Boundary, LETTERS, N_OPTIONS, SLOT_ALIGNED, SLOT_SPARE,  # noqa: E402
+                                 ancestors, bound_of, boundaries, build_table, cf_answer, clean, decoy_for, execute,
+                                 fmt, free_ends, free_number_ends, frontier, literals, make_example, node_end,
+                                 node_ends_all,
+                                 non_operand_end, num, option_block, parse_options, partners, program, program_ok,
+                                 render_options, resolve_ends, signature, strict_example, substitute,
+                                 substitute_literals, validate_spec, wiring)
