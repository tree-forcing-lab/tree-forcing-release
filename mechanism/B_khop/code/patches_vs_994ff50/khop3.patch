+        self.assertIn("among 9", substitute_literals("Tom had 5 apples, 5 pears among 5 kids.\nOptions:\nA) 5", {"5": "9"}))
+        self.assertTrue(p.endswith(DIAMOND["prompt"].split("\nOptions:", 1)[1]))      # the Options block kept
+        self.assertIsNone(substitute_literals(DIAMOND["prompt"], {"77": "1"}))         # a literal not in the question
