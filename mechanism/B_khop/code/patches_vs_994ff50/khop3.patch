+@unittest.skipUnless(HAVE, "needs torch + transformers")
+class TestRotationFSDPWorld1(unittest.TestCase):
+    """The cluster path on the CPU: FSDP2 (gloo, world 1), Q outside the sharded model, ShardedOptim cpu-adamw with Q's
+    on_device group: gradient inside Readout.run, Q's own clip, the scheduler, the step, zero_grad."""
+
+    @classmethod
+    def setUpClass(cls):
+        try:
+            cls.tok = gpt2_tok()
+        except Exception as e:
+            raise unittest.SkipTest(f"no local gpt2 tokenizer: {e}")
+        import torch.distributed as dist
+        if dist.is_initialized():
+            raise unittest.SkipTest("a process group is already up")
+        os.environ.update(RANK="0", WORLD_SIZE="1", LOCAL_RANK="0", MASTER_ADDR="127.0.0.1",
+                          MASTER_PORT=str(29700 + os.getpid() % 200))
+        from cotdistill import fsdp as fsdp_lib
+        cls.fs = fsdp_lib.init(timeout_min=2.0)
+        cls.items = items8()
+        cls.by = {it["item_id"]: it for it in cls.items}
+
+    @classmethod
+    def tearDownClass(cls):
+        import torch.distributed as dist
+        if dist.is_initialized():
+            dist.destroy_process_group()
+
+    def test_q_in_its_own_group(self):
+        from cotdistill import fsdp as fsdp_lib
+        from cotdistill.fsdp import ShardCPUAdamW, ShardedOptim, _local
+        spec = B3Spec("fsiit", layer=2, dim=8, seed=1, rotate=True, rotate_lr=1e-2)
+        model = tiny_qwen35(len(self.tok))
+        model.config.use_cache = False
+        model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
+        fr = Frontier(model, spec)
+        root = fsdp_lib.shard_model(model, self.fs.mesh)
+        fr.place(self.fs.device)
+        root.train()
+        params = [p for p in root.parameters() if p.requires_grad]
+        rot = fr.rot_params()
+        self.assertFalse({id(p) for p in rot} & {id(p) for p in params})     # Q is not an FSDP parameter
+        self.assertFalse(any(hasattr(p, "to_local") for p in rot))
+        tr = ShardedOptim(params, "cpu-adamw", 1e-3, self.fs.device, groups=rotation_groups(params, rot, 1e-2))
+        self.assertEqual([id(p) for p in tr.extra], [id(p) for p in rot])
+        self.assertIsNotNone(tr.opt.dev_opt)
+        self.assertEqual(len(tr.opt.master), len(params))                   # no CPU master for Q
+        sched = torch.optim.lr_scheduler.LambdaLR(tr.opt, lambda s: 0.5)
+        self.assertEqual([g["lr"] for g in tr.opt.param_groups], [5e-4, 5e-3])   # same shape, own rate
+        table = build_table(self.items, spec)
+        views = [make_example(it, table[it["item_id"]], table, spec, self.by)[0] for it in self.items[:4]]
+        batch = finals(self.items[4:6]) + views
+        z, st = fr.call(root, self.tok, batch, 512, {})
+        self.assertEqual(st["modes"]["full"][0], 4)
+        kl_loss(z, batch).backward()
+        self.assertTrue(all(p.grad is not None for p in params))
+        self.assertGreater(float(rot[0].grad.abs().sum()), 0.0)              # Q's gradient through the root's forward
+        q_before = fr.rot.weight.detach().clone()
+        before = {id(p): _local(p).detach().clone() for p in params}
+        torch.nn.utils.clip_grad_norm_(rot, 1.0)                             # the trainer's rot_clip
+        tr.clip_grad_norm_(1.0)
+        tr.step()
+        tr.zero_grad()
+        self.assertIsNone(rot[0].grad)                                       # zeroed with the model
+        moved = max((_local(p).detach() - before[id(p)]).abs().max().item() for p in params)
+        self.assertGreater(moved, 1e-5)
+        Q = fr.rot.weight.detach()
+        self.assertGreater(float((Q - q_before).abs().max()), 1e-4)          # Q stepped (fp32, on its device)
+        self.assertLess(float((Q @ Q.T - torch.eye(16)).abs().max()), 1e-5)
+        self.assertEqual(tr.opt.dev_opt.param_groups[0]["lr"], 5e-3)         # synced from the scheduled outer group
+        sched.step()
+        tr.reset_state()
+        self.assertEqual(len(tr.opt.dev_opt.state), 0)
+        tr.release()
+        # why Q needs its own group: in a plain group ShardCPUAdamW refuses an fp32 tensor next to bf16 shards
+        with self.assertRaises(ValueError):
+            ShardCPUAdamW([torch.nn.Parameter(torch.zeros(4, dtype=torch.bfloat16)), torch.nn.Parameter(torch.zeros(4))])
+
