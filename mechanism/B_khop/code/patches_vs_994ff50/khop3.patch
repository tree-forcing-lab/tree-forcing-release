+@unittest.skipUnless(HAVE, "needs torch + transformers")
+class TestFSDPWorld1(unittest.TestCase):
+    """The cluster path on the CPU: FSDP2 (gloo, world 1) around the tiny model with the heads built before sharding,
+    non-reentrant gradient checkpointing, the forward through Readout.run (df.call), fsdp_update's loss, ShardedOptim
+    cpu-adamw with the head group, LambdaLR. Checks that the heads' sharded parameters receive non-zero gradients, that
+    the captures equal the unsharded model's layer outputs, that one step moves the heads by about their own lr and
+    the base by about its lr, that the scheduler scales both groups alike, and that 30 updates at base lr 1e-6 /
+    head lr 1e-2 bring the probe to 1.0 at operand positions (bf16 weights, as --precision bf16)."""
+
+    @classmethod
+    def setUpClass(cls):
+        try:
+            cls.tok = gpt2_tok()
+        except Exception as e:
+            raise unittest.SkipTest(f"no local gpt2 tokenizer: {e}")
+        import torch.distributed as dist
+        if dist.is_initialized():
+            raise unittest.SkipTest("a process group is already up")
+        os.environ.update(RANK="0", WORLD_SIZE="1", LOCAL_RANK="0", MASTER_ADDR="127.0.0.1",
+                          MASTER_PORT=str(29600 + os.getpid() % 300))
+        from cotdistill import fsdp as fsdp_lib
+        cls.fs = fsdp_lib.init(timeout_min=2.0)
+        cls.items = items8()
+        cls.batch = finals(cls.items)
+
+    @classmethod
+    def tearDownClass(cls):
+        import torch.distributed as dist
+        if dist.is_initialized():
+            dist.destroy_process_group()
+
+    def build(self, spec, dtype=torch.float32, ckpt=True):
+        from cotdistill import fsdp as fsdp_lib
+        model = tiny_qwen35(len(self.tok)).to(dtype)
+        model.config.use_cache = False
+        if ckpt:
+            model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
+        df = DepthForcing(model, spec)                         # before sharding, as the trainer does
+        root = fsdp_lib.shard_model(model, self.fs.mesh)
+        root.train()
+        return model, df, root, build_table(self.items, spec)
+
+    def test_heads_get_gradients_and_move_at_their_lr(self):
+        from cotdistill.fsdp import ShardedOptim, _local
+        spec = DFSpec((1, 3, 5), lam=0.5, dim=32, pos="operand")
+        model, df, root, table = self.build(spec)
+        params = [p for p in root.parameters() if p.requires_grad]
+        head_ids = {id(p) for p in df.heads.parameters()}
+        self.assertEqual(len([p for p in params if id(p) in head_ids]), 4)       # the sharded heads are in params
+        self.assertTrue(all(hasattr(p, "to_local") for p in params))            # DTensors (sharded)
+        groups = param_groups(params, df.heads, 1e-2)
+        tr = ShardedOptim(params, "cpu-adamw", 1e-6, self.fs.device, groups=groups)
+        self.assertEqual([g["lr"] for g in tr.opt.param_groups], [1e-6, 1e-2])
+        # the captures inside the FSDP root forward equal the plain (unsharded-copy) model's layer outputs
+        plain = tiny_qwen35(len(self.tok))
+        plain.load_state_dict({k: _local(v) for k, v in model.state_dict().items()}, strict=False)
+        from cotdistill.student import collate
+        b = collate(self.tok, self.batch, 512, "cpu")
+        with torch.no_grad(), _Capture(body_layers(text_parts(plain)[0]), spec.layers) as cap_ref:
+            text_parts(plain)[0](input_ids=b["input_ids"], attention_mask=b["attention_mask"], use_cache=False)
+        seen = {}
+
+        def record(li):                                          # the states the FSDP forward hands to layer li + 1
+            def pre(mod, args, kwargs):
+                seen.setdefault(li, (args[0] if args else kwargs["hidden_states"]).detach().clone())
+            return pre
+        hooks = [df.dl[li + 1].register_forward_pre_hook(record(li), with_kwargs=True) for li in spec.layers]
+        z, aux, st = df.call(root, self.tok, self.batch, 512, {}, table)
+        for h in hooks:
+            h.remove()
+        for li in spec.layers:
+            self.assertTrue(torch.allclose(seen[li], cap_ref.h[li], atol=1e-5), li)
+        self.assertEqual(st["n"], 8 + 6 + 4)
+        loss = (kl_loss(z, self.batch) * len(self.batch) + 0.5 * aux * len(self.batch)) / len(self.batch)   # fsdp_update
+        loss.backward()
+        for p in params:
+            self.assertIsNotNone(p.grad)
+        hg = [p for p in params if id(p) in head_ids]
+        self.assertTrue(all(_local(p.grad).abs().sum() > 0 for p in hg))      # non-zero head gradients
+        before = {id(p): _local(p).detach().clone() for p in params}
+        tr.clip_grad_norm_(1.0)
+        tr.step()
+        tr.zero_grad()
+        moved_h = max((_local(p).detach() - before[id(p)]).abs().max().item() for p in hg)
+        moved_b = max((_local(p).detach() - before[id(p)]).abs().max().item() for p in params if id(p) not in head_ids)
+        self.assertGreater(moved_h, 3e-3)                                        # about lr 1e-2 (Adam's first step)
+        self.assertLess(moved_b, 3e-6)                                           # about lr 1e-6
+        import math
+        sched = torch.optim.lr_scheduler.LambdaLR(tr.opt, lambda s, w=3, t=30: min(1.0, (s + 1) / w) * 0.5 * (
+            1 + math.cos(math.pi * min(1.0, s / t))))
+        for _ in range(5):
+            sched.step()
+        lrs = [g["lr"] for g in tr.opt.param_groups]
+        self.assertAlmostEqual(lrs[1] / lrs[0], 1e4, places=6)
+        tr.release()
+
+    def test_bf16_training_reaches_probe_one(self):
+        """bf16 weights (--precision bf16) + cpu-adamw fp32 masters: 30 updates, base lr 1e-6, head lr 1e-2, operand
+        positions -> probe 1.0 at every layer; the same at head lr 1e-6 stays at chance."""
+        from cotdistill.fsdp import ShardedOptim
+
+        def run(head_lr):
+            spec = DFSpec((1, 3, 5), lam=0.5, dim=32, pos="operand")
+            model, df, root, table = self.build(spec, dtype=torch.bfloat16)
+            params = [p for p in root.parameters() if p.requires_grad]
+            tr = ShardedOptim(params, "cpu-adamw", 1e-6, self.fs.device, groups=param_groups(params, df.heads, head_lr))
+            auxs = []
+            for _ in range(30):
+                z, aux, st = df.call(root, self.tok, self.batch, 512, {}, table)
+                loss = (kl_loss(z, self.batch) * len(self.batch) + 0.5 * aux * len(self.batch)) / len(self.batch)
+                loss.backward()
+                tr.clip_grad_norm_(1.0)
+                tr.step()
+                tr.zero_grad()
+                auxs.append(st["aux"])
+            with torch.no_grad():
+                z, aux, st = df.call(root, self.tok, self.batch, 512, {}, table)
+            tr.release()
+            return {k: c / n for k, (c, n) in st["per_k"].items() if n}, auxs
+        acc, auxs = run(1e-2)
+        self.assertGreaterEqual(sum(acc.values()) / 3, 0.9, (acc, auxs[::10]))   # bf16 states: 1.0, 1.0 and >= 7/8
+        self.assertEqual((acc[2], acc[3]), (1.0, 1.0), acc)
+        self.assertLess(auxs[-1], 0.5, auxs[::10])
+        acc0, auxs0 = run(None)
+        self.assertLess(max(acc0.values()), 0.5, acc0)
+        self.assertGreater(auxs0[-1], 3.5, auxs0[::10])
+
+
+if __name__ == "__main__":
+    unittest.main()
