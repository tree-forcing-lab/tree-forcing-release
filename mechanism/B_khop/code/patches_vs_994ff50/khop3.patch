+def diamond(j: int, a: int, b: int, c: int, d: int, who: str = "Tom") -> dict:
+    """The 4-step diamond program with literals a, b, c, d: s0 = a - b, s1 = s0 x c, s2 = s1 + s0, s3 = s2 / d."""
+    s0, s1 = a - b, (a - b) * c
+    s2 = s1 + s0
+    s3 = Fraction(s2, d)
+    assert s3.denominator == 1, (a, b, c, d)
+    prompt = (f"{who} had {a} apples and lost {b}. {who} multiplied what was left by {c}, added what was left before "
+              f"multiplying and shared the total among {d} friends. How many each?")
+    steps = [step(0, "−", a, b, s0), step(1, "×", s0, c, s1, a_from=0),
+             step(2, "+", s1, s0, s2, a_from=1, b_from=0), step(3, "÷", s2, d, int(s3), a_from=2)]
+    gold = int(s3)
+    return item(f"d{j}", prompt, steps, [str(gold), str(gold + 11), str(gold + 23), str(gold + 5), str(gold + 2)])
+
+
+def items8() -> list:
+    """8 receivers: distinct literals (so every frontier value differs), the last two identical in program (a match
+    pair: d6 and d7 share a, b, c, d with different names)."""
+    base = [(5, 2, 4, 3), (9, 3, 2, 3), (7, 1, 3, 4), (12, 4, 5, 6), (8, 2, 7, 4), (10, 4, 3, 8)]
+    its = [diamond(j, *t) for j, t in enumerate(base)]
+    its.append(diamond(6, 6, 2, 5, 4, "Ann"))
+    its.append(diamond(7, 6, 2, 5, 4, "Bob"))
+    return its
+
+
+def finals(items: list) -> list:
+    return [Example(FINAL_TEMPLATE.format(problem=it["prompt"]), it["labels"], [it["teacher"][L] for L in it["labels"]],
+                    1.0, "final", it["item_id"]) for it in items]
+
+
+@unittest.skipUnless(HAVE, "needs torch + transformers")
+class TestForward(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        try:
+            cls.tok = gpt2_tok()
+        except Exception as e:
+            raise unittest.SkipTest(f"no local gpt2 tokenizer: {e}")
+        cls.items = items8()
+        cls.by = {it["item_id"]: it for it in cls.items}
