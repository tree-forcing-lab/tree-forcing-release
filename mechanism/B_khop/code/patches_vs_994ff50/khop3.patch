+    from cotdistill.depth_forcing import (DF_HEADS_FILE, DF_SIDECAR, DIGITS_OUT, DFSpec, DFWindow, DepthForcing,
+                                          _Capture, build_table, canon_number, df_partners, digit_code,
+                                          load_df_heads, no_operand_counts, operand_end, option_values,
+                                          param_groups, parse_df_layers, prompt_numbers, supervised_counts, token_at)
+    from cotdistill.student import Example, body_layers, kl_loss, label_logits, text_parts
+    HAVE = True
+except ImportError:
+    HAVE = False
