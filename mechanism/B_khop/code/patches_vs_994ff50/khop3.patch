+    def test_checkpointing_equal(self):                                     # the hook under both checkpoint modes
+        def run(ckpt):
+            model, fr, spec, table = self.fresh()
+            if ckpt is not None:
+                model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": ckpt})
+                if ckpt:
+                    model.enable_input_require_grads()
+            batch = finals(self.items[:2]) + self.views(spec, table)[:4]
+            z, st = fr.forward(model, self.tok, batch, 512, {})
+            loss = kl_loss(z, batch)
+            model.zero_grad(set_to_none=True)
+            loss.backward()
+            g = {n: p.grad.detach().clone() for n, p in model.named_parameters() if p.grad is not None}
+            if ckpt is not None:                                            # the flag was restored
+                self.assertTrue(all(lay.gradient_checkpointing for lay in fr.dl))
+            return loss.detach(), g
+        off, non_re, re = run(None), run(False), run(True)
+        for name, (loss, g) in (("non-reentrant", non_re), ("reentrant", re)):
+            self.assertLess(abs(float(loss) - float(off[0])), 1e-5, name)
+            self.assertEqual(set(g), set(off[1]), name)
+            for n in off[1]:
+                self.assertTrue(torch.allclose(off[1][n], g[n], atol=1e-5, rtol=1e-4), (name, n))
+
+    def test_gradient_paths(self):
+        """The receiver's layers <= L and > L get gradient; the source pass is detached by default (its activations are
+        not in the graph) and in the graph with source_grad."""
+        model, fr, spec, table = self.fresh()
+        views = self.views(spec, table)[:4]
+        z, st = fr.forward(model, self.tok, views, 512, {})
+        model.zero_grad(set_to_none=True)
+        kl_loss(z, views).backward()
+        g = {n for n, p in model.named_parameters() if p.grad is not None and p.grad.abs().sum() > 0}
+        self.assertTrue(any(n.startswith("model.layers.0.") for n in g))
+        self.assertTrue(any(n.startswith("model.layers.6.") for n in g))
+        # with the source gradient on, the written slices carry grad_fn
+        spec_g = B3Spec("fsiit", layer=2, dim=8, seed=1, source_grad=True)
+        model2, fr2, _, table2 = self.fresh(spec_g)
+        src_grad = []
+        orig = _SliceWrite.__enter__
+
+        def spy(self_):
+            src_grad.extend(v.requires_grad for *_, v in self_.writes)
+            return orig(self_)
+        _SliceWrite.__enter__ = spy
+        try:
+            fr2.forward(model2, self.tok, views, 512, {})
+            with_grad = list(src_grad)
+            src_grad.clear()
+            fr.forward(model, self.tok, views, 512, {})
+            without = list(src_grad)
+        finally:
+            _SliceWrite.__enter__ = orig
+        self.assertTrue(with_grad and all(with_grad))
+        self.assertTrue(without and not any(without))
+
+    def test_loss_assembly_and_pads(self):
+        """kl_loss over a mixed micro-batch = plain CE on plain examples + the views' CE toward their labels (cf for full,
+        gold for strict, distractor for sham), weighted; a pad (weight 0) adds nothing; the stats count every non-pad
+        view; the stats vector round-trips."""
+        import dataclasses
+        model, fr, spec, table = self.fresh()
+        views = self.views(spec, table)[:3]
+        sham_spec = B3Spec("sham", layer=2, dim=8, seed=1)
+        sham = make_example(self.items[3], table["d3"], table, sham_spec, self.by)[0]
+        strict = strict_example(self.items[6], table["d6"], table, spec, self.by)[0]
+        pad = dataclasses.replace(views[0], weight=0.0)
+        batch = finals(self.items[:1]) + views + [sham, strict, pad]
+        z, st = fr.forward(model, self.tok, batch, 512, {})
+        loss = kl_loss(z, batch)
+        manual = 0.0
+        for zi, e in zip(z, batch):
+            manual = manual + e.weight * -(torch.tensor(e.target) * torch.log_softmax(zi, -1)).sum()
+        self.assertLess(abs(float(loss) - float(manual / len(batch))), 1e-6)
+        self.assertEqual(sham.target[sham.cf_gold], 1.0)
+        self.assertNotEqual(sham.cf_gold, sham.orig_gold)
+        self.assertEqual(strict.target[strict.orig_gold], 1.0)
+        self.assertEqual({m: v[0] for m, v in st["modes"].items()},
+                         {"full": 3, "single": 0, "strict": 1, "sham": 1, "cfaug": 0, "plain": 1, "blockplain": 0})
+        self.assertEqual(stats_from_vector(stats_vector(st)), st)
+        self.assertEqual(len(stats_vector(st)), STAT_LEN)
+        w = B3Window()
+        w.add(st)
+        r = w.row()
+        self.assertEqual((r["b3_full_n"], r["b3_strict_n"], r["b3_sham_n"]), (3, 1, 1))
+        self.assertNotIn("b3_single_n", r)
+        self.assertEqual(r["b3_plain_n"], 1)
+        self.assertEqual(w.row(), {"b3_cut": 0, "b3_src_fwd": 0})
+        self.assertEqual(w.totals["modes"]["full"][0], 3)
+        # a micro-batch without any view: no source pass (outside --fsdp), only the plain column counts
+        z0, st0 = fr.forward(model, self.tok, finals(self.items[:2]), 512, {})
+        self.assertEqual((st0["n_src"], st0["modes"]["plain"][0], sum(v[0] for v in st0["modes"].values())), (0, 2, 2))
+
+    def test_substitute(self):
+        spec = B3Spec("fsiit", layer=2, dim=8, seed=1, p=1.0, strict_share=1.0)
+        table = build_table(self.items, spec)
+        counts: dict = {}
+        out = []
+        for it in self.items:
+            out += substitute(finals([it]), it, table.get(it["item_id"]), table, spec, self.by, 0, counts)
+        self.assertEqual(len(out), len(self.items))                        # substitution, not addition
+        strict = [e for e in out if isinstance(e, B3Example) and e.mode == "strict"]
+        self.assertEqual(counts.get("strict", 0), len(strict))              # strict share 1.0: strict wherever it exists
+        self.assertEqual(counts.get("strict", 0) + counts.get("strict_fallback", 0), len(self.items))
+        self.assertEqual(counts.get("full", 0) + counts.get("no_view", 0), counts.get("strict_fallback", 0))
+        self.assertEqual(sum(counts.get(f"strict_{v}", 0) for v in ("pos_num", "pos_other", "sub")), counts["strict"])
+        self.assertGreaterEqual(counts["strict"], 6)
+        # share 0.5 over many epochs: about half of the intervened views are strict
+        spec5 = B3Spec("fsiit", layer=2, dim=8, seed=1, p=1.0, strict_share=0.5)
+        c5: dict = {}
+        for ep in range(40):
