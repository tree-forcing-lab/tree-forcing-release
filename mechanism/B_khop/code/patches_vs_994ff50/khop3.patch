+    def test_operand_positions_train(self):                                # (c)
+        spec = DFSpec((1, 3, 5), lam=0.5, dim=32, pos="operand")
+        ces, accs, final, df, model, table = self.overfit(spec)
+        self.assertEqual(final, {1: 1.0, 2: 1.0, 3: 1.0}, accs[-3:])
+        self.assertLess(ces[-1], ces[0] * 0.5, (ces[0], ces[-1]))
+        probe = df.probe(model, self.tok, self.items, 512, 4, {})
+        self.assertEqual((probe["pos"], probe["pairs"], probe["acc"]), ("operand", [8, 6, 4], [1.0, 1.0, 1.0]))
+        # the read positions are the operands' tokens, not the answer cue: every item's positions differ from last
+        from cotdistill.student import collate
+        b = collate(self.tok, self.batch, 512, "cpu")
+        for i, e in enumerate(self.batch):
+            for end in table[e.item_id].ends:
+                self.assertLess(token_at(self.tok, e.text, end, 512), int(b["last"][i]))
+        # the shuffled control at operand positions: the item's own positions, the partner's values
+        sx = DFSpec((1, 3, 5), lam=0.5, dim=32, pos="operand", shuffle=True)
+        tx = build_table(self.items, sx)
+        self.assertEqual({k: v.ends for k, v in tx.items()}, {k: v.ends for k, v in table.items()})
+        self.assertTrue(all(a != b for d in tx.values() for a, b in zip(d.targets, d.values)))
