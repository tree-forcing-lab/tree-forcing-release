+    def test_lambda0_base_gradients_equal_A2(self):                        # (2)
+        model, df, table = self.fresh()
+        plain = copy.deepcopy(model)
+        del text_parts(plain)[0].df_heads
+        z = label_logits(plain, self.tok, self.batch, 512, {})
+        g_a2 = self.grads(plain, kl_loss(z, self.batch) * len(self.batch) / len(self.batch))
+        z, aux, st = df.forward(model, self.tok, self.batch, 512, {}, table)
+        lam = 0.0
+        total = kl_loss(z, self.batch) * len(self.batch)
+        total = total + (lam * aux if lam else 0.0) * len(self.batch)      # as train_student's df_term at lambda 0
+        g_df = self.grads(model, total / len(self.batch))
+        base = {n for n in g_df if "df_heads" not in n}
+        self.assertEqual(base, set(g_a2))
+        for n in base:
+            self.assertTrue(torch.equal(g_a2[n], g_df[n]), n)
+        self.assertFalse(any("df_heads" in n for n in g_df))               # no head gradient at lambda 0
