+    def test_aux_gradient_reaches_only_earlier_layers(self):
+        """The head-k loss alone moves layers <= L_k and the heads, not layers past L_K (= 5) or the output rows."""
+        model, df, table = self.fresh()
+        z, aux, st = df.forward(model, self.tok, self.batch, 512, {}, table)
+        g = self.grads(model, aux)
+        self.assertTrue(all(g[f"model.layers.{li}.mlp.down_proj.weight"].abs().sum() > 0 for li in range(6)))
+        self.assertTrue(all(f"model.layers.{li}.mlp.down_proj.weight" not in g for li in (6, 7)))
+        self.assertNotIn("model.norm.weight", g)
