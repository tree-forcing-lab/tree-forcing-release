+                self.assertEqual((a["order"], b["order"]), ("fwd", "rev"))
+        for r in self.f["train_kh"]:
+            o = r["group"].split("/")[2]
+            self.assertEqual(B.fwd_is_topological(r["prompt"]), o == "fwd", r["item_id"])
