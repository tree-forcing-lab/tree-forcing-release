+                self.assertIn(r["gold_label"], r["labels"])
+                self.assertEqual(r["teacher"], {L: float(L == r["gold_label"]) for L in B.LETTERS})
+                self.assertEqual(r["option_kinds"][B.LETTERS.index(r["gold_label"])], "gold")
