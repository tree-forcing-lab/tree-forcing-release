--- repo.base/scripts/build_khop4.py	1969-12-31 18:00:00
+++ repo/scripts/build_khop4.py	2026-10-27 21:33:47
@@ -0,0 +1,175 @@
+"""Training directories of CARD_khop_v4 (family khop4, parent khop3): byte copies of the khop3 stage-1 directories under
+the khop4 names, so that jobs/build_bundles.sh (it copies data/student_${v#x1}_*) puts them in the x1khop4 bundle, and
+data/eval/khop4/build_report.json. No row is drawn, edited or reordered (card 1.2).
+
+    python3 scripts/build_khop4.py --khop3-root <E>/src/data --out-root <E>/src/data --report <E>/src/data/eval/khop4
+
+Inputs (all under --khop3-root, the data root of the khop3 build):
+- student_khop3_c27/{train,val}.jsonl and student_khop3_k1x/{train,val}.jsonl: md5s must equal
+  eval/khop3/build_report.json "md5" and the card values (c27 train 92545dd4..., k1x train d7cc9716..., both val
+  9f55fec5...), row counts 27,000 / 393;
+- eval/khop/train_kh.jsonl (a16b1520...) and eval/khop/train_k1.jsonl (4bb15f66...), 3,000 rows each, equal to
+  eval/khop/build_report.json "md5".
+Any other value is a SystemExit before anything is written. --out-root, --report or an output directory that equals an
+input directory (resolved paths) is a SystemExit; an output directory that holds a file other than its outputs is a
+SystemExit.
+Outputs: <out-root>/student_khop4_c27/{train,val}.jsonl, <out-root>/student_khop4_k1x/{train,val}.jsonl (byte copies),
+<report>/build_report.json: card, generator, md5 and row counts of the 4 outputs and the 6 inputs, the two replay
+equalities (train_kh = rows 0..2,999 of the c27 train file byte for byte; train_k1 = rows 0..2,999 of the k1x train file
+byte for byte), the output file sets, inputs unchanged (md5 before = after), d_fail (every failed line) and d_pass.
+main() exits 2 on a failed line.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+from pathlib import Path
+
+CARD = "CARD_khop_v4"
+SRC = {"c27": "student_khop3_c27", "k1x": "student_khop3_k1x"}
+DST = {"c27": "student_khop4_c27", "k1x": "student_khop4_k1x"}
+FILES = ("train.jsonl", "val.jsonl")
+CARD_MD5 = {"student_khop3_c27/train.jsonl": "92545dd42ca451c39e0e7c104aa78d1e",
+            "student_khop3_c27/val.jsonl": "9f55fec541246e41401a7b5fa6c5510a",
+            "student_khop3_k1x/train.jsonl": "d7cc9716e5785461d16ec92156104261",
+            "student_khop3_k1x/val.jsonl": "9f55fec541246e41401a7b5fa6c5510a",
+            "eval/khop/train_kh.jsonl": "a16b1520f0fb8b24ffd8fa57ef696de0",
+            "eval/khop/train_k1.jsonl": "4bb15f66c8d8843013eb0410c6a87e48"}
+CARD_ROWS = {"student_khop3_c27/train.jsonl": 27000, "student_khop3_c27/val.jsonl": 393,
+             "student_khop3_k1x/train.jsonl": 27000, "student_khop3_k1x/val.jsonl": 393,
+             "eval/khop/train_kh.jsonl": 3000, "eval/khop/train_k1.jsonl": 3000}
+REPLAY = {"train_kh": ("eval/khop/train_kh.jsonl", "student_khop3_c27/train.jsonl"),
+          "train_k1": ("eval/khop/train_k1.jsonl", "student_khop3_k1x/train.jsonl")}
+N_REPLAY = 3000
+
+
+def md5(p: Path) -> str:
+    return hashlib.md5(p.read_bytes()).hexdigest()
+
+
+def rows(p: Path) -> int:
+    """Lines of a jsonl file (each line ends with a newline; a last line without one is a SystemExit)."""
+    b = p.read_bytes()
+    if b and not b.endswith(b"\n"):
+        raise SystemExit(f"build_khop4: {p} does not end with a newline")
+    return b.count(b"\n")
+
+
+def head_bytes(p: Path, n: int) -> bytes:
+    """The first n lines of p, bytes as on disk."""
+    out = []
+    with open(p, "rb") as f:
+        for _ in range(n):
+            line = f.readline()
+            if not line:
+                break
+            out.append(line)
+    return b"".join(out)
+
+
+def check_inputs(root: Path) -> dict:
+    """{rel: md5} of the 6 inputs; SystemExit on a missing file, a wrong md5 or row count, or a md5 that differs from
+    the parent reports."""
+    rep3_p, repk_p = root / "eval/khop3/build_report.json", root / "eval/khop/build_report.json"
+    for p in (rep3_p, repk_p):
+        if not p.is_file():
+            raise SystemExit(f"build_khop4: parent report {p} is missing")
+    try:
+        rep3, repk = json.loads(rep3_p.read_text()), json.loads(repk_p.read_text())
+    except ValueError as e:
+        raise SystemExit(f"build_khop4: a parent report does not parse ({e})")
+    if not isinstance(rep3, dict) or not isinstance(repk, dict):
+        raise SystemExit("build_khop4: a parent report is not a JSON object")
+    m3, mk = rep3.get("md5") or {}, repk.get("md5") or {}
+    got = {}
+    for rel, want in CARD_MD5.items():
+        p = root / rel
+        if not p.is_file():
+            raise SystemExit(f"build_khop4: input {p} is missing")
+        h = md5(p)
+        rep_md5 = m3.get(rel) if rel.startswith("student_") else mk.get(rel.split("/")[-1])
+        if h != want or rep_md5 != want:
+            raise SystemExit(f"build_khop4: {p} md5 {h} (report {rep_md5}), card {want}")
+        n = rows(p)
+        if n != CARD_ROWS[rel]:
+            raise SystemExit(f"build_khop4: {p} has {n} rows, card {CARD_ROWS[rel]}")
+        got[rel] = h
+    return got
+
+
+def check_paths(root: Path, out_root: Path, report: Path) -> None:
+    ins = {(root / d).resolve() for d in SRC.values()} | {(root / "eval/khop3").resolve(), (root / "eval/khop").resolve()}
+    outs = {(out_root / d).resolve() for d in DST.values()}
+    for p, what in [(out_root, "--out-root"), (report, "--report")] + [(o, "output dir") for o in outs]:
+        if p.resolve() in ins:
+            raise SystemExit(f"build_khop4: {what} {p} equals an input directory")
+    if report.resolve() in outs:
+        raise SystemExit(f"build_khop4: --report {report} equals an output directory")
+    for o in outs:
+        if o.exists() and (not o.is_dir() or set(os.listdir(o)) - set(FILES)):
+            raise SystemExit(f"build_khop4: output dir {o} holds other files {sorted(os.listdir(o)) if o.is_dir() else o}")
+    if report.exists() and (not report.is_dir() or set(os.listdir(report)) - {"build_report.json"}):
+        raise SystemExit(f"build_khop4: report dir {report} holds other files")
+
+
+def build(root: Path, out_root: Path, report: Path) -> dict:
+    check_paths(root, out_root, report)
+    before = check_inputs(root)
+    fail = []
+    replay = {}
+    for name, (rp, src) in REPLAY.items():
+        a, b = (root / rp).read_bytes(), head_bytes(root / src, N_REPLAY)
+        replay[f"{name}_equals_rows_0_2999_of_{src.split('/')[0]}"] = a == b
+        if a != b:
+            fail.append(f"{name} != rows 0..2,999 of {src}")
+    out_md5, out_rows = {}, {}
+    for k in SRC:
+        od = out_root / DST[k]
+        od.mkdir(parents=True, exist_ok=True)
+        for f in FILES:
+            data = (root / SRC[k] / f).read_bytes()
+            (od / f).write_bytes(data)
+            rel = f"{DST[k]}/{f}"
+            out_md5[rel], out_rows[rel] = md5(od / f), rows(od / f)
+            if out_md5[rel] != before[f"{SRC[k]}/{f}"]:
+                fail.append(f"{rel} is not a byte copy of {SRC[k]}/{f}")
+    # the replay rows are inside the khop4 train files too (D2 of card 2.5)
+    for name, (rp, src) in REPLAY.items():
+        dst = out_root / DST["c27" if "c27" in src else "k1x"] / "train.jsonl"
+        ok = (root / rp).read_bytes() == head_bytes(dst, N_REPLAY)
+        replay[f"{name}_equals_rows_0_2999_of_{dst.parent.name}"] = ok
+        if not ok:
+            fail.append(f"{name} != rows 0..2,999 of {dst.parent.name}/train.jsonl")
+    file_sets = {DST[k]: sorted(os.listdir(out_root / DST[k])) for k in SRC}
+    for d, fs in file_sets.items():
+        if fs != sorted(FILES):
+            fail.append(f"{d} file set {fs}")
+    after = {rel: md5(root / rel) for rel in CARD_MD5}
+    if after != before:
+        fail.append("an input changed during the build")
+    rep = {"card": CARD, "generator": "scripts/build_khop4.py",
+           "inputs": {rel: {"md5": before[rel], "rows": CARD_ROWS[rel]} for rel in CARD_MD5},
+           "md5": out_md5, "rows": out_rows, "file_sets": file_sets, "replay": replay,
+           "inputs_unchanged": after == before, "d_fail": fail, "d_pass": not fail}
+    report.mkdir(parents=True, exist_ok=True)
+    (report / "build_report.json").write_text(json.dumps(rep, indent=1, sort_keys=True) + "\n")
+    return rep
+
+
+def main(argv=None) -> None:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--khop3-root", default="data", help="data root holding student_khop3_* and eval/{khop,khop3}")
+    ap.add_argument("--out-root", default="data", help="student_khop4_c27 / student_khop4_k1x are written here")
+    ap.add_argument("--report", default="data/eval/khop4")
+    a = ap.parse_args(argv)
+    rep = build(Path(a.khop3_root), Path(a.out_root), Path(a.report))
+    print(json.dumps({k: rep[k] for k in ("md5", "rows", "replay", "inputs_unchanged", "d_pass", "d_fail")}, indent=1))
+    if not rep["d_pass"]:
+        sys.exit(2)
+
+
+if __name__ == "__main__":
+    main()
diff -ruN -x __pycache__ -x data repo.base/tests/test_build_khop4.py repo/tests/test_build_khop4.py
--- repo.base/tests/test_build_khop4.py	1969-12-31 18:00:00
+++ repo/tests/test_build_khop4.py	2026-10-27 21:37:13
@@ -0,0 +1,326 @@
+"""scripts/build_khop4.py (CARD_khop_v4 1.2, 2.5 D1 / D2, section 5) and the two stage-2 protections on the tiny model.
+Real-file tests (KHOP4_DATA_ROOT or E/src/data: student_khop3_*, eval/khop, eval/khop3, student_gsm8k_tf_vt):
+- the 4 outputs equal the khop3 inputs byte for byte; train_kh = rows 0..2,999 of student_khop4_c27/train.jsonl and
+  train_k1 = rows 0..2,999 of student_khop4_k1x/train.jsonl byte for byte (D2); the report values recomputed from the
+  files equal the report; two builds are byte-equal and equal to the files and the report in the data root; the inputs
+  are unchanged (md5 before and after, against the card values); the replay item_ids (khop-tr-*) and the gsmvt train
+  item_ids are disjoint (the trainer stops on a duplicate, so R would not start otherwise).
+- refusals before any write: a changed row in each of the 6 inputs, a parent report with another md5, a row count off,
+  a non-object report, --out-root / --report / an output dir equal to an input dir, an output dir or report dir that
+  holds another file.
+- the tiny two-stage run (tests/test_build_khop3.py pattern: torchrun --local-addr 127.0.0.1, FSDP cpu-adamw,
+  --eval-value-render vt, label smoothing 0.1, --token-budget 4096, seed = order seed 16, micro-bs 2, grad-accum 2):
+  stage 1 with --save on 18 khop rows, then from the saved weights on 6 GSM rows:
+  (a) arm L: --lr at one quarter of the reference (2.5e-4 against 1e-3): the history lr values are exactly one quarter
+      of the reference run's at every step (--log-every 1; a power-of-two factor is exact in floating point), the
+      per-update examples (item_id, text, labels, target) equal the reference's, losses finite, final step 2;
+  (b) arm R: --extra-train of 6 khop rows (disjoint from the stage-1 rows): log lines "extra-train: 6 rows from <path>"
+      and "extra-train: total training rows 12 (6 from <gsm path>)", "stage all: 12 examples per pass, 3 steps", final
+      step ceil((6 + 6) / 4) = 3, metrics.json extra_train {<path>: 6}, finite losses, every training example is a GSM
+      or a replay row and every one of the 12 rows is seen; a --extra-train file that repeats a training item_id stops
+      the trainer (SystemExit, nonzero exit) before any update.
+Run: python -m unittest tests.test_build_khop4 (from the repo)."""
+import hashlib
+import json
+import math
+import os
+import random
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from collections import Counter, defaultdict
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+sys.path.insert(0, str(ROOT / "tests"))
+import build_khop as B  # noqa: E402
+import build_khop4 as K4  # noqa: E402
+
+try:
+    import torch  # noqa: F401
+    import transformers  # noqa: F401
+    from test_depth_forcing import gpt2_tok, tiny_qwen35
+    import test_build_khop3 as K3T          # TRACER, TORCHRUN, ENV (module import: its tests are not collected here)
+    HAVE_TORCH = True
+except ImportError:
+    HAVE_TORCH = False
+
+E_DEFAULT = ROOT.parents[1]                     # E (repo = E/src_khop4/repo)
+DATA = Path(os.environ.get("KHOP4_DATA_ROOT") or E_DEFAULT / "src/data")
+HAVE_DATA = all((DATA / r).is_file() for r in K4.CARD_MD5) and (DATA / "eval/khop3/build_report.json").is_file()
+TRAIN = str(ROOT / "scripts/train_student.py")
+
+
+def md5(p):
+    return hashlib.md5(Path(p).read_bytes()).hexdigest()
+
+
+def copy_inputs(dst: Path):
+    """The 6 inputs and the 2 parent reports under dst (a fresh data root)."""
+    for rel in list(K4.CARD_MD5) + ["eval/khop3/build_report.json", "eval/khop/build_report.json"]:
+        (dst / rel).parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(DATA / rel, dst / rel)
+    return dst
+
+
+@unittest.skipUnless(HAVE_DATA, "needs the khop3 data files")
+class TestRealBuild(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp = tempfile.TemporaryDirectory()
+        d = Path(cls.tmp.name)
+        cls.before = {rel: md5(DATA / rel) for rel in K4.CARD_MD5}
+        cls.rep = K4.build(DATA, d / "o1", d / "o1/eval/khop4")
+        cls.rep2 = K4.build(DATA, d / "o2", d / "o2/eval/khop4")
+        cls.d = d
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.tmp.cleanup()
+
+    def test_report_passes(self):
+        self.assertTrue(self.rep["d_pass"], self.rep["d_fail"])
+        self.assertEqual(self.rep["d_fail"], [])
+        self.assertTrue(all(self.rep["replay"].values()))
+        self.assertEqual(len(self.rep["replay"]), 4)
+        self.assertTrue(self.rep["inputs_unchanged"])
+
+    def test_byte_copies(self):
+        for k in K4.SRC:
+            for f in K4.FILES:
+                self.assertEqual((self.d / "o1" / K4.DST[k] / f).read_bytes(), (DATA / K4.SRC[k] / f).read_bytes())
+            self.assertEqual(sorted(os.listdir(self.d / "o1" / K4.DST[k])), ["train.jsonl", "val.jsonl"])
+
+    def test_d2_replay_rows(self):
+        for rp, dd in (("eval/khop/train_kh.jsonl", "student_khop4_c27"), ("eval/khop/train_k1.jsonl", "student_khop4_k1x")):
+            head = b"".join((self.d / "o1" / dd / "train.jsonl").read_bytes().splitlines(keepends=True)[:3000])
+            self.assertEqual(head, (DATA / rp).read_bytes(), rp)
+            self.assertEqual(hashlib.md5(head).hexdigest(), K4.CARD_MD5[rp])
+
+    def test_report_recomputed(self):
+        r = json.loads((self.d / "o1/eval/khop4/build_report.json").read_text())
+        self.assertEqual(r["card"], "CARD_khop_v4")
+        for k in K4.SRC:
+            for f in K4.FILES:
+                p = self.d / "o1" / K4.DST[k] / f
+                rel = f"{K4.DST[k]}/{f}"
+                self.assertEqual(r["md5"][rel], md5(p))
+                self.assertEqual(r["rows"][rel], len(p.read_bytes().splitlines()))
+        self.assertEqual(r["md5"]["student_khop4_c27/train.jsonl"], "92545dd42ca451c39e0e7c104aa78d1e")
+        self.assertEqual(r["md5"]["student_khop4_k1x/train.jsonl"], "d7cc9716e5785461d16ec92156104261")
+        self.assertEqual(r["md5"]["student_khop4_c27/val.jsonl"], "9f55fec541246e41401a7b5fa6c5510a")
+        self.assertEqual({k: v["md5"] for k, v in r["inputs"].items()}, K4.CARD_MD5)
+        self.assertEqual({k: v["rows"] for k, v in r["inputs"].items()}, K4.CARD_ROWS)
+        self.assertEqual(r["file_sets"], {d: ["train.jsonl", "val.jsonl"] for d in K4.DST.values()})
+
+    def test_deterministic_and_equal_to_data_root(self):
+        a, b = self.d / "o1", self.d / "o2"
+        for rel in [f"{d}/{f}" for d in K4.DST.values() for f in K4.FILES] + ["eval/khop4/build_report.json"]:
+            self.assertEqual((a / rel).read_bytes(), (b / rel).read_bytes(), rel)
+            if (DATA / rel).exists():
+                self.assertEqual((a / rel).read_bytes(), (DATA / rel).read_bytes(), rel)
+
+    def test_inputs_unchanged(self):
+        self.assertEqual(self.before, K4.CARD_MD5)
+        self.assertEqual({rel: md5(DATA / rel) for rel in K4.CARD_MD5}, K4.CARD_MD5)
+
+    def test_replay_ids_disjoint_from_gsm(self):
+        gsm = DATA / "student_gsm8k_tf_vt/train.jsonl"
+        if not gsm.is_file():
+            self.skipTest("no gsmvt train file")
+        g = {json.loads(l)["item_id"] for l in gsm.read_text().split("\n") if l.strip()}
+        self.assertEqual(len(g), 5923)
+        for rp in ("eval/khop/train_kh.jsonl", "eval/khop/train_k1.jsonl"):
+            ids = [json.loads(l)["item_id"] for l in (DATA / rp).read_text().split("\n") if l.strip()]
+            self.assertEqual(len(set(ids)), 3000, rp)
+            self.assertFalse(set(ids) & g, rp)
+            self.assertTrue(all(i.startswith("khop-tr-") for i in ids), rp)
+
+
+@unittest.skipUnless(HAVE_DATA, "needs the khop3 data files")
+class TestRefusals(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.d = Path(self.tmp.name)
+        self.root = copy_inputs(self.d / "in")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def refused(self, out_root=None, report=None, want=""):
+        out_root = out_root or self.d / "out"
+        report = report or self.d / "rep"
+        rp = report / "build_report.json"
+        pre = rp.read_bytes() if rp.exists() else None
+        with self.assertRaises(SystemExit) as c:
+            K4.build(self.root, out_root, report)
+        self.assertIn(want, str(c.exception))
+        for dd in K4.DST.values():                                  # nothing written
+            self.assertFalse((out_root / dd / "train.jsonl").exists(), out_root / dd)
+            self.assertFalse((out_root / dd / "val.jsonl").exists(), out_root / dd)
+        self.assertEqual(rp.read_bytes() if rp.exists() else None, pre, report)      # no report written
+        return str(c.exception)
+
+    def test_good_copy_builds(self):
+        rep = K4.build(self.root, self.d / "out", self.d / "rep")
+        self.assertTrue(rep["d_pass"])
+
+    def test_changed_inputs(self):
+        for rel in K4.CARD_MD5:
+            p = self.root / rel
+            orig = p.read_bytes()
+            lines = orig.splitlines(keepends=True)
+            lines[1] = lines[1].replace(b'"', b"'", 1)            # one changed row, same row count
+            p.write_bytes(b"".join(lines))
+            self.refused(want="md5")
+            p.write_bytes(orig)
+
+    def test_report_md5_and_rows(self):
+        p = self.root / "eval/khop3/build_report.json"
+        r = json.loads(p.read_text())
+        r["md5"]["student_khop3_k1x/train.jsonl"] = "0" * 32
+        p.write_text(json.dumps(r))
+        self.refused(want="report")
+        p.write_text("[1, 2]")
+        self.refused(want="not a JSON object")
+        p.write_text("{")
+        self.refused(want="does not parse")
+        shutil.copyfile(DATA / "eval/khop3/build_report.json", p)
+        q = self.root / "eval/khop/build_report.json"
+        r = json.loads(q.read_text())
+        r["md5"]["train_kh.jsonl"] = "1" * 32
+        q.write_text(json.dumps(r))
+        self.refused(want="train_kh")
+        shutil.copyfile(DATA / "eval/khop/build_report.json", q)
+        os.remove(self.root / "eval/khop/train_k1.jsonl")
+        self.refused(want="missing")
+
+    def test_row_count(self):
+        # a file with the card md5 cannot be short; the row check is the rows() rule: no newline at the end stops
+        p = self.d / "x.jsonl"
+        p.write_bytes(b'{"a": 1}\n{"a": 2}')
+        with self.assertRaises(SystemExit):
+            K4.rows(p)
+        p.write_bytes(b'{"a": 1}\n{"a": 2}\n')
+        self.assertEqual(K4.rows(p), 2)
+
+    def test_paths(self):
+        self.refused(out_root=self.root / "student_khop3_c27", want="equals an input directory")
+        self.refused(report=self.root / "eval/khop3", want="equals an input directory")
+        self.refused(report=self.root / "eval/khop", want="equals an input directory")
+        self.refused(report=self.d / "out/student_khop4_c27", want="equals an output directory")
+        o = self.d / "out2/student_khop4_k1x"
+        o.mkdir(parents=True)
+        (o / "keep.txt").write_text("x")
+        self.refused(out_root=self.d / "out2", want="holds other files")
+        r = self.d / "rep2"
+        r.mkdir()
+        (r / "other.json").write_text("{}")
+        self.refused(report=r, want="holds other files")
+
