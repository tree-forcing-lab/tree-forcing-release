# OPC Stage 1 (card CARD_opc_sev6e_v3, 2026-10-21): eval-only jobs, executable run_eval_iv.sh, bundle cotd_code_data_hint_4b.tgz (batch-14 code + data + data/eval/hint), weights from /staging/weights. Same host exclusions as train12_4b.sub.
include : chtc_settings.inc
universe = vanilla
container_image = file://$(STAGING)/cotd_4b.sif
executable = run_eval_iv.sh
arguments = $(envfile) $(name)
environment = "STAGING=$(STAGING) CODE_TGZ=cotd_code_data_hint_4b.tgz SMOKE_ONLY=$(smoke) NGPU_REQ=$(ngpu) OMP_THREADS_1G=$(cpus)"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = cotd_code_data_hint_4b.tgz
transfer_output_files = results_$(name).tgz
transfer_output_remaps = "results_$(name).tgz = results/results_$(name).tgz"
job_machine_attrs = Machine
job_machine_attrs_history_length = 4
requirements = (HasCHTCStaging == true) && (TARGET.Machine =!= "oconnorgpu2000.chtc.wisc.edu") && (TARGET.Machine =!= "gpu4000.chtc.wisc.edu") && (TARGET.Machine =!= "gpu4002.chtc.wisc.edu") && (TARGET.Machine =!= "patel0000.chtc.wisc.edu") && (TARGET.Machine =!= "gpu2008") && (regexp("^gpu2008[.]", TARGET.Machine) =!= true) && (TARGET.Machine =!= MY.MachineAttrMachine1) && (TARGET.Machine =!= MY.MachineAttrMachine2) && (TARGET.Machine =!= MY.MachineAttrMachine3)
max_retries = 3
retry_until = (ExitCode =!= 86)
request_gpus = $(ngpu)
require_gpus = (GlobalMemoryMb >= $(gpumem)) && (DriverVersion >= 12.8) && (Capability < 9.0 || Capability >= 10.0) && !regexp("MIG", DeviceName)
+WantGPULab = true
+is_resumable = true
+GPUJobLength = "medium"
request_cpus = $(cpus)
request_memory = $(mem)
request_disk = 40GB
priority = $(prio)
log = logs/train_hint_4b.log
output = logs/$(name).condor.out
error = logs/$(name).condor.err
queue
