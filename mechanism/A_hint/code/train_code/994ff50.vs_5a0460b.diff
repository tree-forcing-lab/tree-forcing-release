+        self.assertEqual([x["loss_final"] for x in ms["PTAD"]["history"]][0],
+                         [x["loss_final"] for x in ms["PTADX"]["history"]][0])          # same first update's CE
+        side = json.loads(Path(f"{d}/TSF/model/latent_slots.json").read_text())
