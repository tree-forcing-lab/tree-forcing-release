+            self.assertIn("v", m["teacher_align"])
+            self.assertIn("train", m["teacher_align"])
+        forced = {arm: sum(x["forced_mb"] for x in ms[arm]["history"]) for arm in TSF_ARMS}
+        self.assertEqual(forced["TSFN"], 0)
+        for arm in ("TSF", "TSFR", "TSFX", "TSF6"):
