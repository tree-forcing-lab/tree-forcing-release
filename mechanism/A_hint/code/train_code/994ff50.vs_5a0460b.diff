+            own = set(real[iid])
+            others = {t for j, r in real.items() if j != iid for t in r if t is not None}
+            for t in ts:
+                if t is not None:
+                    self.assertNotIn(t, own)
+                    self.assertIn(t, others)
+        self.assertEqual(sum(t is not None for ts in a.values() for t in ts), 21)
