+    def keys(self, x, path=""):
+        if isinstance(x, dict):
+            for k, v in x.items():
+                yield f"{path}/{k}", k
+                yield from self.keys(v, f"{path}/{k}")
+        elif isinstance(x, list):
+            for v in x:
