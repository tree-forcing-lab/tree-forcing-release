+                self.assertEqual(set(row["v"]["detect"]) >= {"force_minus_intact", "intact_minus_mean", "n_chain"}, True)
+            nec = m["slot_necessity"]["v"]
+            self.assertEqual(set(nec), {"swap", "drop", "mean", "force", "forceswap"}, arm)
