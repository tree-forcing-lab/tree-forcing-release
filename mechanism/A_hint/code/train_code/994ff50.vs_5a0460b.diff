+                self.assertEqual(set(it), set(ref), it["item_id"])
+                self.assertEqual(set(it["fa"]), set(ref["fa"]), it["item_id"])
+                for k, v in ref.items():
+                    self.assertIs(type(it[k]), type(v), f"{it['item_id']} {k}")
