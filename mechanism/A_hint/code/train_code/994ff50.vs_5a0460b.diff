+def lens_spec(k=6, c=2, layer=0, fill="last", tokens=DIST):
+    from cotdistill.student import SlotSpec
+    return SlotSpec(k, c, tokens[0], tokens=tuple(tokens[:k]), layer=layer, readout="lens", fill=fill)
