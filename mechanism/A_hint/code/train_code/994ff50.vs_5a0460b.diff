+                    want = (f"{it['prompt']}\n\nIntermediate question: {r['question']}\nOptions:\n"
+                            + "\n".join(f"{L}) {o}" for L, o in zip("ABCD", r["options"])) + "\nAnswer:")
+                    self.assertEqual(e.text, want)
