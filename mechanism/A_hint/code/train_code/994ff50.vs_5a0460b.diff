+    if addon is not None:
+        if (addon.get("checks") or {}).get("pass"):
+            have = {x["id"] for x in nodes}
+            add = [x for x in addon.get("nodes") or [] if x["id"] not in have]
+            nodes += copy.deepcopy(add)
