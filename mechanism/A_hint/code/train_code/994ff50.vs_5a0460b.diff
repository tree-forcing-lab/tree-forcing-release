diff -ruN -x __pycache__ -x *.pyc x_4b/repo/cloud/chtc/make_dags_10.sh <tmp>
--- x_4b/repo/cloud/chtc/make_dags_10.sh	1969-12-31 18:00:00
+++ <tmp>	2026-10-21 18:57:30
@@ -0,0 +1,39 @@
+#!/bin/bash
+# Writes the batch-10 DAGs (README_8.md), Qwen3.5-4B only, as make_dags_7.sh: jobs10_4b.dag (every job of
+# joblist_10_4b.txt: "<env file>, <priority>, <GPUs>"; priority order, one DAG-level retry, POST = push to GitHub) and
+# smoke10_4b.dag (the smoke stage of 219 LS and 225 LSY, latent node slots: SMOKE_ONLY, about 15-20 min each, mostly
+# unpacking the model; the first GPU run of the slot decoding pass, inputs_embeds through Qwen3.5). Submit file
+# train10_4b.sub. Resources: a 1-GPU line (the friend's fsdp1 patch, as batches 3-7 ran 4B; the joblist ships with 1)
+# gets 8 CPUs / 80 GB (49 GiB RSS in 42 / 75 / 83 / 125), a 2-GPU line 12 CPUs / 120 GB; GPUs >= 40 GB. Node names
+# j219... / smoke219... (batch 7: j201-j218; the friend's own jobs: 164-188 so far), DAGMan log logs/train10_4b.log.
+# The joblist is read from this directory, else from ../condor (the repo layout).
+#   bash make_dags_10.sh
+set -euo pipefail
+cd "$(dirname "$0")"
+L=joblist_10_4b.txt; [ -f "$L" ] || L=../condor/joblist_10_4b.txt
+[ -f "$L" ] || { echo "no joblist_10_4b.txt"; exit 1; }
