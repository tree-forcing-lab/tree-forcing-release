+                             ("tsf", 2, "merge" if arm == "TSF6" else "truncate"), arm)
+            self.assertEqual(ls["views"]["teacher_views"], 5, arm)
+            self.assertTrue(Path(f"{d}/{arm}/preds_v@force.jsonl").exists())
+            self.assertNotIn("slot_readout", m)
