diff -ruN -x __pycache__ -x *.pyc x_4b/repo/hpc/train_arm.sbatch x_4b_1g/repo/hpc/train_arm.sbatch
--- x_4b/repo/hpc/train_arm.sbatch	2026-10-17 02:26:09
+++ x_4b_1g/repo/hpc/train_arm.sbatch	2026-10-17 14:01:44
@@ -143,6 +143,19 @@
   [ -z "${STOPH:-}${CKPTMIN:-}" ] || [ "${FSDP_OPTIM:-cpu-adamw}" = 8bit-sr ] || \
     { echo "STOPH/CKPTMIN with NGPU=2 need FSDP_OPTIM=8bit-sr (cpu-adamw state, 143 GB at 12B, is not saved)"; exit 1; }
   echo "two slices: torchrun, 2 ranks, ${FSDP_OPTIM:-cpu-adamw}, OMP_NUM_THREADS=$OMP_NUM_THREADS per rank"
+elif [ "$ng" = 1 ] && [ -n "${FSDP_OPTIM:-}" ]; then
+  # One GPU, the two-slice recipe unchanged (CHTC 2026-10-17: two-GPU slots are scarce, single L40S slots are not).
+  # torchrun with one rank: --fsdp on a one-device mesh, so every update holds the same micro_bs x grad_accum
+  # sequences as the two-rank run, bf16 shards (here the whole model), fp32 master + AdamW on the CPU. Only the order
+  # of the bf16 gradient summation differs (two half-sums vs one sum), the same class as run-to-run GPU noise.
+  # Opt-in: the NGPU=1 envs of the a100r recipe have FSDP_OPTIM='' and keep the plain single-GPU path below.
+  case "$FSDP_OPTIM" in cpu-adamw|8bit-sr) ;; *) echo "FSDP_OPTIM must be cpu-adamw or 8bit-sr"; exit 1 ;; esac
+  tr="$PY -m torch.distributed.run --standalone --nproc_per_node 1"
+  fs="--fsdp --fsdp-optim $FSDP_OPTIM"; pr=bf16
+  export OMP_NUM_THREADS=${OMP_THREADS_1G:-${SLURM_CPUS_PER_TASK:-12}}
+  [ -z "${STOPH:-}${CKPTMIN:-}" ] || [ "$FSDP_OPTIM" = 8bit-sr ] || \
+    { echo "STOPH/CKPTMIN with FSDP need FSDP_OPTIM=8bit-sr (cpu-adamw state is not saved)"; exit 1; }
+  echo "one slice: torchrun, 1 rank, $FSDP_OPTIM, OMP_NUM_THREADS=$OMP_NUM_THREADS"
 fi
 REPO="${REPO:-repo}"
 [ -f "$REPO/scripts/train_student.py" ] || { echo "missing $REPO/scripts/train_student.py"; exit 1; }
