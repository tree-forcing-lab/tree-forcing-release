+"""--node-format mc with --tree-view statements / statements+question (GFPQM: value multiple-choice nodes in the GFPQ
+view). student.mc_value_plan folds the value probe nodes of each solution step ("<stem> Is it <v>?", gsm8k_tf) into one
+view: the stem asked over the step's values (gold, its wrong probes, other steps' values up to 3 wrong) + "None of
+them", one-hot target on the gold value, option order from mc_value_rng(seed, epoch, item, node). Checked here, CPU
+only (tiny random Qwen2 with the gpt2 tokenizer of test_student.tiny): (a) with --node-format yesno everything is the
+pristine code's, bit for bit at the library level (build_full_tree for every mode / view / cap, the problem-view mc
+path included) and file for file against the pristine script (history, eval, preds of a2, tf, gfp, gfpq, gfpqr runs);
+(b) on the real data/student_gsm8k_tf/train.jsonl every mc view has >= 2 options + "None of them", the gold among
+them, no duplicate, the data's own printed values, one view per step, the per-problem weight unchanged; (c) the option
+order is keyed by (seed, epoch, item, node) and never touches the training rng; (d) FSDP 1 rank == single process,
+resume across an epoch boundary, --tree-target shuffled (random option) and the flag checks (placebo, cap, pack,
+scaffold refused).
+
+$COTD_MCV_BASE names a pristine export of the code (scripts/ and src/); without it the pinned commit is compared
+through git archive (skipped outside a git checkout). $COTD_TORCHRUN_ARGS adds torchrun flags (e.g. "--local-addr
+127.0.0.1" on a machine whose host name does not resolve). $COTD_GSM8K_TF names the real train file (default:
+data/student_gsm8k_tf/train.jsonl under the repo or next to it)."""
+import dataclasses
+import json
+import os
+import random
+import re
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+sys.path.insert(0, str(ROOT / "tests"))
+
+try:
+    import torch
+    import transformers  # noqa: F401
+    import test_fsdp as tf
+    import test_student as ts
+    import test_train_resume as tr
+    from test_tree_forcing import KK, head_tree
+    HAVE = True
+except ImportError:
+    HAVE = False
+
+SCRIPT = str(ROOT / "scripts/train_student.py")
+MCV_BASE_REF = os.environ.get("MCV_BASE_REF", "5a0460b")       # the 4B CHTC batch's code pin, before GFPQM
+GSM = next((p for p in (os.environ.get("COTD_GSM8K_TF") or None, ROOT / "data/student_gsm8k_tf/train.jsonl",
+                        ROOT.parent / "data/student_gsm8k_tf/train.jsonl") if p and Path(p).is_file()), None)
+GFPQ = ["--tree-full", "plain", "--tree-view", "statements+question", "--tree-cap", "0", "--tree-sources", "gsm8k_tf",
+        "--label-smoothing", "0.1", "--items-per-update", "2", "--micro-bs", "3", "--max-len", "256", "--log-every",
+        "1", "--lr", "1e-3", "--seed", "0", "--epochs", "1", "--no-grad-ckpt"]
+MC = ["--node-format", "mc"]
+MODES = [("plain", "problem"), ("plain", "statements"), ("plain", "statements+question"), ("true", "problem"),
+         ("matched", "problem"), ("placebo", "problem"), ("control", "problem"), ("true", "local"),
+         ("matched", "local"), ("plain", "local"), ("true", "ancestors"), ("true", "mix")]
+DROP = re.compile(r"s_per_step|approx_tok_per_s")
+
+
+def base_tree(dest: str):
+    b = os.environ.get("COTD_MCV_BASE")
+    if b and Path(b, "scripts/train_student.py").exists():
+        return Path(b)
+    return head_tree(dest, MCV_BASE_REF)
+
+
+_BASE: dict = {}
+
+
+def base_student():
+    """cotdistill.student of the pristine code, imported once per session as the package cotd_mcv_base; None when
+    the base code is not available."""
+    import importlib
+    import shutil
+    if "mod" not in _BASE:
+        _BASE["dir"] = tempfile.TemporaryDirectory()
+        base = base_tree(_BASE["dir"].name)
+        _BASE["mod"] = None
+        if base is not None:
+            pkg = Path(_BASE["dir"].name) / "pkg"
+            shutil.copytree(base / "src/cotdistill", pkg / "cotd_mcv_base")
+            sys.path.insert(0, str(pkg))
+            _BASE["mod"] = importlib.import_module("cotd_mcv_base.student")
+    return _BASE["mod"]
+
+
+def gsm_items(n: int | None = None, pred=lambda it: True) -> list[dict]:
+    out = []
+    if GSM is None:
+        return out
+    with open(GSM) as f:
+        for line in f:
+            it = json.loads(line)
+            if pred(it):
+                out.append(it)
+                if n is not None and len(out) == n:
+                    break
+    return out
+
+
+def nodes_of(it: dict) -> list[dict]:
+    return [sq for sq in it.get("subqs") or [] if "id" in sq]
+
+
+def steps_of(it: dict) -> int:
+    return len({sq["step"] for sq in nodes_of(it)})
+
+
+def small_gsm(n: int = 12) -> list[dict]:
+    """Real gsm8k_tf items with 1-3 steps and a short prompt (the tiny runs' max-len 256 with the gpt2 tokenizer)."""
+    return gsm_items(n, lambda it: nodes_of(it) and 1 <= steps_of(it) <= 3 and len(it["prompt"]) < 330)
+
+
+def tuples(ex) -> list:
+    return [dataclasses.astuple(e) for e in ex]
+
+
+def fsdp(d: str, *argv, nproc: int = 1):
+    extra = os.environ.get("COTD_TORCHRUN_ARGS", "").split()
+    return subprocess.run([sys.executable, "-m", "torch.distributed.run", "--standalone", *extra, "--nproc_per_node",
+                           str(nproc), SCRIPT, *argv, "--fsdp"], capture_output=True, text=True, timeout=900,
+                          env=tf.env(d))
+
+
+def strip(h):
+    return [{k: v for k, v in row.items() if not DROP.match(k)} for row in h]
+
+
+def synthetic_item(k_wrong: int = 3, opposite: bool = True, steps: int = 2) -> dict:
+    """A gsm8k_tf-shaped item with `steps` steps, each with a gold probe, k_wrong wrong probes and (opposite) every
+    probe in the "different from" wording too (the shape of the V4 multi-probe data)."""
+    prompt = "Question: Ann has 4 boxes of 6 pens and gives away 5. How many pens are left?\nOptions:\nA) 19\nB) 24\nC) 5"
+    subqs = []
+    for s in range(1, steps + 1):
+        stem = f"How many pens in step {s}"
+        val = 24.0 * s
+        probes = [val] + [val + 2 + 3 * j for j in range(k_wrong)]
+        for j, pr in enumerate(probes):
+            gold = j == 0
+            v = str(int(pr))
+            base = dict(type="step", depends_on=[], initial=None, status="direct", probe=pr, step=s, expr="4*6",
+                        value=val, flags=[], gold_ancestor=True, node_depth=s - 1, p_fresh=None)
+            if not gold:
+                base["wrong"] = "slip"
+            subqs.append(dict(base, id=f"s{s}{'v' if gold else 'n' + str(j)}", question=f"{stem}? Is it {v}?",
+                              opposite=f"{stem}? Is it different from {v}?", truth=gold, p_cot=1.0 if gold else 0.0))
+            if opposite:
+                subqs.append(dict(base, id=f"s{s}{'v' if gold else 'n' + str(j)}o",
+                                  question=f"{stem}? Is it different from {v}?", opposite=f"{stem}? Is it {v}?",
+                                  truth=not gold, p_cot=0.0 if gold else 1.0))
+    return {"item_id": "syn-1", "source": "gsm8k_tf", "group": "gsm8k_tf/s2", "type": "choice", "prompt": prompt,
+            "labels": ["A", "B", "C"], "gold_label": "A", "teacher": {"A": 1.0, "B": 0.0, "C": 0.0},
+            "options": ["19", "24", "5"], "subqs": subqs, "random_subqs": [], "has_tree": True, "tree_fix": True,
+            "n_steps": steps}
+
