+    def test_real_data(self):
+        """Every item of the real train file: one mc view per step, each with >= 2 options + None, the gold among
+        them, no duplicate option, every option a printed value of the item's own nodes (integers and decimals as the
+        data prints them), the weights of the problem sum to aux_total as in GFPQ, the final untouched, and the yes/no
+        run has exactly twice the views."""
+        from cotdistill.student import MC_NONE, MC_VALUE_FLOAT, build_full_tree, problem_no_options
+        kw = dict(mode="plain", view="statements+question", cap=0, sources={"gsm8k_tf"})
+        n_items = n_mc = n_yn = 0
+        hist = {}
+        for it in gsm_items():
+            n_items += 1
+            a = build_full_tree(it, rng=random.Random(1), stats=(sa := {}), **kw)
+            b = build_full_tree(it, rng=random.Random(1), stats=(sb := {}), node_format="mc", mix_seed=12, **kw)
+            self.assertEqual(dataclasses.astuple(a[0]), dataclasses.astuple(b[0]), it["item_id"])   # the final
+            nodes = nodes_of(it)
+            self.assertEqual(len(a) - 1, len(nodes))
+            self.assertEqual(len(b) - 1, steps_of(it))
+            n_yn += len(a) - 1
+            n_mc += len(b) - 1
+            if nodes:
+                self.assertAlmostEqual(sum(e.weight for e in a[1:]), 1.0, places=9)
+                self.assertAlmostEqual(sum(e.weight for e in b[1:]), 1.0, places=9)
+                self.assertEqual((sb["views"], sb["mc_views"], sb["mc_folded"]),
+                                 (steps_of(it), steps_of(it), len(nodes) - steps_of(it)))
+            printed = {sq["question"].rpartition(" Is it ")[2][:-1] for sq in nodes}      # the data's own values
+            by_q = {sq["question"]: sq for sq in nodes}
+            ctx = problem_no_options(it)
+            for e in b[1:]:
+                head, _, rest = e.text.partition("\n\nIntermediate question: ")
+                self.assertEqual(head, ctx)
+                self.assertNotIn("\nOptions:\nA) " + it["options"][0], head)          # no final options leak
+                stem, _, rest = rest.partition("\nOptions:\n")
+                opts = [o[3:] for o in rest.split("\nAnswer:")[0].split("\n")]
+                self.assertEqual(e.labels, [chr(65 + i) for i in range(len(opts))])
+                self.assertEqual(opts[-1], MC_NONE)
+                self.assertGreaterEqual(len(opts), 3)
+                self.assertEqual(len(set(opts)), len(opts))
+                gold = opts[e.target.index(1.0)]
+                self.assertEqual(sum(e.target), 1.0)
+                self.assertNotEqual(gold, MC_NONE)
+                g = by_q[f"{stem} Is it {gold}?"]                             # the gold option is the step's gold
+                self.assertEqual(float(g["probe"]), float(g["value"]))           # probe (two steps may share a value)
+                for o in opts[:-1]:
+                    self.assertTrue(MC_VALUE_FLOAT.match(o), o)
+                    self.assertIn(o, printed)                                   # the data's own printed values
+                step_wrong = {sq["question"].rpartition(" Is it ")[2][:-1] for sq in nodes
+                              if sq["step"] == g["step"] and not sq["truth"]}
+                self.assertTrue(step_wrong <= set(opts), (step_wrong, opts))    # the step's own wrong probes
+                hist[len(opts)] = hist.get(len(opts), 0) + 1
+                self.assertEqual(e.kind, "subq")
+        self.assertEqual(n_items, 5923)
+        self.assertEqual((n_yn, n_mc), (23692, 11846))
+        self.assertEqual(sorted(hist), [3, 4, 5])
