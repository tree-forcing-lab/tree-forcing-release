+    def test_mc_run_and_fsdp(self):
+        """GFPQM on the gsm slice: the stats line counts one view per step, every history row has a node loss,
+        loss = loss_final + loss_node, the history differs from the yes/no run's; the micro-batches hold the folded
+        views (one per step, 3-5 options, "None of them" last); FSDP with 1 and 2 gloo ranks (fp32 shards +
+        cpu-adamw) gives the single-process fp32master run, row for row (loss, loss_final, loss_node within 1e-5)
+        with the same predictions."""
+        d = self.d
+        base = ["--model", d + "/m", "--train", d + "/gsm.jsonl", "--eval", f"v={d}/gsm.jsonl", "--eval-subq",
+                d + "/gsm.jsonl", *GFPQ, *MC, "--precision", "fp32master"]
+        r = tf.single(d, *base, "--out", d + "/mc")
+        self.ok(r)
+        st = self.stats(r)
+        steps = sum(steps_of(it) for it in self.gsm)
+        nodes = sum(len(nodes_of(it)) for it in self.gsm)
+        self.assertEqual((st["views"], st["mc_views"], st["mc_folded"], st["items_with_views"]),
+                         (steps, steps, nodes - steps, len(self.gsm)))
+        self.assertEqual(st["mc_options"] - 2 * steps - (nodes - steps), st["mc_fillers"])
+        m = tf.metrics(d + "/mc")
+        self.assertEqual(m["args"]["node_format"], "mc")
+        self.assertEqual(len(m["history"]), 6)
+        for row in m["history"]:
+            self.assertGreater(row["loss_node"], 0.0)
+            self.assertAlmostEqual(row["loss"], row["loss_final"] + row["loss_node"], delta=1e-5)
+        y = tf.single(d, *[x for x in base if x not in MC], "--out", d + "/yn")
+        self.ok(y)
+        sy = self.stats(y)
+        self.assertEqual(sy["views"], nodes)
+        self.assertNotEqual(strip(m["history"]), strip(tf.metrics(d + "/yn")["history"]))
+        events = tr.run_inproc(base + ["--out", d + "/inproc"])
+        self.assertEqual(len(events), 6)
+        seen = 0
+        for mbs, _ in events:
+            for mb in mbs:
+                for text, w, tgt, kind in mb:
+                    if kind == "subq":
+                        seen += 1
+                        self.assertIn(len(tgt), (3, 4, 5))
+                        self.assertTrue(text.endswith("None of them\nAnswer:"), text[-80:])
+                        self.assertEqual(sum(tgt), 1.0)
+        self.assertEqual(seen, steps)
+        for nproc in (1, 2):
+            self.ok(fsdp(d, *base, "--fsdp-optim", "cpu-adamw", "--out", f"{d}/mcf{nproc}", nproc=nproc))
+            b = tf.metrics(f"{d}/mcf{nproc}")
+            self.assertEqual([r["step"] for r in m["history"]], [r["step"] for r in b["history"]])
+            for x, y in zip(m["history"], b["history"]):
+                for k in ("loss", "loss_final", "loss_node"):
+                    self.assertAlmostEqual(x[k], y[k], delta=1e-5, msg=(nproc, k))
+            pa, pb = tf.preds(d + "/mc"), tf.preds(f"{d}/mcf{nproc}")
+            self.assertEqual([p["item_id"] for p in pa], [p["item_id"] for p in pb])
+            for p, q in zip(pa, pb):
+                for x, y in zip(p["probs"], q["probs"]):
+                    self.assertAlmostEqual(x, y, delta=1e-5)
+            self.assertEqual(m["eval"].keys(), b["eval"].keys())
+
+    def test_resume(self):
+        """A GFPQM run stopped after 2 of 6 updates and resumed (across the epoch boundary: 3 updates per pass, 2
+        epochs) equals the straight run: history, rng states, predictions. The per-epoch option order (mc_value_rng
+        keyed by the checkpointed pass count) is what the resumed run must reproduce."""
+        d = self.d
+        common = ["--model", d + "/m", "--train", d + "/gsm.jsonl", "--eval", f"v={d}/gsm.jsonl", *GFPQ, *MC,
+                  "--epochs", "2", "--items-per-update", "4", "--precision", "fp32master", "--seed", "3"]
+        a = tf.single(d, *common, "--stop-at-step", "4", "--out", d + "/ra")
+        self.assertEqual(a.returncode, 3, a.stderr[-2000:])
+        b1 = tf.single(d, *common, "--stop-at-step", "2", "--out", d + "/rb")
+        self.assertEqual(b1.returncode, 3, b1.stderr[-2000:])
+        other = tf.single(d, *[x for x in common if x not in MC], "--stop-at-step", "4", "--out", d + "/rb")
+        self.assertNotEqual(other.returncode, 0)
+        self.assertIn("other training arguments", other.stderr)
+        b2 = tf.single(d, *common, "--stop-at-step", "4", "--out", d + "/rb")
+        self.assertEqual(b2.returncode, 3, b2.stderr[-2000:])
+        self.assertIn("resumed from", b2.stdout)
+        (wa, oa, sa), (wb, ob, sb) = tr.ckpt(d + "/ra"), tr.ckpt(d + "/rb")
+        for k in wa:
+            self.assertTrue(torch.equal(wa[k], wb[k]), k)
+        self.assertEqual(strip(sa["history"]), strip(sb["history"]))
+        self.assertEqual(len(sa["history"]), 4)
+        for k in ("step", "rng", "order_rng", "sched", "passes", "seen_tok"):
+            self.assertEqual(sa[k], sb[k], k)
+        for o in ("ra", "rb"):
+            self.ok(tf.single(d, *common, "--ckpt-every-min", "1000", "--out", f"{d}/{o}"))
+        self.assertEqual(Path(d + "/ra/preds_v.jsonl").read_text(), Path(d + "/rb/preds_v.jsonl").read_text())
+        ha, hb = (tf.metrics(f"{d}/{o}")["history"] for o in ("ra", "rb"))
+        self.assertEqual(strip(ha), strip(hb))
+        self.assertEqual([r["step"] for r in ha], [1, 2, 3, 4, 5, 6])
+
+    def test_shuffled_run_and_flag_errors(self):
+        """--tree-target shuffled with mc runs (GFPQMR; its stats count the random agreements); placebo + mc, a cap
+        with mc, --tree-pack with mc, --tree-scaffold with mc, mc in the local view, and a train file with a step
+        without its gold node are refused with a clear message; the problem-view mc path still runs."""
+        d = self.d
+        base = ["--model", d + "/m", "--train", d + "/gsm.jsonl", "--eval", f"v={d}/gsm.jsonl"]
+        r = tf.single(d, *base, *GFPQ, *MC, "--tree-target", "shuffled", "--out", d + "/mcr")
+        self.ok(r)
+        st = self.stats(r)
+        self.assertEqual(st["shuffled_views"], sum(steps_of(it) for it in self.gsm))
+        self.assertLess(st["shuffled_agree"], st["shuffled_views"])
+        r = tf.single(d, *base, *GFPQ[:2], "--tree-sources", "gsm8k_tf", *GFPQ[6:], *MC, "--out", d + "/mcp")
+        self.ok(r)                                                  # view problem: the pristine mc path
+        self.assertNotIn("mc_views", self.stats(r))
+        cases = [([*GFPQ, *MC, "--tree-target", "placebo"], "does not combine with --node-format mc"),
+                 ([*GFPQ[:4], "--tree-cap", "3", *GFPQ[6:], *MC], "needs --tree-cap 0"),
+                 ([*GFPQ[:2], "--tree-view", "statements", *GFPQ[4:], *MC, "--tree-pack", "4"],
+                  "does not combine with --tree-pack"),
+                 ([*GFPQ[:2], "--tree-view", "statements", *GFPQ[4:], *MC, "--tree-scaffold", "0.5"],
+                  "does not combine with --tree-pack / --tree-scaffold"),
+                 (["--tree-full", "true", "--tree-view", "local", *GFPQ[6:], *MC], "does not combine with "
+                  "--tree-eligible-only / --node-format mc"),
+                 ([*GFPQ, *MC, "--tree-eligible-only"], "--node-format mc")]
+        for extra, msg in cases:
+            r = tf.single(d, *base, *extra, "--out", d + "/err")
+            self.assertNotEqual(r.returncode, 0, extra)
+            self.assertIn(msg, r.stderr, extra)
+        r = tf.single(d, "--model", d + "/m", "--train", d + "/bad.jsonl", "--eval", f"v={d}/gsm.jsonl", *GFPQ, *MC,
+                      "--out", d + "/err")
+        self.assertNotEqual(r.returncode, 0)
+        self.assertIn("--node-format mc: ", r.stderr)
+        self.assertIn("step 1: 0 gold probe nodes", r.stderr)
+        r = tf.single(d, "--model", d + "/m", "--train", d + "/bad.jsonl", "--eval", f"v={d}/gsm.jsonl", *GFPQ,
+                      "--out", d + "/okbad")
+        self.ok(r)                                                  # the yes/no path does not care
