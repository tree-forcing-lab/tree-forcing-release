+    def test_synthetic_shapes(self):
+        """A V4-shaped item (3 wrong probes per step, both wordings): gold + 3 wrong + None, no filler, the opposite
+        nodes folded; one wrong probe: fillers from the other step (its gold first); a one-step item: gold + wrong +
+        None; a step without a gold node, or a gold node whose target says No, raises."""
+        from cotdistill.student import MC_NONE, build_full_tree, mc_value_plan
+        kw = dict(mode="plain", view="statements+question", cap=0, node_format="mc")
+        it = synthetic_item(3, True, 2)
+        st = {}
+        ex = build_full_tree(it, rng=random.Random(0), stats=st, **kw)
+        self.assertEqual([e.kind for e in ex], ["final", "subq", "subq"])
+        self.assertEqual((st["views"], st["mc_views"], st["mc_folded"], st["mc_fillers"], st["mc_options"]),
+                         (2, 2, 14, 0, 10))                 # 16 planned nodes (8 per step), 2 asked
+        for e in ex[1:]:
+            opts = e.text.split("\nOptions:\n")[1].split("\nAnswer:")[0].split("\n")
+            self.assertEqual(len(opts), 5)
+            self.assertEqual(opts[-1], "E) " + MC_NONE)
+            self.assertEqual(e.labels, ["A", "B", "C", "D", "E"])
+            self.assertEqual(sum(e.target), 1.0)
+            self.assertAlmostEqual(e.weight, 0.5)
+        plan = mc_value_plan(it)
+        self.assertEqual([(m["step"], m["gold"], m["wrong"], m["fill_gold"], m["fill_wrong"]) for m in plan],
+                         [(1, "24", ["26", "29", "32"], ["48"], ["50", "53", "56"]),
+                          (2, "48", ["50", "53", "56"], ["24"], ["26", "29", "32"])])
+        it1 = synthetic_item(1, False, 2)
+        ex = build_full_tree(it1, rng=random.Random(0), stats=(st := {}), **kw)
+        self.assertEqual((st["mc_views"], st["mc_folded"], st["mc_fillers"], st["mc_options"]), (2, 2, 4, 10))
+        for e, m in zip(ex[1:], mc_value_plan(it1)):
+            opts = [o[3:] for o in e.text.split("\nOptions:\n")[1].split("\nAnswer:")[0].split("\n")]
+            self.assertEqual(set(opts), {m["gold"], *m["wrong"], *m["fill_gold"], *m["fill_wrong"], MC_NONE})
+        one = synthetic_item(1, False, 1)
