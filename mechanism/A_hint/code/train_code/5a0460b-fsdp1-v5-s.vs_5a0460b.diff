+    def test_label_smoothing_on_mc_views(self):
+        """kl_loss's label smoothing spreads over the view's own K options (as for the final question): the loss of
+        an mc view equals the soft cross-entropy against (1 - s) one-hot + s / K."""
+        from cotdistill.student import kl_loss, mc_value_example
+        import torch.nn.functional as F
+        ex = mc_value_example("P", "How many?", ["3", "5", "7", "None of them"], 1, 0.5, "it")
+        self.assertEqual((ex.labels, ex.target, ex.weight, ex.kind), (["A", "B", "C", "D"], [0.0, 1.0, 0.0, 0.0], 0.5, "subq"))
+        self.assertEqual(ex.text, "P\n\nIntermediate question: How many?\nOptions:\nA) 3\nB) 5\nC) 7\nD) None of them\nAnswer:")
+        z = torch.tensor([0.1, 0.4, -0.3, 0.2])
+        t = torch.tensor([0.9 * x + 0.1 / 4 for x in ex.target])
+        self.assertAlmostEqual(kl_loss([z], [ex], 0.1).item(), (0.5 * -(t * F.log_softmax(z, -1)).sum()).item(), places=6)
+        with self.assertRaises(ValueError):
+            mc_value_example("P", "q", ["3"], 0, 1.0, "it")
+        with self.assertRaises(ValueError):
+            mc_value_example("P", "q", ["3", "4"], 2, 1.0, "it")
