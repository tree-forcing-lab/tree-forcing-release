+# ---- --node-format mc in the statements / statements+question views (GFPQM): value multiple-choice nodes -----------
+# A gsm8k_tf tree carries, per solution step, one gold probe node ("<stem> Is it <value>?", probe == value) and one or
+# more wrong probe nodes (the same stem, a wrong value; scripts/build_gsm8k_tf.py node_question, the "wrong" field
+# names the kind). GFPQ asks every probe as its own yes/no view. GFPQM folds a step into ONE view: the stem asked as a
+# multiple-choice question over the step's values (the gold one, its wrong probes, other steps' values when the step
+# has fewer than MC_VALUE_WRONG wrong probes) plus "None of them", one-hot target on the gold value. The option
+# strings are the data's own printed values (read off the node questions), so integers and decimals print as GFPQ
+# prints them. The option order and the fillers come from mc_value_rng (seed, epoch, item, node), never from the
+# training rng. A node in another wording ("Is it different from 3?", the data's "opposite" wording as a node of its
+# own) is folded (its probe is already a value of its step) and never asked.
+MC_VALUE_SEP = " Is it "
+MC_VALUE_OPP = "different from "
+MC_VALUE_WRONG = 3             # wrong options per view (the step's own wrong probes, then other steps' values)
+MC_VALUE_FLOAT = re.compile(r"^-?\d+(\.\d+)?$")
+
+
+def mc_value_parse(sq: dict) -> tuple[str, str] | None:
+    """(question stem, printed probe value) of a value probe node "<stem> Is it <v>?"; None for any other question
+    (the "Is it different from <v>?" wording included)."""
+    q = sq.get("question") if isinstance(sq, dict) else None
+    if not isinstance(q, str):
+        return None
+    stem, sep, tail = q.rpartition(MC_VALUE_SEP)
+    if not sep or not tail.endswith("?") or tail.startswith(MC_VALUE_OPP) or not stem.strip():
+        return None
+    v = tail[:-1]
+    return (stem, v) if MC_VALUE_FLOAT.match(v) else None
+
+
+def mc_value_rng(seed: int, epoch: int, item_id, node_id) -> random.Random:
+    """The generator of one GFPQM view (seed, epoch, item, gold node): fillers first, then the option order. A str key
+    (sha512) like treeplan.scaffold_rng, so it depends on nothing else (not the training rng, the view count, the FSDP
+    rank or PYTHONHASHSEED)."""
+    return random.Random(f"mcvalue|{seed}|{epoch}|{item_id}|{node_id}")
+
+
+def mc_value_plan(item: dict, subq_target: str = "cot") -> list[dict]:
+    """The GFPQM views of an item, one per solution step in node order: {"node": the step's gold probe node, "step",
+    "stem", "gold": its printed value, "wrong": the step's wrong printed values (node order, no duplicate, never the
+    gold), "fill_gold": the other steps' gold values, "fill_wrong": the other steps' wrong values (both without the
+    step's own values, in step order)}. ValueError when a value probe node has no "step", a step has no gold node
+    (probe == value) or two, or the gold node's target (treeplan._node_p under subq_target) is None or says No: the
+    gold option would then not be the step's answer. Items without value probe nodes give []. Nodes that are not value
+    probes (other wordings) are not asked; an item whose nodes have targets but none is a value probe raises (another
+    source's tree: restrict --tree-sources)."""
+    nodes = [sq for sq in item.get("subqs", []) if "id" in sq]
+    steps: dict = {}
+    for sq in nodes:
+        pv = mc_value_parse(sq)
+        if pv is None:
+            continue
+        if sq.get("step") is None or sq.get("probe") is None or sq.get("value") is None:
+            raise ValueError(f"{item.get('item_id')} node {sq['id']}: a value probe node needs step, probe and value")
+        steps.setdefault(sq["step"], []).append((sq, *pv))
+    if not steps and any(_node_p(sq, subq_target) is not None for sq in nodes):
+        raise ValueError(f"{item.get('item_id')}: its nodes are not value probes ('<stem> Is it <v>?'); --node-format "
+                         "mc in this view folds gsm8k_tf-shaped trees only (restrict --tree-sources)")
+    out = []
+    for st in steps:                                    # insertion order = node order
+        rows = steps[st]
+        gold = [(sq, stem, v) for sq, stem, v in rows if abs(float(sq["probe"]) - float(sq["value"])) < 1e-9]
+        if len(gold) != 1:
+            raise ValueError(f"{item.get('item_id')} step {st}: {len(gold)} gold probe nodes (probe == value), need 1")
+        g, stem, gv = gold[0]
+        p = _node_p(g, subq_target)
+        if p is None or p < 0.5:
+            raise ValueError(f"{item.get('item_id')} node {g['id']}: the gold probe's target under --subq-target "
+                             f"{subq_target} is {p}, not Yes")
+        wrong = []
+        for sq, _, v in rows:
+            if sq is not g and v != gv and v not in wrong:
+                wrong.append(v)
+        out.append({"node": g, "step": st, "stem": stem, "gold": gv, "wrong": wrong})
+    for e in out:
+        own = {e["gold"], *e["wrong"]}
+        fg, fw = [], []
+        for o in out:                                   # the other steps' gold values first, then their wrong
+            if o is not e and o["gold"] not in own and o["gold"] not in fg:   # values (a value is listed once)
+                fg.append(o["gold"])
+        for o in out:
+            for v in ([] if o is e else o["wrong"]):
+                if v not in own and v not in fg and v not in fw:
+                    fw.append(v)
+        e["fill_gold"], e["fill_wrong"] = fg, fw
+    return out
+
+
+def mc_value_options(entry: dict, g: random.Random) -> tuple[list[str], int]:
+    """The option texts of one GFPQM view and the gold index: the gold value and the step's wrong values, filled up
+    to MC_VALUE_WRONG wrong values from the other steps' gold values first, then their wrong values (g.sample), in an
+    order drawn from g, then MC_NONE last (never the answer)."""
+    wrong = list(entry["wrong"])
+    need = MC_VALUE_WRONG - len(wrong)
+    if need > 0:
+        take = g.sample(entry["fill_gold"], min(need, len(entry["fill_gold"])))
+        need -= len(take)
+        if need > 0:
+            take += g.sample(entry["fill_wrong"], min(need, len(entry["fill_wrong"])))
+        wrong += take
+    opts = [entry["gold"], *wrong]
+    g.shuffle(opts)
+    opts.append(MC_NONE)
+    return opts, opts.index(entry["gold"])
+
+
+def mc_value_example(context: str, stem: str, opts: list[str], answer: int, weight: float, item_id) -> Example:
+    """One GFPQM view: the context (the problem without its options, or the statement block) and the step's stem under
+    "Intermediate question:" with its value options (SUBQ_OPTS_TEMPLATE, the layout of a multiple-choice tree node),
+    labels A, B, ..., a one-hot target on option `answer` (the gold value; --tree-target shuffled: a random option,
+    "None of them" included), kind "subq". Label smoothing, if any, is applied by kl_loss as for the final question."""
+    if not 2 <= len(opts) <= len(MC_SYMBOLS) or not 0 <= answer < len(opts):
+        raise ValueError(f"{item_id}: {len(opts)} options (2-{len(MC_SYMBOLS)}), answer {answer}")
+    labels = list(MC_SYMBOLS[:len(opts)])
+    text = SUBQ_OPTS_TEMPLATE.format(problem=context, question=stem,
+                                     opts="\n".join(f"{L}) {t}" for L, t in zip(labels, opts)))
+    return Example(text, labels, [float(i == answer) for i in range(len(labels))], weight, "subq", item_id)
+
+
